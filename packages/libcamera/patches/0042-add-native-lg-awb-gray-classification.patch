From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add native LG AWB gray-zone geometry and classification

Configure primary and reserved references from sensor tuning, interpolate
lux-dependent reference shifts and outlier widths, and classify each
point against the five-segment locus and reserved circles. Preserve the
factory's endpoint, nearest-reference and boundary selection rules.

diff --git a/src/libcamera/pipeline/qcom/lg_awb_gray.h b/src/libcamera/pipeline/qcom/lg_awb_gray.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_gray.h
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_statistics.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbGrayReferences {
+	unsigned int count;
+	std::array<LgAwbPoint, 17> points;
+	std::array<float, 17> above, below;
+};
+
+struct LgAwbGrayDecision {
+	uint32_t nearest, additionalNearest, valid, weightGroup, category;
+};
+
+class LgAwbGrayClassifier
+{
+public:
+	explicit LgAwbGrayClassifier(const LgAwbGrayReferences &references)
+		: references_(references)
+	{
+		for (unsigned int i = 0; i < lines_.size(); i++) {
+			auto a = references_.points[i], b = references_.points[i + 1];
+			float dx = b.x - a.x;
+			lines_[i] = { (b.y - a.y) / dx,
+				      (product(a.y, b.x) - product(a.x, b.y)) / dx };
+		}
+	}
+
+	LgAwbGrayDecision classify(LgAwbPoint point) const
+	{
+		std::array<LgAwbPoint, 6> primary;
+		std::copy_n(references_.points.begin(), primary.size(), primary.begin());
+		unsigned int nearest = lgAwbNearestReference(primary, point);
+		unsigned int additional = 6;
+		float additionalDistance = distance(point, references_.points[additional]);
+		for (unsigned int i = 7; i < references_.count; i++) {
+			float current = distance(point, references_.points[i]);
+			if (current < additionalDistance) {
+				additional = i;
+				additionalDistance = current;
+			}
+		}
+		LgAwbGrayDecision result{ nearest, additional, 0, 0, 0 };
+		unsigned int segment;
+		int cap = -1;
+		Projection projection;
+		if (nearest == 0) {
+			segment = 0;
+			projection = project(point, segment);
+			if (projection.x < primary.front().x) {
+				cap = 0;
+				projection.distance = distance(point, primary.front());
+			}
+		} else if (nearest == 5) {
+			segment = 4;
+			projection = project(point, segment);
+			if (projection.x > primary.back().x) {
+				cap = 5;
+				projection.distance = distance(point, primary.back());
+			}
+		} else {
+			auto before = project(point, nearest - 1), after = project(point, nearest);
+			bool beforeValid = before.x >= primary[nearest - 1].x && before.x <= primary[nearest].x;
+			bool afterValid = after.x >= primary[nearest].x && after.x <= primary[nearest + 1].x;
+			bool chooseBefore = (beforeValid && (!afterValid || before.distance < after.distance)) ||
+				(!afterValid && before.distance >= after.distance);
+			segment = chooseBefore ? nearest - 1 : nearest;
+			projection = chooseBefore ? before : after;
+		}
+		if (projection.distance > additionalDistance) {
+			float width = references_.above[additional];
+			/* The middle segment's forward branch excludes the circle boundary. */
+			bool strict = nearest > 0 && nearest < 5 && segment == nearest;
+			if (strict ? additionalDistance < width : additionalDistance <= width) {
+				result.valid = 1;
+				result.category = 12 + additional;
+			}
+			return result;
+		}
+		const auto &widths = projection.above ? references_.above : references_.below;
+		float width;
+		unsigned int category;
+		if (cap >= 0) {
+			width = widths[cap];
+			category = cap == 0 ? 1 : 17;
+		} else {
+			float a = primary[segment].x, b = primary[segment + 1].x;
+			width = interpolate(projection.x, a, b, widths[segment], widths[segment + 1]);
+			float third = a + product(b - a, 1.0f / 3.0f);
+			float twoThirds = a + product(b - a, 2.0f / 3.0f);
+			category = 3 * segment + (projection.x <= third ? 2 : projection.x <= twoThirds ? 3 : 4);
+		}
+		if (projection.distance <= width) {
+			result.valid = 1;
+			result.category = category;
+			if (projection.distance < width / 3.0f)
+				result.weightGroup = projection.above ? 2 : 3;
+			else if (projection.distance < width)
+				result.weightGroup = projection.above ? 1 : 4;
+		}
+		return result;
+	}
+
+private:
+	struct Line {
+		float slope, intercept;
+	};
+
+	struct Projection {
+		float x, distance;
+		bool above;
+	};
+
+	static float product(float a, float b)
+	{
+		/* Match the factory's separate multiplication and addition rounding. */
+		volatile float result = a * b;
+		return result;
+	}
+
+	static float distance(LgAwbPoint a, LgAwbPoint b)
+	{
+		float dx = a.x - b.x, dy = a.y - b.y;
+		return std::sqrt(product(dx, dx) + product(dy, dy));
+	}
+
+	static float interpolate(float x, float a, float b, float first, float last)
+	{
+		if (a >= b - 1e-6f && a <= b + 1e-6f)
+			return product(first + last, 0.5f);
+		return first + product((x - a) / (b - a), last - first);
+	}
+
+	Projection project(LgAwbPoint point, unsigned int segment) const
+	{
+		auto line = lines_[segment];
+		float divisor = product(line.slope, line.slope) + 1.0f;
+		return { (point.x + product(line.slope, point.y - line.intercept)) / divisor,
+			 std::abs((point.y - product(point.x, line.slope)) - line.intercept) / std::sqrt(divisor),
+			 point.y > product(point.x, line.slope) + line.intercept };
+	}
+
+	LgAwbGrayReferences references_;
+	std::array<Line, 5> lines_;
+};
+
+} /* namespace libcamera::qcom */
