@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+#include "lg_awb_colour.h"
+#include "lg_awb_gray.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbReferenceChange {
+	unsigned int index;
+	std::array<int16_t, 2> lux;
+	LgAwbPoint target;
+};
+
+struct LgAwbGrayConfiguration {
+	LgAwbColourConfiguration colour;
+	unsigned int additionalCount, changeCount;
+	std::array<LgAwbRatios, 11> additional;
+	std::array<LgAwbReferenceChange, 10> changes;
+	std::array<int16_t, 17> above, below;
+	std::array<int16_t, 24> luxKnots;
+	std::array<std::array<std::array<int16_t, 17>, 2>, 24> distanceOffsets;
+};
+
+class LgAwbGrayGeometry
+{
+public:
+	explicit LgAwbGrayGeometry(const LgAwbGrayConfiguration &config)
+		: config_(config)
+	{
+		std::copy(config.colour.ideal.begin(), config.colour.ideal.end(), points_.begin());
+		/* Reserved references use the fixed, uncalibrated nominal sensor-to-ideal shift. */
+		auto nominal = config.colour;
+		nominal.lowLightEnabled = false;
+		LgAwbColour colour(nominal);
+		for (unsigned int i = 0; i < config.additionalCount; i++) {
+			auto point = colour.fromRgb(config.additional[i]);
+			points_[6 + i] = { point.x, point.y };
+		}
+	}
+
+	LgAwbGrayReferences references(int lux, bool widen4000KBelow = false) const
+	{
+		LgAwbGrayReferences result{};
+		result.count = 6 + config_.additionalCount;
+		result.points = points_;
+		for (unsigned int i = 0; i < config_.changeCount; i++) {
+			const auto &change = config_.changes[i];
+			auto base = points_[change.index];
+			float t = std::clamp(static_cast<float>(lux - change.lux[0]) /
+					     (change.lux[1] - change.lux[0]), 0.0f, 1.0f);
+			result.points[change.index] = { base.x + product(t, change.target.x - base.x),
+						       base.y + product(t, change.target.y - base.y) };
+		}
+		unsigned int region = std::lower_bound(config_.luxKnots.begin(), config_.luxKnots.end(), lux) -
+			config_.luxKnots.begin();
+		unsigned int first = region ? region - 1 : 0;
+		unsigned int last = std::min<unsigned int>(region, config_.luxKnots.size() - 1);
+		float t = first == last ? 0.0f : static_cast<float>(lux - config_.luxKnots[first]) /
+			(config_.luxKnots[last] - config_.luxKnots[first]);
+		for (unsigned int i = 0; i < result.above.size(); i++) {
+			for (unsigned int side = 0; side < 2; side++) {
+				float a = product(config_.distanceOffsets[first][side][i], 0.001f);
+				float b = product(config_.distanceOffsets[last][side][i], 0.001f);
+				float base = product(side ? config_.below[i] : config_.above[i], 0.001f);
+				float value = base + (a + product(t, b - a));
+				(side ? result.below : result.above)[i] = value;
+			}
+		}
+		if (widen4000KBelow && region >= 7 && region <= 14)
+			result.below[3] = 0.03f;
+		return result;
+	}
+
+private:
+	static float product(float a, float b)
+	{
+		/* Match the factory's separate multiplication and addition rounding. */
+		volatile float result = a * b;
+		return result;
+	}
+
+	LgAwbGrayConfiguration config_;
+	std::array<LgAwbPoint, 17> points_{};
+};
+
+} /* namespace libcamera::qcom */
