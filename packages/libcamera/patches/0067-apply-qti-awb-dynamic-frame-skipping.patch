From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: apply QTI AWB dynamic frame skipping

Schedule statistics analysis with the factory DSFV1 and history rules.
Keep temporal convergence and gain adjustment running on every frame.

diff --git a/src/libcamera/pipeline/qcom/awb_frame_skip.h b/src/libcamera/pipeline/qcom/awb_frame_skip.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/awb_frame_skip.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include "awb_locus.h"
+#include "awb_weights.h"
+
+namespace libcamera::qcom {
+
+struct QtiAwbFrameSkipConfiguration {
+	QtiAwbWeightCurve change;
+	unsigned int historySize;
+};
+
+struct QtiAwbFrameSkipState {
+	uint32_t skipped;
+	int32_t remaining;
+	float change;
+	float average;
+};
+
+class QtiAwbFrameSkip
+{
+public:
+	explicit QtiAwbFrameSkip(QtiAwbFrameSkipConfiguration config)
+		: config_(std::move(config)), history_(config_.historySize)
+	{
+	}
+
+	void reset()
+	{
+		std::fill(history_.begin(), history_.end(), Record{});
+		position_ = frames_ = 0;
+		state_ = {};
+	}
+
+	bool beginFrame()
+	{
+		state_.skipped = frames_++ >= 30 && state_.remaining > 0;
+		if (state_.skipped)
+			state_.remaining--;
+		return state_.skipped;
+	}
+
+	int32_t frameCount() const { return frames_; }
+
+	QtiAwbFrameSkipState finishFrame(QtiAwbPoint current, QtiAwbPoint previous)
+	{
+		Record &record = history_[position_];
+		record.processed = !state_.skipped;
+		if (!state_.skipped) {
+			state_.change = 0;
+			float redSum = current.rg + previous.rg;
+			float blueSum = current.bg + previous.bg;
+			if (redSum != 0 && blueSum != 0) {
+				float red = (2.0f * std::abs(current.rg - previous.rg)) * 100.0f / redSum;
+				float blue = (2.0f * std::abs(current.bg - previous.bg)) * 100.0f / blueSum;
+				record.change = std::fmax(red, blue);
+				state_.change = std::fmax(record.change, average());
+				state_.remaining = static_cast<int32_t>(qtiAwbInterpolateWeight(
+					config_.change, state_.change, [](float value) { return value; }));
+			}
+		}
+		state_.average = average();
+		position_ = (position_ + 1) % history_.size();
+		return state_;
+	}
+
+private:
+	struct Record {
+		bool processed = false;
+		float change = 0;
+	};
+
+	float average() const
+	{
+		unsigned int count = 0;
+		float sum = 0;
+		for (unsigned int i = 0; i < history_.size(); i++) {
+			const Record &record = history_[(position_ + history_.size() - i) % history_.size()];
+			if (!record.processed)
+				continue;
+			sum += record.change;
+			if (++count == 5)
+				return sum / 5.0f;
+		}
+		return 100.0f;
+	}
+
+	QtiAwbFrameSkipConfiguration config_;
+	std::vector<Record> history_;
+	unsigned int position_ = 0;
+	int32_t frames_ = 0;
+	QtiAwbFrameSkipState state_{};
+};
+
+} /* namespace libcamera::qcom */
