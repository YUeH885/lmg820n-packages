+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Contrast autofocus using hill-climbing search on central green-channel statistics. */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	auto lens = context.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (lens == context.lensControls.end())
+		return 0;
+	for (const char *field : { "min", "max", "coarseStep", "fineStep", "settleMs",
+				   "warmupMs", "samples", "defaultMode" }) {
+		if (!tuningData[field].get<int32_t>()) {
+			LOG(IPASoftAf, Error) << "Missing or invalid AF tuning field " << field;
+			return -EINVAL;
+		}
+	}
+
+	low_ = tuningData["min"].get<int32_t>().value();
+	high_ = tuningData["max"].get<int32_t>().value();
+	coarseStep_ = tuningData["coarseStep"].get<int32_t>().value();
+	fineStep_ = tuningData["fineStep"].get<int32_t>().value();
+	int32_t settleMs = tuningData["settleMs"].get<int32_t>().value();
+	int32_t warmupMs = tuningData["warmupMs"].get<int32_t>().value();
+	int32_t samples = tuningData["samples"].get<int32_t>().value();
+	defaultMode_ = tuningData["defaultMode"].get<int32_t>().value();
+	if (low_ < lens->second.min().get<int32_t>() ||
+	    high_ > lens->second.max().get<int32_t>() || low_ >= high_ ||
+	    fineStep_ <= 0 || coarseStep_ <= fineStep_ || coarseStep_ > high_ - low_ ||
+	    settleMs <= 0 || warmupMs < 0 || samples <= 0 || samples % 2 == 0 ||
+	    (defaultMode_ != controls::AfModeAuto && defaultMode_ != controls::AfModeContinuous))
+		return -EINVAL;
+	settleNs_ = uint64_t(settleMs) * 1000000;
+	warmupNs_ = uint64_t(warmupMs) * 1000000;
+	samplesPerPosition_ = samples;
+
+	const ControlValue modes[] = { controls::AfModeAuto, controls::AfModeContinuous };
+	context.ctrlMap[&controls::AfMode] = ControlInfo(modes, defaultMode_);
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	context.ctrlMap[&controls::AfPause] = ControlInfo(controls::AfPauseValues);
+	enabled_ = true;
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	if (!enabled_)
+		return 0;
+	context.activeState.af.position = configInfo.lensPosition;
+	mode_ = defaultMode_;
+	state_ = controls::AfStateIdle;
+	pauseState_ = controls::AfPauseStateRunning;
+	paused_ = deferredPause_ = false;
+	stage_ = Stage::Idle;
+	warmupUntil_ = 0;
+	reference_ = 0;
+	scene_ = referenceScene_ = {};
+	changed_ = 0;
+	if (mode_ == controls::AfModeContinuous)
+		beginScan(context);
+	return 0;
+}
+
+void Af::queueRequest([[maybe_unused]] IPAContext &context,
+		      [[maybe_unused]] uint32_t frame, IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	frameContext.af.mode = controls.get(controls::AfMode);
+	frameContext.af.trigger = controls.get(controls::AfTrigger);
+	frameContext.af.pause = controls.get(controls::AfPause);
+}
+
+void Af::beginScan(IPAContext &context)
+{
+	state_ = controls::AfStateScanning;
+	stage_ = Stage::Warmup;
+	originalPosition_ = std::clamp(context.activeState.af.position, low_, high_);
+	context.activeState.af.error = 0;
+	position_ = originalPosition_;
+	bestPosition_ = originalPosition_;
+	best_ = -1.0;
+	worst_ = std::numeric_limits<double>::max();
+	probeScore0_ = -1.0;
+	direction_ = (originalPosition_ < (low_ + high_) / 2) ? 1 : -1;
+	dropCount_ = 0;
+	steps_ = 0;
+	changed_ = 0;
+	samples_.clear();
+}
+
+void Af::move(IPAContext &context, int position)
+{
+	position_ = std::clamp(position, low_, high_);
+	context.activeState.af.target = position_;
+	samples_.clear();
+}
+
+void Af::finish(int state, double score)
+{
+	state_ = state;
+	stage_ = Stage::Idle;
+	reference_ = score;
+	referenceScene_ = scene_;
+	changed_ = 0;
+	if (deferredPause_) {
+		paused_ = true;
+		deferredPause_ = false;
+		pauseState_ = controls::AfPauseStatePaused;
+	}
+}
+
+void Af::fail(IPAContext &context, const char *reason)
+{
+	LOG(IPASoftAf, Info) << "AF scan failed: " << reason;
+	stage_ = Stage::Restore;
+	move(context, originalPosition_);
+}
+
+void Af::applyControls(IPAContext &context, const IPAFrameContext &frameContext)
+{
+	const auto &request = frameContext.af;
+	if (request.mode && *request.mode != mode_ &&
+	    (*request.mode == controls::AfModeAuto || *request.mode == controls::AfModeContinuous)) {
+		mode_ = *request.mode;
+		paused_ = deferredPause_ = false;
+		pauseState_ = controls::AfPauseStateRunning;
+		finish(controls::AfStateIdle, 0);
+		if (mode_ == controls::AfModeContinuous)
+			beginScan(context);
+	}
+	if (mode_ == controls::AfModeAuto && request.trigger) {
+		if (*request.trigger == controls::AfTriggerStart && state_ != controls::AfStateScanning)
+			beginScan(context);
+		else if (*request.trigger == controls::AfTriggerCancel) {
+			stage_ = Stage::Idle;
+			move(context, originalPosition_);
+			finish(controls::AfStateIdle, 0);
+		}
+	}
+	if (mode_ != controls::AfModeContinuous || !request.pause)
+		return;
+	if (*request.pause == controls::AfPauseDeferred && paused_)
+		return;
+	if (*request.pause == controls::AfPauseResume) {
+		paused_ = deferredPause_ = false;
+		pauseState_ = controls::AfPauseStateRunning;
+		samples_.clear();
+		context.activeState.af.timestamp = frameContext.sensorTimestamp;
+	} else if (*request.pause == controls::AfPauseImmediate || state_ != controls::AfStateScanning) {
+		paused_ = true;
+		deferredPause_ = false;
+		pauseState_ = controls::AfPauseStatePaused;
+	} else {
+		deferredPause_ = true;
+		pauseState_ = controls::AfPauseStatePausing;
+	}
+}
+
+void Af::scan(IPAContext &context, double score)
+{
+	samples_.push_back(score);
+	if (samples_.size() < samplesPerPosition_)
+		return;
+	std::sort(samples_.begin(), samples_.end());
+	score = samples_[samples_.size() / 2];
+
+	LOG(IPASoftAf, Debug) << "Stage " << static_cast<int>(stage_)
+			      << " position " << position_ << " score " << score
+			      << " best " << best_ << " at " << bestPosition_;
+
+	if (stage_ == Stage::Confirm) {
+		if (score >= best_ * 0.70 || best_ <= 0) {
+			finish(controls::AfStateFocused, std::max(score, best_));
+			LOG(IPASoftAf, Info) << "AF focused at " << position_ << " score " << score;
+		} else {
+			fail(context, "focus confirmation contrast dropped");
+		}
+		return;
+	}
+
+	if (stage_ == Stage::Refine) {
+		if (score > best_) {
+			best_ = score;
+			bestPosition_ = position_;
+		}
+		stage_ = Stage::Confirm;
+		move(context, bestPosition_);
+		return;
+	}
+
+	if (stage_ == Stage::Probe) {
+		if (probeScore0_ < 0) {
+			probeScore0_ = score;
+			best_ = score;
+			bestPosition_ = position_;
+			int probeTarget = position_ + direction_ * coarseStep_;
+			if (probeTarget > high_ || probeTarget < low_)
+				direction_ = -direction_;
+			move(context, position_ + direction_ * coarseStep_);
+			return;
+		}
+
+		if (score >= probeScore0_ * 0.99) {
+			if (score > best_) {
+				best_ = score;
+				bestPosition_ = position_;
+			}
+			stage_ = Stage::Climb;
+			steps_ = 1;
+			int nextPos = position_ + direction_ * coarseStep_;
+			if (nextPos > high_ || nextPos < low_) {
+				stage_ = Stage::Refine;
+				move(context, bestPosition_);
+			} else {
+				move(context, nextPos);
+			}
+		} else {
+			direction_ = -direction_;
+			stage_ = Stage::Climb;
+			steps_ = 1;
+			int nextPos = originalPosition_ + direction_ * coarseStep_;
+			if (nextPos > high_ || nextPos < low_) {
+				stage_ = Stage::Refine;
+				move(context, bestPosition_);
+			} else {
+				move(context, nextPos);
+			}
+		}
+		return;
+	}
+
+	if (stage_ == Stage::Climb) {
+		steps_++;
+		if (score > best_) {
+			best_ = score;
+			bestPosition_ = position_;
+			dropCount_ = 0;
+		} else {
+			dropCount_++;
+		}
+
+		bool overshot = (best_ > 0 && score < best_ * 0.88) || dropCount_ >= 2;
+		int nextPos = position_ + direction_ * coarseStep_;
+		bool reachedBoundary = (nextPos > high_ || nextPos < low_);
+		bool maxStepsExceeded = (steps_ >= 14);
+
+		if (overshot || reachedBoundary || maxStepsExceeded) {
+			LOG(IPASoftAf, Debug) << "Climb finished (overshot=" << overshot
+					      << ", boundary=" << reachedBoundary
+					      << "), returning to peak " << bestPosition_;
+			stage_ = Stage::Refine;
+			move(context, bestPosition_);
+		} else {
+			move(context, nextPos);
+		}
+	}
+}
+
+void Af::process(IPAContext &context, uint32_t frame, IPAFrameContext &frameContext,
+		 const SwIspStats *stats, ControlList &metadata)
+{
+	if (!enabled_)
+		return;
+	if (!warmupUntil_)
+		warmupUntil_ = frameContext.sensorTimestamp + warmupNs_;
+	applyControls(context, frameContext);
+	auto &lens = context.activeState.af;
+	if (lens.error && state_ == controls::AfStateScanning)
+		finish(controls::AfStateFailed, 0);
+
+	double score = 0, variance = 0;
+	const auto &focus = stats->focus;
+	if (stats->valid && focus.samples > 1 && focus.pairs) {
+		double mean = focus.sum / focus.samples;
+		variance = focus.square / focus.samples - mean * mean;
+		if (variance > 0)
+			score = focus.gradient / focus.pairs / variance;
+		double signal = mean - context.activeState.blc.level;
+		for (unsigned int i = 0; i < scene_.size(); i++) {
+			scene_[i] = signal > 0 && focus.gridSamples[i]
+				? std::max(0.0, focus.grid[i] / focus.gridSamples[i] -
+						context.activeState.blc.level) / signal
+				: 0;
+		}
+		metadata.set(controls::FocusFoM,
+			     static_cast<int32_t>(std::clamp(score * 1000000, 0.0, 2147483647.0)));
+	}
+	if (!paused_ && !lens.pending && !lens.error && stats->valid &&
+	    frameContext.sensorTimestamp >= lens.timestamp + settleNs_) {
+		LOG(IPASoftAf, Debug) << "Frame " << frame << " position " << lens.position
+				      << " variance " << variance << " score " << score;
+		if (stage_ == Stage::Warmup) {
+			if (frameContext.sensorTimestamp >= warmupUntil_) {
+				originalPosition_ = std::clamp(lens.position, low_, high_);
+				position_ = originalPosition_;
+				stage_ = Stage::Probe;
+				probeScore0_ = -1.0;
+				move(context, position_);
+			}
+		} else if (stage_ == Stage::Restore) {
+			finish(controls::AfStateFailed, score);
+		} else if (stage_ != Stage::Idle) {
+			if (variance < 3.0)
+				fail(context, "insufficient texture");
+			else
+				scan(context, score);
+		} else if (mode_ == controls::AfModeContinuous) {
+			double sceneChange = 0;
+			for (unsigned int i = 0; i < scene_.size(); i++) {
+				double delta = scene_[i] - referenceScene_[i];
+				sceneChange += delta * delta / scene_.size();
+			}
+			bool changed = reference_ > 0
+				? (score < reference_ * 0.65 || score > reference_ * 1.5 || sceneChange > 0.035)
+				: variance >= 3.0;
+			LOG(IPASoftAf, Debug) << "Scene change " << sceneChange << " count " << changed_;
+			if (changed) {
+				if (++changed_ >= 4)
+					beginScan(context);
+			} else {
+				changed_ = 0;
+			}
+		}
+	}
+	metadata.set(controls::AfMode, mode_);
+	metadata.set(controls::AfState, state_);
+	metadata.set(controls::AfPauseState, pauseState_);
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
