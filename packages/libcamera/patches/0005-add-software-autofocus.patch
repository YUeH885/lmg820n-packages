+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera::ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, uint32_t frame,
+			  IPAFrameContext &frameContext, const ControlList &controls) override;
+	void process(IPAContext &context, uint32_t frame, IPAFrameContext &frameContext,
+		     const SwIspStats *stats, ControlList &metadata) override;
+
+private:
+	enum class Stage { Idle, Warmup, Probe, Climb, Refine, Confirm, Restore };
+	void beginScan(IPAContext &context);
+	void move(IPAContext &context, int position);
+	void fail(IPAContext &context, const char *reason);
+	void finish(int state, double score);
+	void applyControls(IPAContext &context, const IPAFrameContext &frameContext);
+	void scan(IPAContext &context, double score);
+
+	bool enabled_ = false;
+	int low_, high_, coarseStep_, fineStep_;
+	uint64_t settleNs_, warmupNs_;
+	unsigned int samplesPerPosition_;
+	int defaultMode_;
+	int mode_, state_, pauseState_;
+	bool paused_, deferredPause_;
+	Stage stage_;
+	uint64_t warmupUntil_;
+	int position_, originalPosition_, bestPosition_;
+	int direction_;
+	int dropCount_;
+	int steps_;
+	double probeScore0_;
+	double best_, worst_, reference_;
+	std::array<double, SwIspStats::Focus::kGridSize> scene_, referenceScene_;
+	unsigned int changed_;
+	std::vector<double> samples_;
+};
+
+} /* namespace libcamera::ipa::soft::algorithms */
