From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: apply IMX520 module white-balance calibration

Load verified module ratios through the sensor NVMEM provider. Apply
calibration to the reference locus, initialization, detection zones and
fixed scene targets. Query the unchanged gain mesh with the factory's
reciprocal-multiply conversion. Publish calibrated startup gains and use
the calibrated locus for manual white-balance color temperature.

diff --git a/src/libcamera/pipeline/qcom/imx520_awb_calibration.h b/src/libcamera/pipeline/qcom/imx520_awb_calibration.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/imx520_awb_calibration.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "awb_calibration.h"
+
+namespace libcamera::qcom {
+
+inline std::optional<std::vector<QtiAwbIlluminantCalibration>>
+imx520AwbCalibration(const std::array<uint8_t, 16> &block)
+{
+	auto word = [&block](unsigned int offset) -> uint16_t {
+		return block[offset] | static_cast<uint16_t>(block[offset + 1]) << 8;
+	};
+	for (unsigned int offset : { 0U, 8U }) {
+		unsigned int sum = 0;
+		for (unsigned int i = 0; i < 6; i++)
+			sum += block[offset + i];
+		if (!sum || sum != word(offset + 6))
+			return std::nullopt;
+	}
+	constexpr std::array<unsigned int, 5> ccts{ 6500, 3800, 2850, 5000, 2300 };
+	constexpr std::array<unsigned int, 5> offsets{ 0, 0, 8, 0, 8 };
+	std::vector<QtiAwbIlluminantCalibration> result;
+	for (unsigned int i = 0; i < ccts.size(); i++) {
+		int16_t red = word(offsets[i]);
+		int16_t blue = word(offsets[i] + 2);
+		result.push_back({ 1, ccts[i], { red / 1024.0f, blue / 1024.0f } });
+	}
+	return result;
+}
+
+} /* namespace libcamera::qcom */
