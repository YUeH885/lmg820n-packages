+
+	std::array<QtiAwbPoint, 15> calibratedReference() const
+	{
+		auto reference = config_.reference;
+		for (unsigned int i = 0; i < calibration_.factors().size(); i++)
+			reference[i] = calibration_.toSensor(reference[i], i);
+		return reference;
+	}
+
+	QtiAwbPoint calibratePoint(QtiAwbPoint point) const
+	{
+		return calibration_.toSensor(point, locus_.evaluate(point).illuminant);
+	}
+
+	QtiAwbCoordinates calibrateZone(QtiAwbGeometry geometry, QtiAwbCoordinates coordinates) const
+	{
+		if (geometry != QtiAwbGeometry::Cct)
+			for (unsigned int i = 0; i < coordinates.size(); i += 2) {
+				auto point = calibratePoint({ coordinates[i], coordinates[i + 1] });
+				coordinates[i] = point.rg;
+				coordinates[i + 1] = point.bg;
+			}
+		return coordinates;
+	}
