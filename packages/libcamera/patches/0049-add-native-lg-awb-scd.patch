-			lgAwbProduct(retained, target.cct));
@@ -217,0 +209,84 @@
+struct LgAwbScdConfiguration {
+	float minimumFlatMetric;
+	std::array<int16_t, 2> lux;
+	float historyWeight;
+	LgAwbRatios coefficients;
+};
+
+struct LgAwbScdControls {
+	int lux;
+	unsigned int flashState, faceCount, usecase;
+	int32_t grayCct;
+	uint32_t grayIlluminant;
+	bool aeSettled;
+	float flatMetric;
+	std::optional<float> iqmSecond;
+};
+
+enum class LgAwbScdStatus : uint32_t {
+	InvalidHistoryGain = 0, LuxOrFlash = 1, FlatMetric = 2, Faces = 3,
+	HistoryCount = 4, HistoryIlluminant = 5, AeUnsettled = 6, Usecase = 7,
+	LowGrayCct = 8, GrayGeometry = 9, Iqm = 10, GrayCctRange = 11, Applied = 12,
+};
+
+struct LgAwbScdResult {
+	LgAwbScdStatus status;
+	std::optional<uint32_t> historyIlluminant;
+};
+
+class LgAwbScd
+{
+public:
+	explicit LgAwbScd(const LgAwbScdConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	LgAwbScdResult apply(LgAwbGainTarget &target, const LgAwbHistory &history,
+			     const LgAwbGrayReferences &references, LgAwbPoint gray,
+			     const LgAwbScdControls &controls) const
+	{
+		if (controls.grayCct >= 4301 && controls.grayCct <= 5499)
+			return { LgAwbScdStatus::GrayCctRange, std::nullopt };
+		if (controls.lux < config_.lux[0] || controls.lux > config_.lux[1] || controls.flashState)
+			return { LgAwbScdStatus::LuxOrFlash, std::nullopt };
+		if (controls.flatMetric < config_.minimumFlatMetric)
+			return { LgAwbScdStatus::FlatMetric, std::nullopt };
+		if (controls.faceCount)
+			return { LgAwbScdStatus::Faces, std::nullopt };
+		if (history.size(LgAwbHistoryKind::Initial) <= 2)
+			return { LgAwbScdStatus::HistoryCount, std::nullopt };
+		if (controls.iqmSecond && *controls.iqmSecond > 0.5f)
+			return { LgAwbScdStatus::Iqm, std::nullopt };
+		if (controls.flatMetric >= 1 && !controls.aeSettled)
+			return { LgAwbScdStatus::AeUnsettled, std::nullopt };
+		if (controls.usecase != 0 && controls.usecase != 2 && controls.usecase != 4)
+			return { LgAwbScdStatus::Usecase, std::nullopt };
+		if (controls.grayCct < 3000)
+			return { LgAwbScdStatus::LowGrayCct, std::nullopt };
+		auto sample = *history.lookup(LgAwbHistoryKind::Initial);
+		if (sample.illuminant != 2)
+			return { LgAwbScdStatus::HistoryIlluminant, sample.illuminant };
+		if (controls.grayIlluminant == 2) {
+			auto first = references.points[2], last = references.points[3], extra = references.points[6];
+			float dx = last.x - first.x;
+			float slope = (last.y - first.y) / dx;
+			float intercept = (lgAwbProduct(first.y, last.x) - lgAwbProduct(first.x, last.y)) / dx;
+			float floor = lgAwbProduct(extra.y - (lgAwbProduct(extra.x, slope) + intercept), 0.5f);
+			float distance = gray.y - (lgAwbProduct(gray.x, slope) + intercept);
+			if (!(gray.x > first.x) || !(gray.y > first.y) || distance <= floor || distance <= 0 || floor <= 0)
+				return { LgAwbScdStatus::GrayGeometry, sample.illuminant };
+		}
+		if (LgAwbGain::invalid(sample.rgb))
+			return { LgAwbScdStatus::InvalidHistoryGain, sample.illuminant };
+		lgAwbBlendGain(target, sample.rgb, sample.cct, config_.historyWeight);
+		target.rgb[0] = lgAwbProduct(target.rgb[0], config_.coefficients.red);
+		target.rgb[2] = lgAwbProduct(target.rgb[2], config_.coefficients.blue);
+		target.source = LgAwbGainSource::Scd;
+		return { LgAwbScdStatus::Applied, sample.illuminant };
+	}
+
+private:
+	LgAwbScdConfiguration config_;
+};
+
