From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add native LG AWB SCD correction

Generate per-sensor scene gates, history mixing weights and gain factors.
Use gray CCT for gating and target CCT for mixing. Consume the native
initial history, preserve factory gate order and expose conditional
history-illuminant diagnostics. Share rounded RGB/CCT mixing with OHE
and FOE.

diff --git a/src/libcamera/pipeline/qcom/lg_awb_target.h b/src/libcamera/pipeline/qcom/lg_awb_target.h
--- a/src/libcamera/pipeline/qcom/lg_awb_target.h
+++ b/src/libcamera/pipeline/qcom/lg_awb_target.h
@@ -12 +12 @@
-	None = 0, Gray = 1, History = 2, Previous = 3, Dtb = 5, Ohe = 6, Foe = 9,
+	None = 0, Gray = 1, History = 2, Previous = 3, Scd = 4, Dtb = 5, Ohe = 6, Foe = 9,
@@ -19,0 +20,9 @@
+
+inline void lgAwbBlendGain(LgAwbGainTarget &target, const LgAwbRgb &reference, int32_t cct, float weight)
+{
+	float retained = 1.0f - weight;
+	for (unsigned int channel = 0; channel < target.rgb.size(); channel++)
+		target.rgb[channel] = lgAwbProduct(weight, reference[channel]) +
+			lgAwbProduct(retained, target.rgb[channel]);
+	target.cct = static_cast<int32_t>(lgAwbProduct(weight, cct) + lgAwbProduct(retained, target.cct));
+}
