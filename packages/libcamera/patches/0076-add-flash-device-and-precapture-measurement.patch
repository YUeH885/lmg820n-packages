 namespace {
 
+class FlashDevice
+{
+public:
+	static FlashDevice &instance()
+	{
+		static FlashDevice dev;
+		return dev;
+	}
+
+	bool isAvailable() const { return hasFlash_; }
+
+	void turnOff()
+	{
+		if (!hasFlash_)
+			return;
+		setSysfs(whiteBrightnessFd_, 0);
+		setSysfs(yellowBrightnessFd_, 0);
+		setSysfs(whiteStrobeFd_, 0);
+		torchOn_ = false;
+		strobeActive_ = false;
+	}
+
+	void setTorch(bool on, uint32_t brightness = 255)
+	{
+		if (!hasFlash_)
+			return;
+		if (on) {
+			setSysfs(whiteBrightnessFd_, std::min<uint32_t>(brightness, 255));
+			torchOn_ = true;
+		} else {
+			setSysfs(whiteBrightnessFd_, 0);
+			setSysfs(yellowBrightnessFd_, 0);
+			torchOn_ = false;
+		}
+	}
+
+	void triggerFlash(uint32_t currentUa = 900000, uint32_t timeoutUs = 200000)
+	{
+		if (!hasFlash_)
+			return;
+		setSysfs(whiteFlashBrightnessFd_, std::min<uint32_t>(currentUa, 900000));
+		setSysfs(whiteTimeoutFd_, std::min<uint32_t>(timeoutUs, 500000));
+		setSysfs(whiteStrobeFd_, 1);
+		strobeActive_ = true;
+	}
+
+	bool isTorchOn() const { return torchOn_; }
+	bool isStrobeActive() const { return strobeActive_; }
+
+private:
+	FlashDevice()
+		: hasFlash_(false), torchOn_(false), strobeActive_(false),
+		  whiteBrightnessFd_(-1), whiteStrobeFd_(-1),
+		  whiteTimeoutFd_(-1), whiteFlashBrightnessFd_(-1),
+		  yellowBrightnessFd_(-1)
+	{
+		init();
+	}
+
+	~FlashDevice()
+	{
+		turnOff();
+		closeFds();
+	}
+
+	void init()
+	{
+		whiteBrightnessFd_ = open("/sys/class/leds/white:flash/brightness", O_WRONLY | O_CLOEXEC);
+		whiteStrobeFd_ = open("/sys/class/leds/white:flash/flash_strobe", O_WRONLY | O_CLOEXEC);
+		whiteTimeoutFd_ = open("/sys/class/leds/white:flash/flash_timeout", O_WRONLY | O_CLOEXEC);
+		whiteFlashBrightnessFd_ = open("/sys/class/leds/white:flash/flash_brightness", O_WRONLY | O_CLOEXEC);
+		yellowBrightnessFd_ = open("/sys/class/leds/yellow:flash/brightness", O_WRONLY | O_CLOEXEC);
+
+		hasFlash_ = (whiteBrightnessFd_ >= 0 && whiteStrobeFd_ >= 0);
+		turnOff();
+	}
+
+	void closeFds()
+	{
+		auto safeClose = [](int &fd) {
+			if (fd >= 0) {
+				close(fd);
+				fd = -1;
+			}
+		};
+		safeClose(whiteBrightnessFd_);
+		safeClose(whiteStrobeFd_);
+		safeClose(whiteTimeoutFd_);
+		safeClose(whiteFlashBrightnessFd_);
+		safeClose(yellowBrightnessFd_);
+	}
+
+	static void setSysfs(int fd, uint32_t val)
+	{
+		if (fd < 0)
+			return;
+		std::string str = std::to_string(val) + "\n";
+		lseek(fd, 0, SEEK_SET);
+		[[maybe_unused]] auto ret = write(fd, str.c_str(), str.size());
+	}
+
+	bool hasFlash_;
+	bool torchOn_;
+	bool strobeActive_;
+	int whiteBrightnessFd_;
+	int whiteStrobeFd_;
+	int whiteTimeoutFd_;
+	int whiteFlashBrightnessFd_;
+	int yellowBrightnessFd_;
+};
