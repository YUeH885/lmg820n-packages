diff --git a/src/libcamera/pipeline/qcom/lg_awb_exceptions.h b/src/libcamera/pipeline/qcom/lg_awb_exceptions.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_exceptions.h
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+#include "lg_awb_gray.h"
+#include "lg_awb_math.h"
+#include "lg_awb_target.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbOheConfiguration {
+	bool enabled;
+	std::array<int16_t, 2> lux, grayCount;
+	LgAwbRatios reference;
+	int16_t maximumPercent;
+};
+
+struct LgAwbDtbGainRegion {
+	unsigned int reference;
+	int16_t minimumCount;
+	bool blockWhenGrayValid;
+	std::array<LgAwbRatios, 24> coefficients;
+};
+
+struct LgAwbDtbConfiguration {
+	std::array<unsigned int, 2> count;
+	std::array<std::array<LgAwbDtbGainRegion, 10>, 2> regions;
+	std::array<int16_t, 24> luxKnots;
+	unsigned int additionalCount;
+	std::array<LgAwbRatios, 11> additional;
+	std::array<uint32_t, 10> additionalLights;
+};
+
+class LgAwbOhe
+{
+public:
+	explicit LgAwbOhe(const LgAwbOheConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void reset() { weight_ = 0; }
+	float weight() const { return weight_; }
+
+	void apply(LgAwbGainTarget &target, const LgAwbColour &colour, int lux, int grayCount)
+	{
+		if (!config_.enabled)
+			return;
+		weight_ = lgAwbProduct(lgAwbProduct(config_.maximumPercent, 0.01f),
+			lgAwbProduct(decreasing(lux, config_.lux), decreasing(grayCount, config_.grayCount)));
+		if (weight_ <= 0)
+			return;
+		auto ratios = colour.nominalRgb()[2];
+		LgAwbRgb reference{ config_.reference.red / ratios.red, 1, config_.reference.blue / ratios.blue };
+		float retained = 1.0f - weight_;
+		for (unsigned int channel = 0; channel < target.rgb.size(); channel++)
+			target.rgb[channel] = lgAwbProduct(weight_, reference[channel]) +
+				lgAwbProduct(retained, target.rgb[channel]);
+		target.cct = static_cast<int32_t>(lgAwbProduct(weight_, 5000.0f) +
+			lgAwbProduct(retained, target.cct));
+		target.source = LgAwbGainSource::Ohe;
+	}
+
+private:
+	static float decreasing(int value, const std::array<int16_t, 2> &range)
+	{
+		if (value < range[0])
+			return 1;
+		if (value > range[1])
+			return 0;
+		return 1.0f - static_cast<float>(value - range[0]) / (range[1] - range[0]);
+	}
+
+	LgAwbOheConfiguration config_;
+	float weight_ = 0;
+};
+
+class LgAwbDtb
+{
+public:
+	explicit LgAwbDtb(const LgAwbDtbConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void reset()
+	{
+		selection_ = 20;
+	}
+
+	unsigned int selection() const { return selection_; }
+
+	std::optional<LgAwbRatios> apply(LgAwbGainTarget &target, const LgAwbColour &colour,
+		   const LgAwbGrayReferences &references, const std::array<uint16_t, 20> &counts,
+		   int lux, float validFraction, float latestGrayX, bool grayValid, bool blocked)
+	{
+		select(0, counts, validFraction);
+		if (selection_ == 20)
+			select(1, counts, validFraction);
+		if (selection_ == 20)
+			return std::nullopt;
+		const auto &region = config_.regions[selection_ / 10][selection_ % 10];
+		float boundary = lgAwbProduct(references.points[3].x + references.points[4].x, 0.5f);
+		if ((region.blockWhenGrayValid && grayValid) || blocked ||
+		    (region.reference == 5 && lux <= 349 && std::abs(latestGrayX) > 1e-6f && latestGrayX <= boundary) ||
+		    region.reference >= 6 + config_.additionalCount) {
+			selection_ = 20;
+			return std::nullopt;
+		}
+		LgAwbRatios coefficients;
+		unsigned int index = std::lower_bound(config_.luxKnots.begin(), config_.luxKnots.end(), lux) -
+			config_.luxKnots.begin();
+		if (index == 0 || index == config_.luxKnots.size()) {
+			coefficients = region.coefficients[index ? index - 1 : 0];
+		} else {
+			float t = static_cast<float>(lux - config_.luxKnots[index - 1]) /
+				(config_.luxKnots[index] - config_.luxKnots[index - 1]);
+			auto first = region.coefficients[index - 1], last = region.coefficients[index];
+			coefficients = { first.red + lgAwbProduct(t, last.red - first.red),
+					  first.blue + lgAwbProduct(t, last.blue - first.blue) };
+		}
+		auto ratios = region.reference < 6 ? colour.nominalRgb()[region.reference] :
+			config_.additional[region.reference - 6];
+		target.rgb = { lgAwbProduct(1.0f / ratios.red, coefficients.red), 1,
+			       lgAwbProduct(1.0f / ratios.blue, coefficients.blue) };
+		unsigned int light = region.reference < 7 ? region.reference : config_.additionalLights[region.reference - 7];
+		constexpr std::array<int32_t, 6> temperatures{ 7500, 6500, 5000, 4000, 2856, 2300 };
+		target.cct = light < temperatures.size() ? temperatures[light] : 5000;
+		target.source = LgAwbGainSource::Dtb;
+		return coefficients;
+	}
+
+private:
+	void select(unsigned int group, const std::array<uint16_t, 20> &counts, float fraction)
+	{
+		for (unsigned int i = 0; i < config_.count[group]; i++) {
+			int threshold = static_cast<int>(lgAwbProduct(config_.regions[group][i].minimumCount, fraction) + 0.5f);
+			if (static_cast<int16_t>(counts[group * 10 + i]) > threshold) {
+				selection_ = group * 10 + i;
+				break;
+			}
+		}
+	}
+
+	LgAwbDtbConfiguration config_;
+	unsigned int selection_ = 20;
+};
+
+} /* namespace libcamera::qcom */
