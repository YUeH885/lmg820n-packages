+++ b/include/libcamera/internal/v4l2_videodevice.h
@@ -223,6 +223,7 @@ public:
 
 	int streamOn();
 	int streamOff();
+	unsigned int sequenceOffset() const { return firstFrame_.value(); }
 
 	void setDequeueTimeout(utils::Duration timeout);
 	Signal<> dequeueTimeout;
