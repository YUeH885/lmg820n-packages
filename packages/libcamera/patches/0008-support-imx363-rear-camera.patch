+
+double gainFromCode(const SensorProfile &profile, int32_t code)
+{
+	if (profile.gainModel == GainModel::Linear32)
+		return code / 32.0;
+
+	return 1024.0 / (1024.0 - code);
+}
+
+int32_t gainToCode(const SensorProfile &profile, double gain)
+{
+	if (profile.gainModel == GainModel::Linear32)
+		return static_cast<int32_t>(gain * 32.0);
+
+	return std::lround(1024.0 - 1024.0 / gain);
+}
+
+std::optional<double> aeRegionLuma(const SensorProfile &profile,
+				   const uint64_t sums[4],
+				   const uint64_t counts[4])
+{
+	double values[4];
+	for (unsigned int c = 0; c < 4; c++) {
+		if (!counts[c])
+			return std::nullopt;
+		values[c] = std::max(0.0, static_cast<double>(sums[c]) /
+				     counts[c] - profile.blackLevel);
+	}
+
+	return profile.aeRgbWeights[0] * values[0] +
+	       profile.aeRgbWeights[1] * (values[2] + values[3]) * 0.5 +
+	       profile.aeRgbWeights[2] * values[1];
+}
+
+double profileTotalExposure(const AeExposureKnee &knee)
+{
+	return knee.gain * knee.exposureNs;
+}
+
+double aeExposureIndex(const SensorProfile &profile, double total)
+{
+	const AeExposureKnee *knees = profile.aeExposureKnees;
+	if (total <= profileTotalExposure(knees[0]))
+		return knees[0].index;
+
+	for (std::size_t i = 0; i + 1 < profile.aeExposureKneeCount; i++) {
+		double lower = profileTotalExposure(knees[i]);
+		double upper = profileTotalExposure(knees[i + 1]);
+		if (total <= upper) {
+			double t = (std::log2(total) - std::log2(lower)) /
+				   (std::log2(upper) - std::log2(lower));
+			return knees[i].index + t *
+			       (knees[i + 1].index - knees[i].index);
+		}
+	}
+
+	return knees[profile.aeExposureKneeCount - 1].index;
+}
+
+double aeLuxIndex(const SensorProfile &profile, double exposureIndex,
+		  double luma10)
+{
+	double luma8 = std::max(luma10 / kAeTargetScale,
+				profile.aeLuxLumaMinimum8);
+	return std::max(0.0, exposureIndex + profile.aeLuxLogScale *
+				     std::log10(profile.aeLuxReferenceLuma8 / luma8));
+}
+
+double aeTargetForLux(const SensorProfile &profile, double lux)
+{
+	const AeLuxZone *zones = profile.aeLuxZones;
+	if (lux <= zones[0].start)
+		return zones[0].target8;
+
+	for (std::size_t i = 0; i + 1 < profile.aeLuxZoneCount; i++) {
+		const AeLuxZone &zone = zones[i];
+		const AeLuxZone &next = zones[i + 1];
+		if (lux <= zone.end)
+			return zone.target8;
+		if (lux < next.start) {
+			double t = (lux - zone.end) / (next.start - zone.end);
+			return zone.target8 + t * (next.target8 - zone.target8);
+		}
+	}
+
+	return zones[profile.aeLuxZoneCount - 1].target8;
+}
+
+void aeAllocateExposure(const SensorProfile &profile, double total,
+			double &gain, double &exposureNs)
+{
+	const AeExposureKnee *knees = profile.aeExposureKnees;
+	if (total <= profileTotalExposure(knees[0])) {
+		gain = knees[0].gain;
+		exposureNs = knees[0].exposureNs;
+		return;
+	}
+
+	for (std::size_t i = 0; i + 1 < profile.aeExposureKneeCount; i++) {
+		double lower = profileTotalExposure(knees[i]);
+		double upper = profileTotalExposure(knees[i + 1]);
+		if (total <= upper) {
+			double t = (std::log2(total) - std::log2(lower)) /
+				   (std::log2(upper) - std::log2(lower));
+			gain = knees[i].gain *
+			       std::pow(knees[i + 1].gain / knees[i].gain, t);
+			exposureNs = total / gain;
+			return;
+		}
+	}
+
+	const AeExposureKnee &last = knees[profile.aeExposureKneeCount - 1];
+	gain = last.gain;
+	exposureNs = last.exposureNs;
+}
+
+double estimateCct(const SensorProfile &profile, double rg, double bg)
+{
+	double bestDistance = std::numeric_limits<double>::max();
+	double cct = 4250.0;
+	for (std::size_t i = 0; i + 1 < profile.cctReferenceCount; i++) {
+		const CctReference &lower = profile.cctReferences[i];
+		const CctReference &upper = profile.cctReferences[i + 1];
+		double dx = upper.rg - lower.rg;
+		double dy = upper.bg - lower.bg;
+		double t = std::clamp(((rg - lower.rg) * dx + (bg - lower.bg) * dy) /
+				      (dx * dx + dy * dy), 0.0, 1.0);
+		double ex = rg - (lower.rg + t * dx);
+		double ey = bg - (lower.bg + t * dy);
+		double distance = ex * ex + ey * ey;
+		if (distance < bestDistance) {
+			bestDistance = distance;
+			cct = 1.0 / ((1.0 - t) / lower.cct + t / upper.cct);
+		}
+	}
+	return cct;
+}
+
+void interpolateCcm(const SensorProfile &profile, double cct,
+		    int16_t (&coefficients)[9])
+{
+	const CcmEntry *entries = profile.ccmEntries;
+	cct = std::clamp(cct, static_cast<double>(entries[0].cct),
+			 static_cast<double>(entries[profile.ccmEntryCount - 1].cct));
+	std::size_t i = 0;
+	while (i + 2 < profile.ccmEntryCount && cct > entries[i + 1].cct)
+		i++;
+	const CcmEntry &lower = entries[i];
+	const CcmEntry &upper = entries[i + 1];
+	double t = (cct - lower.cct) / (upper.cct - lower.cct);
+	for (unsigned int j = 0; j < 9; j++)
+		coefficients[j] = std::lround(lower.q7[j] +
+					       t * (upper.q7[j] - lower.q7[j]));
+}
