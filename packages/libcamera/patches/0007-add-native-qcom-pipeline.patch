+CameraConfiguration::Status QcomCameraConfiguration::validate()
+{
+	Status status = Valid;
+
+	if (config_.empty())
+		return Invalid;
+
+	/* A single hardware NV12 stream is supported. */
+	if (config_.size() > 1) {
+		config_.resize(1);
+		status = Adjusted;
+	}
+
+	StreamConfiguration &cfg = config_[0];
+
+	if (cfg.pixelFormat != formats::NV12) {
+		cfg.pixelFormat = formats::NV12;
+		status = Adjusted;
+	}
+
+	bool sizeSupported = false;
+	for (const Size &size : kOutputSizes)
+		if (cfg.size == size)
+			sizeSupported = true;
+
+	if (!sizeSupported) {
+		cfg.size = kNativeSize;
+		status = Adjusted;
+	}
+
+	cfg.bufferCount = kBufferCount;
+	if (cfg.colorSpace != ColorSpace::Sycc) {
+		cfg.colorSpace = ColorSpace::Sycc;
+		status = Adjusted;
+	}
+
+	V4L2DeviceFormat format;
+	format.fourcc = data_->video_->toV4L2PixelFormat(cfg.pixelFormat);
+	format.size = cfg.size;
+	format.colorSpace = cfg.colorSpace;
+
+	if (data_->video_->tryFormat(&format)) {
+		LOG(QcomPipeline, Error)
+			<< "VFE PIX does not support NV12 " << cfg.size;
+		return Invalid;
+	}
+
+	if (format.fourcc != data_->video_->toV4L2PixelFormat(cfg.pixelFormat) ||
+	    format.size != cfg.size) {
+		LOG(QcomPipeline, Error)
+			<< "Unexpected VFE PIX format " << format.toString();
+		return Invalid;
+	}
+
+	cfg.stride = format.planes[0].bpl;
+	cfg.frameSize = format.planes[0].size;
+
+	return status;
+}
