+constexpr Size kFullSize{ 4032, 3024 };
+constexpr Size kOutputSizes[] = {
+	{ 4032, 3024 },
+	{ 2016, 1136 },
+	{ 1920, 1080 },
+	{ 1280, 720 },
+	{ 1008, 568 },
+	{ 640, 360 },
+};
+constexpr unsigned int kBufferCount = 4;
+
+constexpr int kAfPositionMin = 100;
+constexpr int kAfPositionMax = 1400;
+constexpr int kAfCoarseStep = 80;
+constexpr int kAfFineStep = 25;
+constexpr uint64_t kAfSettleNs = 50ULL * 1000 * 1000;
+constexpr uint64_t kAfWarmupNs = 1000ULL * 1000 * 1000;
+
+constexpr double kBlackLevel = 64.0;
+using namespace qcom;
+
+uint64_t monotonicNs()
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(
+		utils::clock::now().time_since_epoch()).count();
+}
