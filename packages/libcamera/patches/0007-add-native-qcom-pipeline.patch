diff --git a/src/libcamera/pipeline/qcom/s5k3m5.h b/src/libcamera/pipeline/qcom/s5k3m5.h
new file mode 100644
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/s5k3m5.h
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <iterator>
+#include <limits>
+
+namespace libcamera::qcom {
+
+/* PIX image and statistics DMA complete one CAMIF SOF after their input frame. */
+inline uint32_t inputSequence(uint32_t completedSequence)
+{
+	return completedSequence ? completedSequence - 1 : 0;
+}
+
+struct CcmEntry {
+	unsigned int cct;
+	int16_t q7[9];
+};
+
+struct CctReference {
+	double cct;
+	double rg;
+	double bg;
+};
+
+#include "s5k3m5_tuning.h"
+
+/* Measured far-scene, 1 m and 20 cm positions; see camera.md. */
+constexpr double kLensCodes[] = { 100, 212, 1075 };
+constexpr double kLensDioptres[] = { 0, 1, 5 };
+constexpr int kLensCodeMin = 100;
+constexpr int kLensCodeMax = 1400;
+constexpr double kLensPositionMin = 0.0;
+constexpr double kLensPositionMax = 5.0 + (kLensCodeMax - 1075) * 4.0 / 863.0;
+
+inline double lensInterpolate(double value, const double *input, const double *output)
+{
+	unsigned int i = value < input[1] ? 0 : 1;
+	double t = (value - input[i]) / (input[i + 1] - input[i]);
+	return output[i] + t * (output[i + 1] - output[i]);
+}
+
+inline double lensPositionFromCode(int code)
+{
+	return std::clamp(lensInterpolate(code, kLensCodes, kLensDioptres),
+			  kLensPositionMin, kLensPositionMax);
+}
+
+inline int lensPositionToCode(double position)
+{
+	return std::clamp(static_cast<int>(std::lround(
+		lensInterpolate(position, kLensDioptres, kLensCodes))),
+		kLensCodeMin, kLensCodeMax);
+}
+
+inline double estimateCct(double rg, double bg)
+{
+	double bestDistance = std::numeric_limits<double>::max();
+	double cct = 4250.0;
+	for (unsigned int i = 0; i + 1 < std::size(kCctReferences); i++) {
+		const auto &lower = kCctReferences[i];
+		const auto &upper = kCctReferences[i + 1];
+		double dx = upper.rg - lower.rg;
+		double dy = upper.bg - lower.bg;
+		double t = std::clamp(((rg - lower.rg) * dx + (bg - lower.bg) * dy) /
+				      (dx * dx + dy * dy), 0.0, 1.0);
+		double ex = rg - (lower.rg + t * dx);
+		double ey = bg - (lower.bg + t * dy);
+		double distance = ex * ex + ey * ey;
+		if (distance < bestDistance) {
+			bestDistance = distance;
+			/* Reciprocal temperature is linear along the illuminant locus. */
+			cct = 1.0 / ((1.0 - t) / lower.cct + t / upper.cct);
+		}
+	}
+	return cct;
+}
+
+inline void interpolateCcm(double cct, int16_t (&coefficients)[9])
+{
+	cct = std::clamp(cct, static_cast<double>(kCcmEntries[0].cct),
+			 static_cast<double>(kCcmEntries[std::size(kCcmEntries) - 1].cct));
+	unsigned int i = 0;
+	while (i + 2 < std::size(kCcmEntries) && cct > kCcmEntries[i + 1].cct)
+		i++;
+	const auto &lower = kCcmEntries[i];
+	const auto &upper = kCcmEntries[i + 1];
+	double t = (cct - lower.cct) / (upper.cct - lower.cct);
+	for (unsigned int j = 0; j < 9; j++)
+		coefficients[j] = std::lround(lower.q7[j] + t * (upper.q7[j] - lower.q7[j]));
+}
+
+} /* namespace libcamera::qcom */
