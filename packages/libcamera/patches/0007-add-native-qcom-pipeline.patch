+int QcomCameraData::init(MediaEntity *sensorEntity)
+{
+	int ret;
+
+	sensor_ = CameraSensorFactoryBase::create(sensorEntity);
+	if (!sensor_)
+		return -ENODEV;
+
+	pixEntity_ = media_->getEntityByName("msm_vfe0_pix");
+	if (!pixEntity_) {
+		LOG(QcomPipeline, Error) << "VFE PIX entity not found";
+		return -ENODEV;
+	}
+
+	ret = findPath(sensorEntity, pixEntity_);
+	if (ret < 0) {
+		LOG(QcomPipeline, Error) << "Failed to find sensor to VFE PIX path";
+		return ret;
+	}
+
+	ret = disableLinks();
+	if (ret < 0)
+		return ret;
+
+	MediaEntity *videoEntity = nullptr;
+	for (const MediaPad *pad : pixEntity_->pads()) {
+		if (!(pad->flags() & MEDIA_PAD_FL_SOURCE))
+			continue;
+
+		for (MediaLink *link : pad->links()) {
+			MediaEntity *next = link->sink()->entity();
+			if (next->function() == MEDIA_ENT_F_IO_V4L) {
+				videoEntity = next;
+				break;
+			}
+		}
+	}
+
+	if (!videoEntity) {
+		LOG(QcomPipeline, Error) << "VFE PIX video node not found";
+		return -ENODEV;
+	}
+
+	pix_ = std::make_unique<V4L2Subdevice>(pixEntity_);
+	ret = pix_->open();
+	if (ret < 0)
+		return ret;
+
+	video_ = V4L2VideoDevice::fromEntityName(media_.get(), videoEntity->name());
+	if (!video_) {
+		LOG(QcomPipeline, Error) << "Failed to open VFE PIX video node";
+		return -ENODEV;
+	}
+
+	ret = video_->open();
+	if (ret < 0)
+		return ret;
+
+	video_->bufferReady.connect(this, &QcomCameraData::imageBufferReady);
+
+	const CameraSensorProperties::SensorDelays &delays = sensor_->sensorDelays();
+	std::unordered_map<uint32_t, DelayedControls::ControlParams> params = {
+		{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
+		{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
+	};
+	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
+	pix_->frameStart.connect(this, &QcomCameraData::frameStart);
+
+	ret = refreshSensorInfo();
+	if (ret < 0)
+		return ret;
+
+	awb_ = std::vector<uint32_t>(QCOM_CAMSS_AWB_BG_REGIONS *
+				     QCOM_CAMSS_AWB_BG_REGION_SIZE / sizeof(uint32_t));
+	hist_ = std::vector<uint32_t>(QCOM_CAMSS_BHIST_BINS);
+	bf_ = std::vector<uint64_t>(QCOM_CAMSS_BF_SIZE / sizeof(uint64_t));
+
+	lens_ = sensor_->focusLens();
+	afEnabled_ = lens_ != nullptr;
+	if (lens_) {
+		int32_t position = 0;
+		if (!lens_->getFocusPosition(&position))
+			afPosition_ = afOriginalPosition_ = afBestPosition_ =
+				std::clamp(position, kAfPositionMin, kAfPositionMax);
+	}
+
+	ControlInfoMap::Map ctrls;
+	ctrls[&controls::AeEnable] = ControlInfo(false, true, true);
+	ctrls[&controls::ExposureTime] = ControlInfo(
+		static_cast<int32_t>(exposureMin_ * lineDurationNs_ / 1000.0),
+		static_cast<int32_t>(exposureMax_ * lineDurationNs_ / 1000.0),
+		static_cast<int32_t>(aeExposure_ * lineDurationNs_ / 1000.0));
+	ctrls[&controls::AnalogueGain] = ControlInfo(
+		static_cast<float>(gainMin_), static_cast<float>(gainMax_),
+		static_cast<float>(aeGain_));
+	ctrls[&controls::AwbEnable] = ControlInfo(false, true, true);
+	ctrls[&controls::ColourGains] = ControlInfo(0.0f, 8.0f, 1.0f);
+	ctrls[&controls::AfMode] = ControlInfo(
+		{ { ControlValue(controls::AfModeManual),
+		    ControlValue(controls::AfModeAuto),
+		    ControlValue(controls::AfModeContinuous) } },
+		ControlValue(controls::AfModeContinuous));
+	ctrls[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	if (lens_)
+		ctrls[&controls::LensPosition] = ControlInfo(
+			static_cast<float>(kLensPositionMin),
+			static_cast<float>(kLensPositionMax),
+			static_cast<float>(lensPosition()));
+	ctrls[&controls::AfPause] = ControlInfo(
+		{ { ControlValue(controls::AfPauseImmediate),
+		    ControlValue(controls::AfPauseDeferred),
+		    ControlValue(controls::AfPauseResume) } },
+		ControlValue(controls::AfPauseResume));
+
+	controlInfo_ = ControlInfoMap(std::move(ctrls), controls::controls);
+	properties_ = sensor_->properties();
+
+	return 0;
+}
+
+int QcomCameraData::refreshSensorInfo()
+{
+	IPACameraSensorInfo info;
+	int ret = sensor_->sensorInfo(&info);
+	if (ret)
+		return ret;
+
+	lineDurationNs_ = 1e9 * info.minLineLength / info.pixelRate;
+	frameDurationNs_ = std::llround(lineDurationNs_ * info.minFrameLength);
+	const ControlInfoMap &controls = sensor_->controls();
+	exposureMin_ = controls.at(V4L2_CID_EXPOSURE).min().get<int32_t>();
+	exposureMax_ = controls.at(V4L2_CID_EXPOSURE).max().get<int32_t>();
+	gainMin_ = controls.at(V4L2_CID_ANALOGUE_GAIN).min().get<int32_t>();
+	gainMax_ = controls.at(V4L2_CID_ANALOGUE_GAIN).max().get<int32_t>();
+
+	const uint32_t ids[] = { V4L2_CID_EXPOSURE, V4L2_CID_ANALOGUE_GAIN };
+	ControlList initial = sensor_->getControls(ids);
+	if (initial.empty())
+		return -EIO;
+	aeExposure_ = initial.get(V4L2_CID_EXPOSURE).get<int32_t>();
+	aeGain_ = initial.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>();
+
+	if (!controlInfo_.empty()) {
+		ControlInfoMap::Map map;
+		for (const auto &[id, range] : controlInfo_)
+			map.emplace(id, range);
+		map[&libcamera::controls::ExposureTime] = ControlInfo(
+			static_cast<int32_t>(exposureMin_ * lineDurationNs_ / 1000),
+			static_cast<int32_t>(exposureMax_ * lineDurationNs_ / 1000),
+			static_cast<int32_t>(aeExposure_ * lineDurationNs_ / 1000));
+		controlInfo_ = ControlInfoMap(std::move(map), libcamera::controls::controls);
+	}
+	return 0;
+}
+
+void QcomCameraData::frameStart(uint32_t sequence)
+{
+	delayedCtrls_->applyControls(sequence);
+	if (nextIfe_ && sequence >= nextIfe_->first) {
+		appliedIfe_ = nextIfe_->second;
+		nextIfe_.reset();
+	}
+	frameStates_[sequence] = { appliedIfe_, static_cast<float>(lensPosition()),
+				   afMode_, afState_, afPauseState_ };
+	while (frameStates_.size() > 64)
+		frameStates_.erase(frameStates_.begin());
+	if (ifePending_) {
+		int ret = applyIfe(sequence + 1);
+		if (ret)
+			LOG(QcomPipeline, Error) << "IFE update for frame " << sequence + 1
+						 << " failed: " << ret;
+	}
+}
