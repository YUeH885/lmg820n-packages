@@ -0,0 +1,518 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <limits>
+#include <optional>
+#include <string>
+
+namespace libcamera::qcom {
+
+/* PIX image and statistics DMA complete one CAMIF SOF after their input frame. */
+inline uint32_t inputSequence(uint32_t completedSequence)
+{
+	return completedSequence ? completedSequence - 1 : 0;
+}
+
+struct CcmEntry {
+	unsigned int cct;
+	int16_t q7[9];
+};
+
+struct CctReference {
+	double cct;
+	double rg;
+	double bg;
+};
+
+#include "s5k3m5_tuning.h"
+
+/* The factory luma target is an 8-bit code; statistics use 10 bits. */
+constexpr double kAeTargetScale = 4.0;
+constexpr double kAeTolerance = kAeToleranceSteps * kAeTargetScale;
+constexpr double kLgAfLowLightLuma8 = 17.0;
+
+inline bool lgAfLowLight(double luma10)
+{
+	return luma10 < kLgAfLowLightLuma8 * kAeTargetScale;
+}
+
+struct LgAfMovePlan {
+	std::array<int, 4> targets{};
+	std::size_t count = 0;
+};
+
+inline LgAfMovePlan lgAfMovePlan(int current, int target)
+{
+	constexpr int kSegmentThreshold = 75;
+
+	LgAfMovePlan plan;
+	int distance = std::abs(target - current);
+	if (distance < kSegmentThreshold) {
+		plan.targets[0] = target;
+		plan.count = 1;
+		return plan;
+	}
+
+	/* The factory completion path submits three intermediate positions. */
+	int increment = distance / 5 + 1;
+	if (target < current)
+		increment = -increment;
+
+	for (unsigned int i = 0; i < 3; i++)
+		plan.targets[i] = current + increment * (i + 1);
+	plan.targets[3] = target;
+	plan.count = plan.targets.size();
+	return plan;
+}
+
+class LgAfCoarseStop
+{
+public:
+	void reset()
+	{
+		previousScore_.reset();
+		previousFocus_.reset();
+		riseStartFocus_.reset();
+		minimumScore_.reset();
+		maximumScore_.reset();
+		maximumRise_ = 0.0;
+		upCount_ = 0;
+		downCount_ = 0;
+		focusRangeStop_ = false;
+		flatRiseStop_ = false;
+	}
+
+	bool update(double score, bool lowLight)
+	{
+		uint64_t focus =
+			static_cast<uint64_t>(static_cast<float>(score)) >> 4;
+		minimumScore_ = minimumScore_
+			? std::min(*minimumScore_, focus) : focus;
+		maximumScore_ = maximumScore_
+			? std::max(*maximumScore_, focus) : focus;
+		if (previousScore_) {
+			if (score > *previousScore_) {
+				if (!upCount_)
+					riseStartFocus_ = previousFocus_;
+				upCount_++;
+				downCount_ = 0;
+				double rise = static_cast<double>(focus - *riseStartFocus_) /
+					std::max<uint64_t>(focus, 1);
+				maximumRise_ = std::max(maximumRise_, rise);
+			} else {
+				downCount_++;
+				upCount_ = 0;
+			}
+		}
+		previousScore_ = score;
+		previousFocus_ = focus;
+
+		focusRangeStop_ = false;
+		flatRiseStop_ = false;
+		if (downCount_ >= (lowLight ? 3U : 4U))
+			return true;
+		if (downCount_ > 2 && focusRange() > 0.1) {
+			focusRangeStop_ = true;
+			return true;
+		}
+		if (upCount_ > 2 && maximumRise_ < 0.01) {
+			flatRiseStop_ = true;
+			return true;
+		}
+		return false;
+	}
+
+	unsigned int upCount() const { return upCount_; }
+	unsigned int downCount() const { return downCount_; }
+	double maximumRise() const { return maximumRise_; }
+	double focusRange() const
+	{
+		if (!minimumScore_ || !maximumScore_)
+			return 0.0;
+		return static_cast<double>(*maximumScore_ - *minimumScore_) /
+			std::max<uint64_t>(*maximumScore_, 1);
+	}
+	bool focusRangeStop() const { return focusRangeStop_; }
+	bool flatRiseStop() const { return flatRiseStop_; }
+
+private:
+	std::optional<double> previousScore_;
+	std::optional<uint64_t> previousFocus_;
+	std::optional<uint64_t> riseStartFocus_;
+	std::optional<uint64_t> minimumScore_;
+	std::optional<uint64_t> maximumScore_;
+	double maximumRise_ = 0.0;
+	unsigned int upCount_ = 0;
+	unsigned int downCount_ = 0;
+	bool focusRangeStop_ = false;
+	bool flatRiseStop_ = false;
+};
+
+class LgAfSceneChange
+{
+public:
+	void reset()
+	{
+		previousScore_.reset();
+		unstable_ = false;
+		stableCount_ = 0;
+	}
+
+	bool update(double score)
+	{
+		uint64_t current =
+			static_cast<uint64_t>(static_cast<float>(score)) >> 4;
+		if (!previousScore_) {
+			previousScore_ = current;
+			return false;
+		}
+
+		uint64_t previous = *previousScore_;
+		previousScore_ = current;
+		uint64_t maximum = std::max(current, previous);
+		if (!maximum) {
+			stableCount_ = 0;
+			return false;
+		}
+
+		double change = static_cast<double>(
+			current > previous ? current - previous : previous - current) /
+			maximum;
+		if (change > 0.5) {
+			unstable_ = true;
+			stableCount_ = 0;
+			return false;
+		}
+
+		if (!unstable_)
+			return false;
+		if (change >= 0.1) {
+			stableCount_ = 0;
+			return false;
+		}
+
+		if (++stableCount_ < 4)
+			return false;
+		unstable_ = false;
+		stableCount_ = 0;
+		return true;
+	}
+
+	bool unstable() const { return unstable_; }
+	unsigned int stableCount() const { return stableCount_; }
+
+private:
+	std::optional<uint64_t> previousScore_;
+	bool unstable_ = false;
+	unsigned int stableCount_ = 0;
+};
+
+class LgAfModel
+{
+public:
+	static constexpr std::size_t kEepromOffset = 0x0a80;
+	static constexpr std::size_t kEepromBlockSize = 6;
+	static constexpr double kLensPositionMin = 0.0;
+	static constexpr double kLensPositionMax = 2.5;
+
+	static std::optional<LgAfModel>
+	fromEeprom(unsigned int cameraId,
+		   const std::array<uint8_t, kEepromBlockSize> &block,
+		   std::string *error)
+	{
+		auto fail = [error](const std::string &message) {
+			if (error)
+				*error = message;
+			return std::optional<LgAfModel>{};
+		};
+
+		if (cameraId != 3)
+			return fail("unsupported LG camera ID " +
+				    std::to_string(cameraId));
+
+		uint16_t storedChecksum = block[4] | block[5] << 8;
+		uint16_t calculatedChecksum = block[0] + block[1] +
+					      block[2] + block[3];
+		if (storedChecksum != calculatedChecksum)
+			return fail("EEPROM AF checksum mismatch");
+
+		int16_t infinityDac = static_cast<int16_t>(block[0] | block[1] << 8);
+		int16_t macroDac = static_cast<int16_t>(block[2] | block[3] << 8);
+		int infinityQ = (infinityDac + 1023) / 2;
+		int macroQ = (macroDac + 1023) / 2;
+		if (infinityQ < 0 || infinityQ > 1023 ||
+		    macroQ < 0 || macroQ > 1023 || macroQ <= infinityQ)
+			return fail("invalid EEPROM AF endpoints");
+
+		/* Camera ID 3 uses the factory type-3 infinity extension. */
+		infinityQ = std::max(0, static_cast<int>(
+			static_cast<float>(infinityQ) -
+			static_cast<float>(macroQ - infinityQ) * 0.1644f));
+
+		LgAfModel model;
+		model.cameraId_ = cameraId;
+		model.checksum_ = storedChecksum;
+		model.rawInfinityDac_ = infinityDac;
+		model.rawMacroDac_ = macroDac;
+		model.infinityPosition_ = 1024 - infinityQ;
+		model.macroPosition_ = 1024 - macroQ;
+		model.nearPosition_ = model.positionForDistance(kReferenceDistanceMm);
+		int farTarget = model.positionForDistance(kFarDistanceMm);
+		int farMargin = static_cast<int>(
+			static_cast<float>(farTarget - model.nearPosition_) * 0.08f);
+		model.farPosition_ = std::min(1023, farTarget + farMargin);
+
+		int span = macroQ - infinityQ;
+		model.coarseStepNormal_ = static_cast<unsigned int>(
+			static_cast<float>(3.0f * kStepFraction) * span);
+		model.fineStepNormal_ = static_cast<unsigned int>(kStepFraction * span);
+		model.coarseStepLowLight_ = static_cast<unsigned int>(
+			static_cast<float>(6.0f * kStepFraction) * span);
+		model.fineStepLowLight_ = static_cast<unsigned int>(
+			static_cast<float>(2.0f * kStepFraction) * span);
+		if (model.infinityPosition_ > 1023 ||
+		    model.macroPosition_ < 0 ||
+		    model.nearPosition_ >= model.farPosition_ ||
+		    !model.coarseStepNormal_ || !model.fineStepNormal_ ||
+		    !model.coarseStepLowLight_ || !model.fineStepLowLight_)
+			return fail("invalid LG camera ID 3 AF model");
+
+		return model;
+	}
+
+	unsigned int cameraId() const { return cameraId_; }
+	uint16_t checksum() const { return checksum_; }
+	int rawInfinityDac() const { return rawInfinityDac_; }
+	int rawMacroDac() const { return rawMacroDac_; }
+	int infinityPosition() const { return infinityPosition_; }
+	int nearPosition() const { return nearPosition_; }
+	int farPosition() const { return farPosition_; }
+	int codeMin() const { return positionToCode(farPosition_); }
+	int codeMax() const { return positionToCode(nearPosition_); }
+	int infinityCode() const { return positionToCode(infinityPosition_); }
+	unsigned int nearStep() const { return 0; }
+	unsigned int farStep() const { return farPosition_ - nearPosition_; }
+	unsigned int stepCount() const { return farStep() + 1; }
+	unsigned int coarseStep(bool lowLight = false) const
+	{
+		return lowLight ? coarseStepLowLight_ : coarseStepNormal_;
+	}
+	unsigned int fineStep(bool lowLight = false) const
+	{
+		return lowLight ? fineStepLowLight_ : fineStepNormal_;
+	}
+
+	double lensPositionFromCode(int code) const
+	{
+		int position = codeToPosition(std::clamp(code, codeMin(), codeMax()));
+		if (position <= nearPosition_)
+			return kLensPositionMax;
+		if (position >= infinityPosition_)
+			return kLensPositionMin;
+
+		double distance = kFocalLengthMm +
+			(kReferenceDistanceMm - kFocalLengthMm) *
+			(infinityPosition_ - nearPosition_) /
+			(infinityPosition_ - position);
+		return std::clamp(1000.0 / distance,
+				  kLensPositionMin, kLensPositionMax);
+	}
+
+	int lensPositionToCode(double position) const
+	{
+		position = std::clamp(position, kLensPositionMin, kLensPositionMax);
+		if (position <= kLensPositionMin)
+			return infinityCode();
+		if (position >= kLensPositionMax)
+			return codeMax();
+
+		double distance = 1000.0 / position;
+		if (distance <= kReferenceDistanceMm)
+			return codeMax();
+
+		return positionToCode(positionForDistance(distance));
+	}
+
+	int afStepToCode(unsigned int step) const
+	{
+		step = std::min(step, farStep());
+		return positionToCode(nearPosition_ + step);
+	}
+
+	unsigned int afCodeToStep(int code) const
+	{
+		int position = codeToPosition(std::clamp(code, codeMin(), codeMax()));
+		return std::clamp(position - nearPosition_, 0,
+				  static_cast<int>(farStep()));
+	}
+
+private:
+	static constexpr double kFocalLengthMm = 5.849999904632568;
+	static constexpr double kReferenceDistanceMm = 400.0;
+	static constexpr double kFarDistanceMm = 10000.0;
+	static constexpr float kStepFraction = 0.029999999329447746f;
+
+	static int codeToPosition(int code)
+	{
+		return 1024 - (code + 1023) / 2;
+	}
+
+	static int positionToCode(int position)
+	{
+		return 2 * (1024 - position) - 1023;
+	}
+
+	int positionForDistance(double distance) const
+	{
+		double ratio = (kReferenceDistanceMm - kFocalLengthMm) /
+			       (distance - kFocalLengthMm);
+		return std::clamp(static_cast<int>(
+			infinityPosition_ -
+			(infinityPosition_ - macroPosition_) * ratio),
+			0, 1023);
+	}
+
+	unsigned int cameraId_ = 0;
+	uint16_t checksum_ = 0;
+	int rawInfinityDac_ = 0;
+	int rawMacroDac_ = 0;
+	int infinityPosition_ = 0;
+	int macroPosition_ = 0;
+	int nearPosition_ = 0;
+	int farPosition_ = 0;
+	unsigned int coarseStepNormal_ = 0;
+	unsigned int fineStepNormal_ = 0;
+	unsigned int coarseStepLowLight_ = 0;
+	unsigned int fineStepLowLight_ = 0;
+};
+
+inline std::optional<double> aeRegionLuma(const uint64_t sums[4],
+					  const uint64_t counts[4], double blackLevel)
+{
+	double values[4];
+	for (unsigned int c = 0; c < 4; c++) {
+		if (!counts[c])
+			return std::nullopt;
+		values[c] = std::max(0.0, static_cast<double>(sums[c]) / counts[c] - blackLevel);
+	}
+
+	return kAeRgbWeights[0] * values[0] +
+	       kAeRgbWeights[1] * (values[2] + values[3]) * 0.5 +
+	       kAeRgbWeights[2] * values[1];
+}
+
+inline double aeTargetForLux(double lux)
+{
+	if (lux <= kAeLuxZones[0].start)
+		return kAeLuxZones[0].target8;
+
+	for (unsigned int i = 0; i + 1 < std::size(kAeLuxZones); i++) {
+		const AeLuxZone &zone = kAeLuxZones[i];
+		const AeLuxZone &next = kAeLuxZones[i + 1];
+		if (lux <= zone.end)
+			return zone.target8;
+		if (lux < next.start) {
+			double t = (lux - zone.end) / (next.start - zone.end);
+			return zone.target8 + t * (next.target8 - zone.target8);
+		}
+	}
+
+	return kAeLuxZones[std::size(kAeLuxZones) - 1].target8;
+}
+
+inline double aeTotalExposure(const AeExposureKnee &knee)
+{
+	return knee.gain * knee.exposureNs;
+}
+
+inline double aeExposureIndex(double total)
+{
+	if (total <= aeTotalExposure(kAeExposureKnees[0]))
+		return kAeExposureKnees[0].index;
+
+	for (unsigned int i = 0; i + 1 < std::size(kAeExposureKnees); i++) {
+		double lower = aeTotalExposure(kAeExposureKnees[i]);
+		double upper = aeTotalExposure(kAeExposureKnees[i + 1]);
+		if (total <= upper) {
+			double t = (std::log2(total) - std::log2(lower)) /
+				   (std::log2(upper) - std::log2(lower));
+			return kAeExposureKnees[i].index + t *
+			       (kAeExposureKnees[i + 1].index -
+				kAeExposureKnees[i].index);
+		}
+	}
+
+	return kAeExposureKnees[std::size(kAeExposureKnees) - 1].index;
+}
+
+inline void aeAllocateExposure(double total, double &gain, double &exposureNs)
+{
+	if (total <= aeTotalExposure(kAeExposureKnees[0])) {
+		gain = kAeExposureKnees[0].gain;
+		exposureNs = kAeExposureKnees[0].exposureNs;
+		return;
+	}
+
+	for (unsigned int i = 0; i + 1 < std::size(kAeExposureKnees); i++) {
+		double lower = aeTotalExposure(kAeExposureKnees[i]);
+		double upper = aeTotalExposure(kAeExposureKnees[i + 1]);
+		if (total <= upper) {
+			double t = (std::log2(total) - std::log2(lower)) /
+				   (std::log2(upper) - std::log2(lower));
+			gain = kAeExposureKnees[i].gain * std::pow(
+			kAeExposureKnees[i + 1].gain / kAeExposureKnees[i].gain, t);
+			exposureNs = total / gain;
+			return;
+		}
+	}
+
+	const AeExposureKnee &last =
+		kAeExposureKnees[std::size(kAeExposureKnees) - 1];
+	gain = last.gain;
+	exposureNs = last.exposureNs;
+}
+
+inline double estimateCct(double rg, double bg)
+{
+	double bestDistance = std::numeric_limits<double>::max();
+	double cct = 4250.0;
+	for (unsigned int i = 0; i + 1 < std::size(kCctReferences); i++) {
+		const auto &lower = kCctReferences[i];
+		const auto &upper = kCctReferences[i + 1];
+		double dx = upper.rg - lower.rg;
+		double dy = upper.bg - lower.bg;
+		double t = std::clamp(((rg - lower.rg) * dx + (bg - lower.bg) * dy) /
+				      (dx * dx + dy * dy), 0.0, 1.0);
+		double ex = rg - (lower.rg + t * dx);
+		double ey = bg - (lower.bg + t * dy);
+		double distance = ex * ex + ey * ey;
+		if (distance < bestDistance) {
+			bestDistance = distance;
+			/* Reciprocal temperature is linear along the illuminant locus. */
+			cct = 1.0 / ((1.0 - t) / lower.cct + t / upper.cct);
+		}
+	}
+	return cct;
+}
+
+inline void interpolateCcm(double cct, int16_t (&coefficients)[9])
+{
+	cct = std::clamp(cct, static_cast<double>(kCcmEntries[0].cct),
+			 static_cast<double>(kCcmEntries[std::size(kCcmEntries) - 1].cct));
+	unsigned int i = 0;
+	while (i + 2 < std::size(kCcmEntries) && cct > kCcmEntries[i + 1].cct)
+		i++;
+	const auto &lower = kCcmEntries[i];
+	const auto &upper = kCcmEntries[i + 1];
+	double t = (cct - lower.cct) / (upper.cct - lower.cct);
+	for (unsigned int j = 0; j < 9; j++)
+		coefficients[j] = std::lround(lower.q7[j] + t * (upper.q7[j] - lower.q7[j]));
+}
+
+} /* namespace libcamera::qcom */
