+template<std::size_t Size>
+int readFile(const std::filesystem::path &path, off_t offset,
+	     std::array<uint8_t, Size> *data)
+{
+	File file(path.string());
+	if (!file.open(File::OpenModeFlag::ReadOnly))
+		return file.error();
+	if (file.seek(offset) != offset)
+		return -EIO;
+
+	ssize_t bytes = file.read(*data);
+	if (bytes < 0)
+		return bytes;
+	return bytes == static_cast<ssize_t>(data->size()) ? 0 : -EIO;
+}
+
+uint32_t readBe32(const std::array<uint8_t, 4> &data)
+{
+	return static_cast<uint32_t>(data[0]) << 24 |
+	       static_cast<uint32_t>(data[1]) << 16 |
+	       static_cast<uint32_t>(data[2]) << 8 |
+	       data[3];
+}
+
+int loadAfModel(const std::string &sensorId, std::optional<LgAfModel> *model,
+		std::string *eepromPath)
+{
+	const std::filesystem::path sensorNode =
+		std::filesystem::path("/sys/firmware/devicetree") /
+		sensorId.substr(sensorId.starts_with('/') ? 1 : 0);
+	std::array<uint8_t, 4> property;
+
+	int ret = readFile(sensorNode / "lg,camera-id", 0, &property);
+	if (ret) {
+		LOG(QcomPipeline, Error)
+			<< "Failed to read LG camera ID from " << sensorNode;
+		return ret;
+	}
+	unsigned int cameraId = readBe32(property);
+
+	ret = readFile(sensorNode / "nvmem", 0, &property);
+	if (ret) {
+		LOG(QcomPipeline, Error)
+			<< "Failed to read NVMEM provider from " << sensorNode;
+		return ret;
+	}
+	uint32_t providerPhandle = readBe32(property);
+
+	std::error_code errorCode;
+	std::filesystem::path provider;
+	for (const auto &entry : std::filesystem::directory_iterator(
+		     "/sys/bus/nvmem/devices", errorCode)) {
+		std::array<uint8_t, 4> phandle;
+		if (!readFile(entry.path() / "of_node/phandle", 0, &phandle) &&
+		    readBe32(phandle) == providerPhandle) {
+			provider = entry.path();
+			break;
+		}
+	}
+	if (errorCode) {
+		LOG(QcomPipeline, Error)
+			<< "Failed to enumerate NVMEM devices: " << errorCode.message();
+		return -errorCode.value();
+	}
+	if (provider.empty()) {
+		LOG(QcomPipeline, Error)
+			<< "NVMEM provider " << providerPhandle << " not found";
+		return -ENODEV;
+	}
+
+	std::array<uint8_t, LgAfModel::kEepromBlockSize> block;
+	std::filesystem::path nvmem = provider / "nvmem";
+	ret = readFile(nvmem, LgAfModel::kEepromOffset, &block);
+	if (ret) {
+		LOG(QcomPipeline, Error)
+			<< "Failed to read S5K3M5 AF calibration from " << nvmem;
+		return ret;
+	}
+
+	std::string reason;
+	*model = LgAfModel::fromEeprom(cameraId, block, &reason);
+	if (!*model) {
+		LOG(QcomPipeline, Error) << "Invalid S5K3M5 AF calibration: " << reason;
+		return -EINVAL;
+	}
+
+	*eepromPath = nvmem.string();
+	return 0;
+}
