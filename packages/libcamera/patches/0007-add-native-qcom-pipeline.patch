+int QcomCameraData::init(MediaEntity *sensorEntity)
+{
+	int ret;
+
+	sensor_ = CameraSensorFactoryBase::create(sensorEntity);
+	if (!sensor_)
+		return -ENODEV;
+
+	std::string eepromPath;
+	ret = loadAfModel(sensor_->id(), &afModel_, &eepromPath);
+	if (ret)
+		return ret;
+	afPosition_ = afModel_->codeMin();
+	afStep_ = afModel_->farStep();
+	afOriginalPosition_ = afPosition_;
+	afBestStep_ = afStep_;
+	afFineEndStep_ = afModel_->nearStep();
+	LOG(QcomPipeline, Info)
+		<< "Loaded LG camera ID " << afModel_->cameraId()
+		<< " AF calibration from " << eepromPath
+		<< ": infinity " << afModel_->rawInfinityDac()
+		<< ", macro " << afModel_->rawMacroDac()
+		<< ", checksum " << utils::hex(afModel_->checksum());
+
+	pixEntity_ = media_->getEntityByName("msm_vfe0_pix");
+	if (!pixEntity_) {
+		LOG(QcomPipeline, Error) << "VFE PIX entity not found";
+		return -ENODEV;
+	}
+
+	ret = findPath(sensorEntity, pixEntity_);
+	if (ret < 0) {
+		LOG(QcomPipeline, Error) << "Failed to find sensor to VFE PIX path";
+		return ret;
+	}
+
+	ret = disableLinks();
+	if (ret < 0)
+		return ret;
+
+	MediaEntity *videoEntity = nullptr;
+	for (const MediaPad *pad : pixEntity_->pads()) {
+		if (!(pad->flags() & MEDIA_PAD_FL_SOURCE))
+			continue;
+
+		for (MediaLink *link : pad->links()) {
+			MediaEntity *next = link->sink()->entity();
+			if (next->function() == MEDIA_ENT_F_IO_V4L) {
+				videoEntity = next;
+				break;
+			}
+		}
+	}
+
+	if (!videoEntity) {
+		LOG(QcomPipeline, Error) << "VFE PIX video node not found";
+		return -ENODEV;
+	}
+
+	pix_ = std::make_unique<V4L2Subdevice>(pixEntity_);
+	ret = pix_->open();
+	if (ret < 0)
+		return ret;
+
+	video_ = V4L2VideoDevice::fromEntityName(media_.get(), videoEntity->name());
+	if (!video_) {
+		LOG(QcomPipeline, Error) << "Failed to open VFE PIX video node";
+		return -ENODEV;
+	}
+
+	ret = video_->open();
+	if (ret < 0)
+		return ret;
+
+	video_->bufferReady.connect(this, &QcomCameraData::imageBufferReady);
+
+	const CameraSensorProperties::SensorDelays &delays = sensor_->sensorDelays();
+	std::unordered_map<uint32_t, DelayedControls::ControlParams> params = {
+		{ V4L2_CID_ANALOGUE_GAIN, { delays.gainDelay, false } },
+		{ V4L2_CID_EXPOSURE, { delays.exposureDelay, false } },
+	};
+	delayedCtrls_ = std::make_unique<DelayedControls>(sensor_->device(), params);
+	pix_->frameStart.connect(this, &QcomCameraData::frameStart);
+
+	ret = refreshSensorInfo();
+	if (ret < 0)
+		return ret;
+
+	awb_ = std::vector<uint32_t>(QCOM_CAMSS_AWB_BG_REGIONS *
+				     QCOM_CAMSS_AWB_BG_REGION_SIZE / sizeof(uint32_t));
+	hist_ = std::vector<uint32_t>(QCOM_CAMSS_BHIST_BINS);
+	bf_ = std::vector<uint64_t>(QCOM_CAMSS_BF_SIZE / sizeof(uint64_t));
+
+	lens_ = sensor_->focusLens();
+	afEnabled_ = lens_ != nullptr;
+	if (lens_) {
+		int32_t position = 0;
+		if (!lens_->getFocusPosition(&position)) {
+			afPosition_ = std::clamp(position, afModel_->codeMin(),
+						 afModel_->codeMax());
+			afStep_ = afModel_->afCodeToStep(afPosition_);
+			afOriginalPosition_ = afPosition_;
+			afBestStep_ = afStep_;
+		}
+	}
+
+	ControlInfoMap::Map ctrls;
+	ctrls[&controls::AeEnable] = ControlInfo(false, true, true);
+	ctrls[&controls::ExposureTime] = ControlInfo(
+		static_cast<int32_t>(exposureMin_ * lineDurationNs_ / 1000.0),
+		static_cast<int32_t>(exposureMax_ * lineDurationNs_ / 1000.0),
+		static_cast<int32_t>(aeExposure_ * lineDurationNs_ / 1000.0));
+	ctrls[&controls::AnalogueGain] = ControlInfo(
+		static_cast<float>(gainMin_), static_cast<float>(gainMax_),
+		static_cast<float>(aeGain_));
+	ctrls[&controls::AwbEnable] = ControlInfo(false, true, true);
+	ctrls[&controls::ColourGains] = ControlInfo(0.0f, 8.0f, 1.0f);
+	ctrls[&controls::AfMode] = ControlInfo(
+		{ { ControlValue(controls::AfModeManual),
+		    ControlValue(controls::AfModeAuto),
+		    ControlValue(controls::AfModeContinuous) } },
+		ControlValue(controls::AfModeContinuous));
+	ctrls[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+	if (lens_)
+		ctrls[&controls::LensPosition] = ControlInfo(
+			static_cast<float>(LgAfModel::kLensPositionMin),
+			static_cast<float>(LgAfModel::kLensPositionMax),
+			static_cast<float>(lensPosition()));
+	ctrls[&controls::AfPause] = ControlInfo(
+		{ { ControlValue(controls::AfPauseImmediate),
+		    ControlValue(controls::AfPauseDeferred),
+		    ControlValue(controls::AfPauseResume) } },
+		ControlValue(controls::AfPauseResume));
+
+	controlInfo_ = ControlInfoMap(std::move(ctrls), controls::controls);
+	properties_ = sensor_->properties();
+
+	return 0;
+}
+
+int QcomCameraData::refreshSensorInfo()
+{
+	IPACameraSensorInfo info;
+	int ret = sensor_->sensorInfo(&info);
+	if (ret)
+		return ret;
+
+	lineDurationNs_ = 1e9 * info.minLineLength / info.pixelRate;
+	frameDurationNs_ = std::llround(lineDurationNs_ * info.minFrameLength);
+	const ControlInfoMap &controls = sensor_->controls();
+	exposureMin_ = controls.at(V4L2_CID_EXPOSURE).min().get<int32_t>();
+	exposureMax_ = controls.at(V4L2_CID_EXPOSURE).max().get<int32_t>();
+	gainMin_ = controls.at(V4L2_CID_ANALOGUE_GAIN).min().get<int32_t>() / kGainCodeScale;
+	gainMax_ = controls.at(V4L2_CID_ANALOGUE_GAIN).max().get<int32_t>() / kGainCodeScale;
+
+	const uint32_t ids[] = { V4L2_CID_EXPOSURE, V4L2_CID_ANALOGUE_GAIN };
+	ControlList initial = sensor_->getControls(ids);
+	if (initial.empty())
+		return -EIO;
+	aeExposure_ = initial.get(V4L2_CID_EXPOSURE).get<int32_t>();
+	aeGain_ = initial.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>() / kGainCodeScale;
+
+	if (!controlInfo_.empty()) {
+		ControlInfoMap::Map map;
+		for (const auto &[id, range] : controlInfo_)
+			map.emplace(id, range);
+		map[&libcamera::controls::ExposureTime] = ControlInfo(
+			static_cast<int32_t>(exposureMin_ * lineDurationNs_ / 1000),
+			static_cast<int32_t>(exposureMax_ * lineDurationNs_ / 1000),
+			static_cast<int32_t>(aeExposure_ * lineDurationNs_ / 1000));
+		controlInfo_ = ControlInfoMap(std::move(map), libcamera::controls::controls);
+	}
+	return 0;
+}
+
+void QcomCameraData::frameStart(uint32_t sequence)
+{
+	delayedCtrls_->applyControls(sequence);
+	if (nextIfe_ && sequence >= nextIfe_->first) {
+		appliedIfe_ = nextIfe_->second;
+		nextIfe_.reset();
+	}
+	frameStates_[sequence] = { appliedIfe_, static_cast<float>(lensPosition()),
+				   afMode_, afState_, afPauseState_ };
+	while (frameStates_.size() > 64)
+		frameStates_.erase(frameStates_.begin());
+	if (ifePending_) {
+		int ret = applyIfe(sequence + 1);
+		if (ret)
+			LOG(QcomPipeline, Error) << "IFE update for frame " << sequence + 1
+						 << " failed: " << ret;
+	}
+}
+
+int QcomCameraData::setFormats(const Size &size)
+{
+	const Size inputSize = size == kFullSize ? kFullSize : kNativeSize;
+	V4L2SubdeviceFormat format;
+	format.code = MEDIA_BUS_FMT_SGBRG10_1X10;
+	format.size = inputSize;
+
+	int ret = sensor_->setFormat(&format);
+	if (ret < 0)
+		return ret;
+
+	for (unsigned int i = 0; i < links_.size(); i++) {
+		MediaLink *link = links_[i];
+		MediaPad *sink = link->sink();
+
+		if (sink->entity()->function() != MEDIA_ENT_F_IO_V4L) {
+			V4L2Subdevice subdev(sink->entity());
+			ret = subdev.open();
+			if (ret < 0)
+				return ret;
+
+			V4L2SubdeviceFormat sinkFormat = format;
+			ret = subdev.setFormat(sink->index(), &sinkFormat);
+			if (ret < 0)
+				return ret;
+
+			if (sinkFormat.code != format.code ||
+			    sinkFormat.size != format.size) {
+				LOG(QcomPipeline, Error)
+					<< "Format mismatch at " << sink->entity()->name();
+				return -EINVAL;
+			}
+
+			if (sink->entity() == pixEntity_) {
+				Rectangle compose{ 0, 0, size };
+				ret = subdev.setSelection(sink->index(),
+							  V4L2_SEL_TGT_COMPOSE,
+							  &compose);
+				if (ret < 0)
+					return ret;
+
+				V4L2SubdeviceFormat sourceFormat = format;
+				sourceFormat.code = MEDIA_BUS_FMT_YUYV8_1_5X8;
+				sourceFormat.size = size;
+				ret = subdev.setFormat(1, &sourceFormat);
+				if (ret < 0)
+					return ret;
+				format = sourceFormat;
+			}
+		}
+
+		if (i + 1 < links_.size()) {
+			MediaPad *source = links_[i + 1]->source();
+			V4L2Subdevice subdev(source->entity());
+			ret = subdev.open();
+			if (ret < 0)
+				return ret;
+
+			V4L2SubdeviceFormat sourceFormat = format;
+			ret = subdev.setFormat(source->index(), &sourceFormat);
+			if (ret < 0)
+				return ret;
+			format = sourceFormat;
+		}
+	}
+
+	V4L2DeviceFormat videoFormat;
+	videoFormat.fourcc = video_->toV4L2PixelFormat(formats::NV12);
+	videoFormat.size = size;
+	videoFormat.colorSpace = ColorSpace::Sycc;
+
+	ret = video_->setFormat(&videoFormat);
+	if (ret < 0)
+		return ret;
+
+	if (videoFormat.fourcc != video_->toV4L2PixelFormat(formats::NV12) ||
+	    videoFormat.size != size)
+		return -EINVAL;
+
+	return refreshSensorInfo();
+}
+
+void QcomCameraData::pushSensorControls()
+{
+	ControlList ctrls(sensor_->controls());
+	ctrls.set(V4L2_CID_EXPOSURE, static_cast<int32_t>(std::lround(aeExposure_)));
+	ctrls.set(V4L2_CID_ANALOGUE_GAIN,
+		  static_cast<int32_t>(aeGain_ * kGainCodeScale));
+	delayedCtrls_->push(ctrls);
+}
+
+int QcomCameraData::setIfeWb(double gainR, double gainB)
+{
+	awbGainR_ = gainR;
+	awbGainB_ = gainB;
+	ifePending_ = true;
+	return 0;
+}
+
+int QcomCameraData::applyIfe(uint32_t sequence)
+{
+	struct qcom_camss_ife_config config = {};
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
+
+	config.version = QCOM_CAMSS_IFE_CONFIG_VERSION;
+	config.frame_sequence = sequence;
+	config.flags = QCOM_CAMSS_IFE_CONFIG_WHITE_BALANCE |
+		       QCOM_CAMSS_IFE_CONFIG_CCM;
+	config.wb_gain_q7[0] = std::clamp<int>(std::lround(awbGainR_ * 128), 0, 0xfff);
+	config.wb_gain_q7[1] = 128;
+	config.wb_gain_q7[2] = 128;
+	config.wb_gain_q7[3] = std::clamp<int>(std::lround(awbGainB_ * 128), 0, 0xfff);
+	memcpy(config.ccm_q7, ccmQ7_, sizeof(config.ccm_q7));
+
+	control.id = V4L2_CID_QCOM_CAMSS_IFE_CONFIG;
+	control.size = sizeof(config);
+	control.ptr = &config;
+
+	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.count = 1;
+	controls.request_fd = -1;
+	controls.controls = &control;
+
+	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	if (ret)
+		return ret;
+	IfeState state{ config.wb_gain_q7[0] / 128.0,
+			config.wb_gain_q7[3] / 128.0, colourTemperature_ };
+	if (streaming_)
+		nextIfe_ = std::make_pair(sequence, state);
+	else
+		appliedIfe_ = state;
+	ifePending_ = false;
+	LOG(QcomPipeline, Debug) << "IFE frame " << sequence << " gains "
+				 << state.red << " " << state.blue;
+	return 0;
+}
+
+int QcomCameraData::setLensPosition(int position)
+{
+	if (!lens_)
+		return -ENODEV;
+
+	position = std::clamp(position, afModel_->codeMin(), afModel_->codeMax());
+	int ret = lens_->setFocusPosition(position);
+	if (!ret) {
+		afPosition_ = position;
+		lensSetTimestamp_ = monotonicNs();
+		LOG(QcomPipeline, Debug) << "AF lens code " << position
+					 << " step " << afModel_->afCodeToStep(position);
+	}
+	return ret;
+}
+
+void QcomCameraData::startAfMove(int step)
+{
+	int current = afModel_->afCodeToStep(afPosition_);
+	step = std::clamp<int>(step, afModel_->nearStep(), afModel_->farStep());
+	afMovePlan_ = lgAfMovePlan(current, step);
+	afMoveIndex_ = 1;
+	setLensPosition(afModel_->afStepToCode(afMovePlan_.targets[0]));
+}
+
+bool QcomCameraData::advanceAfMove(uint64_t timestamp)
+{
+	if (afMoveIndex_ >= afMovePlan_.count)
+		return false;
+
+	setLensPosition(afModel_->afStepToCode(
+		afMovePlan_.targets[afMoveIndex_++]));
+	afNextEval_ = timestamp + kAfSettleNs;
+	return true;
+}
+
+void QcomCameraData::cancelAfMove()
+{
+	afMovePlan_.count = 0;
+	afMoveIndex_ = 0;
+}
+
+double QcomCameraData::lensPosition() const
+{
+	return afModel_->lensPositionFromCode(afPosition_);
+}
+
+int QcomCameraData::lensPositionToCode(double position) const
+{
+	return afModel_->lensPositionToCode(position);
+}
+
+uint64_t QcomCameraData::lensReadyTimestamp() const
+{
+	/* Exclude exposures and readout that overlap the lens movement. */
+	uint64_t exposureNs = std::llround(exposureMax_ * lineDurationNs_);
+	uint64_t settleNs = std::max(kAfSettleNs,
+				     kAfSettleFrames * frameDurationNs_);
+	return lensSetTimestamp_ + settleNs + frameDurationNs_ + exposureNs;
+}
+
+void QcomCameraData::fetchStats()
+{
+	struct qcom_camss_stats request = {};
+	request.version = QCOM_CAMSS_STATS_VERSION;
+	request.awb_bg = reinterpret_cast<uintptr_t>(awb_.data());
+	request.bhist = reinterpret_cast<uintptr_t>(hist_.data());
+	request.bf = reinterpret_cast<uintptr_t>(bf_.data());
+
+	if (video_->ioctl(VIDIOC_QCOM_CAMSS_GET_STATS, &request) < 0)
+		return;
+
+	if (request.sequence == lastStatsSequence_)
+		return;
+
+	lastStatsSequence_ = request.sequence;
+	statsTimestamp_ = request.timestamp;
+	aecLuma_ = measuredLuma();
+
+	if (aeEnabled_ && aecLuma_)
+		updateAe(qcom::inputSequence(request.sequence), *aecLuma_);
+	if (awbEnabled_)
+		updateAwb();
+	if (afEnabled_)
+		updateAf(request.timestamp);
+}
+
+std::optional<double> QcomCameraData::meteringLuma(bool applyWeights) const
+{
+	double sum = 0.0;
+	double weights = 0.0;
+
+	for (unsigned int y = 0; y < 16; y++) {
+		double rowStart = y * 1.5;
+		double rowEnd = (y + 1) * 1.5;
+
+		for (unsigned int row = static_cast<unsigned int>(rowStart);
+		     row < std::min<unsigned int>(static_cast<unsigned int>(rowEnd) + 1,
+						  QCOM_CAMSS_AWB_BG_V_NUM); row++) {
+			double overlap = std::min(rowEnd, row + 1.0) -
+					 std::max(rowStart, static_cast<double>(row));
+			if (overlap <= 0.0)
+				continue;
+
+			for (unsigned int x = 0; x < 16; x++) {
+				uint64_t sums[4] = {};
+				uint64_t counts[4] = {};
+
+				for (unsigned int column = 2 * x;
+				     column < 2 * x + 2; column++) {
+					unsigned int index = row * QCOM_CAMSS_AWB_BG_H_NUM + column;
+					const uint32_t *region = &awb_[index *
+						(QCOM_CAMSS_AWB_BG_REGION_SIZE / sizeof(uint32_t))];
+
+					for (unsigned int c = 0; c < 4; c++) {
+						sums[c] += region[c] & 0x3fffffff;
+						counts[c] += (region[4 + c / 2] >>
+							      (16 * (c % 2))) & 0xffff;
+					}
+				}
+
+				auto luma = aeRegionLuma(sums, counts, kBlackLevel);
+				if (!luma)
+					continue;
+				double weight = overlap * (applyWeights ? kAeMetering[y][x] : 1.0);
+				sum += *luma * weight;
+				weights += weight;
+			}
+		}
+	}
+
+	if (weights > 0.0)
+		return sum / weights;
+
+	return std::nullopt;
+}
+
+std::optional<double> QcomCameraData::measuredLuma() const
+{
+	auto metered = meteringLuma(true);
+	auto global = meteringLuma(false);
+	if (!metered || !global)
+		return std::nullopt;
+
+	uint64_t histWeighted = 0;
+	uint64_t histTotal = 0;
+	for (unsigned int i = 0; i < hist_.size(); i++) {
+		histWeighted += static_cast<uint64_t>(i) * hist_[i];
+		histTotal += hist_[i];
+	}
+	if (!histTotal)
+		return std::nullopt;
+
+	/* Use BG only for spatial weighting; BHIST supplies the 10-bit level. */
+	double histMean = static_cast<double>(histWeighted) / histTotal;
+	return *global > 0.0 ? histMean * *metered / *global : histMean;
+}
+
+void QcomCameraData::updateAe(uint32_t sequence, double luma)
+{
+	ControlList applied = delayedCtrls_->get(sequence);
+	double exposure = applied.get(V4L2_CID_EXPOSURE).get<int32_t>() *
+			  lineDurationNs_;
+	double gain = applied.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>() / kGainCodeScale;
+	double total = exposure * gain;
+	/* Exposure index approximates lux index until luma normalization is calibrated. */
+	double index = aeExposureIndex(total);
+	luxIndex_ = luxIndex_ ? *luxIndex_ * kAeLuxFilterFactor +
+			       index * (1.0 - kAeLuxFilterFactor) : index;
+	double target = aeTargetForLux(*luxIndex_) * kAeTargetScale;
+
+	if (std::abs(luma - target) <= kAeTolerance)
+		return;
+
+	double ratio = target / std::max(luma, 1.0);
+	double corrected = total * std::pow(ratio, kAeAggressiveness);
+	double allocatedGain, allocatedExposure;
+	aeAllocateExposure(corrected, allocatedGain, allocatedExposure);
+
+	double exposureMinNs = exposureMin_ * lineDurationNs_;
+	double exposureMaxNs = exposureMax_ * lineDurationNs_;
+	allocatedGain = std::clamp(allocatedGain, gainMin_, gainMax_);
+	allocatedExposure = std::clamp(corrected / allocatedGain,
+				       exposureMinNs, exposureMaxNs);
+	allocatedGain = std::clamp(corrected / allocatedExposure,
+				   gainMin_, gainMax_);
+
+	aeExposure_ = allocatedExposure / lineDurationNs_;
+	aeGain_ = allocatedGain;
+	pushSensorControls();
+
+	LOG(QcomPipeline, Debug) << "AE luma " << luma << " target " << target
+				 << " index " << *luxIndex_ << " exposure "
+				 << aeExposure_ << " gain " << aeGain_;
+}
+
+void QcomCameraData::updateCcm(double r, double g, double b)
+{
+	double cct = qcom::estimateCct(r / g, b / g);
+	colourTemperature_ = colourTemperature_ * 0.8 + cct * 0.2;
+	qcom::interpolateCcm(colourTemperature_, ccmQ7_);
+
+	LOG(QcomPipeline, Debug) << "AWB CCT " << colourTemperature_
+				 << " CCM " << ccmQ7_[0] << " " << ccmQ7_[4]
+				 << " " << ccmQ7_[8];
+}
+
+void QcomCameraData::updateAwb()
+{
+	if (++awbCounter_ % 4)
+		return;
+
+	uint64_t sumR = 0, sumB = 0, sumGr = 0, sumGb = 0;
+	uint64_t count = 0;
+
+	for (unsigned int y = 0; y < QCOM_CAMSS_AWB_BG_V_NUM; y++) {
+		for (unsigned int x = 0; x < QCOM_CAMSS_AWB_BG_H_NUM; x++) {
+			unsigned int i = y * QCOM_CAMSS_AWB_BG_H_NUM + x;
+			const uint32_t *region = &awb_[i *
+				(QCOM_CAMSS_AWB_BG_REGION_SIZE / sizeof(uint32_t))];
+			uint32_t samples = region[4] & 0xffff;
+			uint32_t satR = region[10] & 0xffff;
+			uint32_t satB = region[10] >> 16;
+			uint32_t satG = (region[11] & 0xffff) + (region[11] >> 16);
+			unsigned int weight = x >= 8 && x < 24 && y >= 6 && y < 18
+						? 4 : 1;
+
+			if (!samples || satR > samples || satB > samples ||
+			    satG > 2 * samples)
+				continue;
+			if (satR + satB + satG > samples / 2)
+				continue;
+
+			sumR += static_cast<uint64_t>(region[0]) * weight;
+			sumB += static_cast<uint64_t>(region[1]) * weight;
+			sumGr += static_cast<uint64_t>(region[2]) * weight;
+			sumGb += static_cast<uint64_t>(region[3]) * weight;
+			count += static_cast<uint64_t>(samples) * weight;
+		}
+	}
+
+	if (!count || !sumR || !sumB)
+		return;
+
+	double r = static_cast<double>(sumR) / count - kBlackLevel;
+	double b = static_cast<double>(sumB) / count - kBlackLevel;
+	double g = static_cast<double>(sumGr + sumGb) / (2 * count) - kBlackLevel;
+
+	if (r <= 4.0 || b <= 4.0 || g <= 4.0)
+		return;
+
+	double gainR = std::clamp(g / r, 0.25, 8.0);
+	double gainB = std::clamp(g / b, 0.25, 8.0);
+
+	awbGainR_ = awbGainR_ * 0.8 + gainR * 0.2;
+	awbGainB_ = awbGainB_ * 0.8 + gainB * 0.2;
+	updateCcm(r, g, b);
+	setIfeWb(awbGainR_, awbGainB_);
+
+	LOG(QcomPipeline, Debug) << "AWB R " << r << " G " << g << " B " << b
+				 << " gains " << awbGainR_ << " " << awbGainB_;
+}
+
+double QcomCameraData::focusScore() const
+{
+	/* Keep background edges outside the central focus target out of the score. */
+	const uint64_t *roi = &bf_[1 + (QCOM_CAMSS_BF_ROIS / 2) * 4];
+
+	return (roi[1] & 0xffffffffffULL) + (roi[3] & 0xffffffffffULL);
+}
+
+void QcomCameraData::setAfStage(AfStage stage)
+{
+	afStage_ = stage;
+}
+
+void QcomCameraData::startAfScan(uint64_t timestamp)
+{
+	if (!afEnabled_)
+		return;
+
+	cancelAfMove();
+	afOriginalPosition_ = afPosition_;
+	afBestStep_ = afModel_->afCodeToStep(afPosition_);
+	afBestScore_ = -1.0;
+	afMinScore_ = std::numeric_limits<double>::max();
+	afCoarseStop_.reset();
+	afSceneChange_.reset();
+	afNextEval_ = timestamp ? timestamp + kAfWarmupNs : 0;
+	afState_ = controls::AfStateScanning;
+	setAfStage(AfStage::Warmup);
+	LOG(QcomPipeline, Debug) << "AF scan started at code " << afOriginalPosition_;
+}
+
+void QcomCameraData::completeAfScan(bool success)
+{
+	if (success) {
+		afStep_ = afBestStep_;
+		setAfStage(AfStage::Idle);
+		afState_ = controls::AfStateFocused;
+		LOG(QcomPipeline, Info) << "AF focused at step " << afBestStep_
+					<< " code " << afModel_->afStepToCode(afBestStep_);
+	} else {
+		setAfStage(AfStage::Restore);
+		afState_ = controls::AfStateFailed;
+		afStep_ = afModel_->afCodeToStep(afOriginalPosition_);
+		startAfMove(afStep_);
+		LOG(QcomPipeline, Info) << "AF scan failed";
+	}
+
+	if (success && afDeferredPause_) {
+		afPaused_ = true;
+		afDeferredPause_ = false;
+		afPauseState_ = controls::AfPauseStatePaused;
+	}
+}
+
+void QcomCameraData::updateAf(uint64_t timestamp)
+{
+	if (!afEnabled_)
+		return;
+
+	if (afMode_ != controls::AfModeContinuous &&
+	    afMode_ != controls::AfModeAuto) {
+		setAfStage(AfStage::Idle);
+		return;
+	}
+
+	if (afPaused_) {
+		if (afStage_ == AfStage::Warmup || afStage_ == AfStage::Coarse ||
+		    afStage_ == AfStage::Fine || afStage_ == AfStage::Confirm ||
+		    afStage_ == AfStage::Restore)
+			return;
+	}
+
+	if (afStage_ == AfStage::Idle) {
+		if (afMode_ == controls::AfModeContinuous && !afPaused_) {
+			if (afSceneChange_.update(focusScore())) {
+				LOG(QcomPipeline, Debug)
+					<< "AF scene stabilized after focus change";
+				startAfScan(timestamp);
+			}
+		}
+		return;
+	}
+
+	if (!afNextEval_) {
+		afNextEval_ = timestamp + kAfWarmupNs;
+		return;
+	}
+
+	if (timestamp < std::max(afNextEval_, lensReadyTimestamp()))
+		return;
+	if (advanceAfMove(timestamp))
+		return;
+
+	double score = focusScore();
+
+	if (afStage_ == AfStage::Warmup) {
+		afLowLight_ = aecLuma_ && lgAfLowLight(*aecLuma_);
+		LOG(QcomPipeline, Debug) << "AF search luma "
+					 << aecLuma_.value_or(0.0)
+					 << " low light " << afLowLight_;
+		afStep_ = afModel_->farStep();
+		startAfMove(afStep_);
+		afNextEval_ = timestamp + kAfSettleNs;
+		setAfStage(AfStage::Coarse);
+		return;
+	}
+
+	if (afStage_ == AfStage::Coarse || afStage_ == AfStage::Fine) {
+		afMinScore_ = std::min(afMinScore_, score);
+		if (score > afBestScore_) {
+			afBestScore_ = score;
+			afBestStep_ = afStep_;
+		}
+	}
+
+	if (afStage_ == AfStage::Coarse) {
+		unsigned int step = afModel_->coarseStep(afLowLight_);
+		bool slopeStopped = afCoarseStop_.update(score, afLowLight_);
+		if (slopeStopped)
+			LOG(QcomPipeline, Debug)
+				<< "AF coarse search stopped after "
+				<< afCoarseStop_.downCount() << " down and "
+				<< afCoarseStop_.upCount()
+				<< " up samples, focus range "
+				<< afCoarseStop_.focusRange() << ", rise "
+				<< afCoarseStop_.maximumRise();
+		if (slopeStopped ||
+		    afStep_ == static_cast<int>(afModel_->nearStep())) {
+			int range = afModel_->coarseStep(afLowLight_);
+			int start = std::max<int>(afModel_->nearStep(), afBestStep_ - range);
+			afFineEndStep_ = std::min<int>(afModel_->farStep(), afBestStep_ + range);
+			afStep_ = start;
+			startAfMove(afStep_);
+			afNextEval_ = timestamp + kAfSettleNs;
+			setAfStage(AfStage::Fine);
+		} else {
+			afStep_ = std::max<int>(afModel_->nearStep(),
+						 afStep_ - static_cast<int>(step));
+			startAfMove(afStep_);
+			afNextEval_ = timestamp + kAfSettleNs;
+		}
+		return;
+	}
+
+	if (afStage_ == AfStage::Fine) {
+		if (afStep_ >= afFineEndStep_) {
+			afStep_ = afBestStep_;
+			startAfMove(afBestStep_);
+			afNextEval_ = timestamp + kAfSettleNs;
+			setAfStage(AfStage::Confirm);
+		} else {
+			unsigned int step = afModel_->fineStep(afLowLight_);
+			afStep_ = std::min<int>(afFineEndStep_, afStep_ + step);
+			startAfMove(afStep_);
+			afNextEval_ = timestamp + kAfSettleNs;
+		}
+		return;
+	}
+
+	if (afStage_ == AfStage::Confirm) {
+		completeAfScan(afBestScore_ > afMinScore_ * 1.10 &&
+			       score > 0.0 && score >= afBestScore_ * 0.70);
+		return;
+	}
+
+	if (afStage_ == AfStage::Restore) {
+		afSceneChange_.reset();
+		setAfStage(AfStage::Idle);
+		if (afDeferredPause_) {
+			afPaused_ = true;
+			afDeferredPause_ = false;
+			afPauseState_ = controls::AfPauseStatePaused;
+		}
+	}
+}
+
+int QcomCameraData::processControls(const ControlList &controls)
+{
+	bool sensorUpdate = false;
+
+	if (controls.contains(controls::AeEnable.id())) {
+		aeEnabled_ = *controls.get(controls::AeEnable);
+		if (!aeEnabled_) {
+			if (controls.contains(controls::ExposureTime.id())) {
+				int32_t us = *controls.get(controls::ExposureTime);
+				aeExposure_ = std::clamp(us * 1000.0 / lineDurationNs_,
+							 static_cast<double>(exposureMin_),
+							 static_cast<double>(exposureMax_));
+			}
+			if (controls.contains(controls::AnalogueGain.id()))
+				aeGain_ = std::clamp(static_cast<double>(*controls.get(controls::AnalogueGain)),
+						     static_cast<double>(gainMin_),
+						     static_cast<double>(gainMax_));
+			sensorUpdate = true;
+		}
+	} else if (!aeEnabled_) {
+		if (controls.contains(controls::ExposureTime.id())) {
+			int32_t us = *controls.get(controls::ExposureTime);
+			aeExposure_ = std::clamp(us * 1000.0 / lineDurationNs_,
+						 static_cast<double>(exposureMin_),
+						 static_cast<double>(exposureMax_));
+			sensorUpdate = true;
+		}
+		if (controls.contains(controls::AnalogueGain.id())) {
+			aeGain_ = std::clamp(static_cast<double>(*controls.get(controls::AnalogueGain)),
+					     static_cast<double>(gainMin_),
+					     static_cast<double>(gainMax_));
+			sensorUpdate = true;
+		}
+	}
+
+	if (controls.contains(controls::AwbEnable.id())) {
+		awbEnabled_ = *controls.get(controls::AwbEnable);
+		if (!awbEnabled_ && controls.contains(controls::ColourGains.id())) {
+			const auto gains = *controls.get(controls::ColourGains);
+			awbGainR_ = std::clamp(static_cast<double>(gains[0]), 0.25, 8.0);
+			awbGainB_ = std::clamp(static_cast<double>(gains[1]), 0.25, 8.0);
+			setIfeWb(awbGainR_, awbGainB_);
+		}
+	} else if (!awbEnabled_ && controls.contains(controls::ColourGains.id())) {
+		const auto gains = *controls.get(controls::ColourGains);
+		awbGainR_ = std::clamp(static_cast<double>(gains[0]), 0.25, 8.0);
+		awbGainB_ = std::clamp(static_cast<double>(gains[1]), 0.25, 8.0);
+		setIfeWb(awbGainR_, awbGainB_);
+	}
+
+	if (controls.contains(controls::AfMode.id())) {
+		int mode = *controls.get(controls::AfMode);
+		if (mode != afMode_) {
+			cancelAfMove();
+			afSceneChange_.reset();
+			afMode_ = mode;
+			afPaused_ = false;
+			afDeferredPause_ = false;
+			afPauseState_ = controls::AfPauseStateRunning;
+			afState_ = controls::AfStateIdle;
+			setAfStage(AfStage::Idle);
+			if (afMode_ == controls::AfModeContinuous)
+				startAfScan(statsTimestamp_);
+		}
+	}
+
+	if (afMode_ == controls::AfModeManual && lens_ &&
+	    controls.contains(controls::LensPosition.id())) {
+		cancelAfMove();
+		double position = *controls.get(controls::LensPosition);
+		int ret = setLensPosition(lensPositionToCode(position));
+		if (ret)
+			return ret;
+	}
+
+	if (afMode_ == controls::AfModeAuto &&
+	    controls.contains(controls::AfTrigger.id())) {
+		int trigger = *controls.get(controls::AfTrigger);
+		if (trigger == controls::AfTriggerStart &&
+		    afStage_ == AfStage::Idle)
+			startAfScan(statsTimestamp_);
+		else if (trigger == controls::AfTriggerCancel) {
+			afState_ = controls::AfStateIdle;
+			setAfStage(AfStage::Restore);
+			afStep_ = afModel_->afCodeToStep(afOriginalPosition_);
+			startAfMove(afStep_);
+		}
+	}
+
+	if (afMode_ == controls::AfModeContinuous &&
+	    controls.contains(controls::AfPause.id())) {
+		int pause = *controls.get(controls::AfPause);
+		if (pause == controls::AfPauseResume) {
+			afPaused_ = false;
+			afDeferredPause_ = false;
+			afPauseState_ = controls::AfPauseStateRunning;
+		} else if (afStage_ == AfStage::Idle ||
+			   pause == controls::AfPauseImmediate) {
+			afPaused_ = true;
+			afDeferredPause_ = false;
+			afPauseState_ = controls::AfPauseStatePaused;
+		} else {
+			afDeferredPause_ = true;
+			afPauseState_ = controls::AfPauseStatePausing;
+		}
+	}
+
+	if (sensorUpdate)
+		pushSensorControls();
+	return 0;
+}
+
+void QcomCameraData::updateMetadata(Request *request, uint32_t sequence)
+{
+	ControlList &metadata = request->_d()->metadata();
+	ControlList applied = delayedCtrls_->get(sequence);
+
+	if (applied.contains(V4L2_CID_EXPOSURE)) {
+		int32_t lines = applied.get(V4L2_CID_EXPOSURE).get<int32_t>();
+		int32_t us = static_cast<int32_t>(lines * lineDurationNs_ / 1000.0);
+		metadata.set(controls::ExposureTime, us);
+	}
+
+	if (applied.contains(V4L2_CID_ANALOGUE_GAIN)) {
+		int32_t gain = applied.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>();
+		metadata.set(controls::AnalogueGain, static_cast<float>(gain / kGainCodeScale));
+	}
+
+	auto it = frameStates_.find(sequence);
+	if (it == frameStates_.end()) {
+		LOG(QcomPipeline, Error) << "Missing state for frame " << sequence;
+		return;
+	}
+	const FrameState &state = it->second;
+	metadata.set(controls::ColourGains,
+		     { static_cast<float>(state.ife.red),
+		       static_cast<float>(state.ife.blue) });
+	metadata.set(controls::ColourTemperature,
+		     static_cast<int32_t>(std::lround(state.ife.cct)));
+	metadata.set(controls::AfMode, state.afMode);
+	metadata.set(controls::AfState, state.afState);
+	metadata.set(controls::AfPauseState, state.afPauseState);
+	if (lens_)
+		metadata.set(controls::LensPosition, state.lensPosition);
+	if (lastStatsSequence_ != UINT32_MAX &&
+	    qcom::inputSequence(lastStatsSequence_) == sequence)
+		metadata.set(controls::FocusFoM,
+		     static_cast<int32_t>(std::clamp(focusScore() / 1000.0,
+						     0.0, 2147483647.0)));
+}
+
+void QcomCameraData::imageBufferReady(FrameBuffer *buffer)
+{
+	QcomPipelineHandler *pipe =
+		static_cast<QcomPipelineHandler *>(this->pipe());
+
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess &&
+	    buffer->metadata().status != FrameMetadata::FrameCancelled) {
+		Request *request = buffer->request();
+		pipe->completeBuffer(request, buffer);
+		pipe->completeRequest(request);
+		return;
+	}
+
+	Request *request = buffer->request();
+
+	if (buffer->metadata().status == FrameMetadata::FrameCancelled) {
+		for (const auto &[stream, fb] : request->buffers()) {
+			fb->_d()->cancel();
+			pipe->completeBuffer(request, fb);
+		}
+		pipe->completeRequest(request);
+		return;
+	}
+
+	request->_d()->metadata().set(controls::SensorTimestamp,
+				      buffer->metadata().timestamp);
+	fetchStats();
+	updateMetadata(request, qcom::inputSequence(
+		buffer->metadata().sequence + video_->sequenceOffset()));
+
+	pipe->completeBuffer(request, buffer);
+	pipe->completeRequest(request);
+}
+
+std::unique_ptr<CameraConfiguration>
+QcomPipelineHandler::generateConfiguration(Camera *camera,
+					   Span<const StreamRole> roles)
+{
+	QcomCameraData *data = cameraData(camera);
+	auto config = std::make_unique<QcomCameraConfiguration>(data);
+
+	if (roles.empty())
+		return config;
+
+	std::map<PixelFormat, std::vector<SizeRange>> formats;
+	std::vector<SizeRange> sizes;
+	for (const Size &size : kOutputSizes)
+		sizes.emplace_back(size, size);
+	formats[formats::NV12] = std::move(sizes);
+
+	StreamConfiguration cfg(formats);
+	cfg.pixelFormat = formats::NV12;
+	cfg.size = kNativeSize;
+	cfg.colorSpace = ColorSpace::Sycc;
+	cfg.bufferCount = kBufferCount;
+
+	config->addConfiguration(cfg);
+	config->validate();
+
+	return config;
+}
+
+int QcomPipelineHandler::configure(Camera *camera, CameraConfiguration *config)
+{
+	QcomCameraData *data = cameraData(camera);
+	StreamConfiguration &cfg = config->at(0);
+	int ret;
+
+	ret = data->setFormats(cfg.size);
+	if (ret < 0)
+		return ret;
+
+	cfg.setStream(&data->stream_);
+
+	return 0;
+}
+
+int QcomPipelineHandler::exportFrameBuffers(Camera *camera, Stream *stream,
+					    std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+{
+	QcomCameraData *data = cameraData(camera);
+	unsigned int count = stream->configuration().bufferCount;
+
+	return data->video_->exportBuffers(count, buffers);
+}
+
+int QcomPipelineHandler::start(Camera *camera, const ControlList *controls)
+{
+	QcomCameraData *data = cameraData(camera);
+	int ret;
+
+	data->delayedCtrls_->reset();
+	data->lastStatsSequence_ = UINT32_MAX;
+	data->statsTimestamp_ = 0;
+	data->awbCounter_ = 0;
+	data->luxIndex_.reset();
+	data->aecLuma_.reset();
+	data->frameStates_.clear();
+	data->nextIfe_.reset();
+	data->streaming_ = false;
+	data->ifePending_ = true;
+	data->afSceneChange_.reset();
+	data->cancelAfMove();
+	if (data->afEnabled_)
+		data->setLensPosition(data->afPosition_);
+
+	if (controls) {
+		ret = data->processControls(*controls);
+		if (ret)
+			return ret;
+	}
+	ret = data->applyIfe(0);
+	if (ret)
+		return ret;
+	data->pushSensorControls();
+
+	if (data->afEnabled_ && data->afMode_ == controls::AfModeContinuous &&
+	    !data->afPaused_)
+		data->startAfScan(0);
+
+	ret = data->video_->importBuffers(data->stream_.configuration().bufferCount);
+	if (ret < 0)
+		return ret;
+
+	ret = data->pix_->setFrameStartEnabled(true);
+	if (ret < 0) {
+		data->video_->releaseBuffers();
+		return ret;
+	}
+
+	data->streaming_ = true;
+	ret = data->video_->streamOn();
+	if (ret < 0) {
+		data->streaming_ = false;
+		data->pix_->setFrameStartEnabled(false);
+		data->video_->releaseBuffers();
+		return ret;
+	}
+
+	return 0;
+}
+
+void QcomPipelineHandler::stopDevice(Camera *camera)
+{
+	QcomCameraData *data = cameraData(camera);
+
+	data->streaming_ = false;
+	data->video_->streamOff();
+	data->pix_->setFrameStartEnabled(false);
+	data->video_->releaseBuffers();
+	data->delayedCtrls_->reset();
+	data->lastStatsSequence_ = UINT32_MAX;
+}
+
+int QcomPipelineHandler::queueRequestDevice(Camera *camera, Request *request)
+{
+	QcomCameraData *data = cameraData(camera);
+	FrameBuffer *buffer = request->findBuffer(&data->stream_);
+
+	if (!buffer) {
+		LOG(QcomPipeline, Error) << "Request has no VFE PIX buffer";
+		return -ENOENT;
+	}
+
+	int ret = data->processControls(request->controls());
+	if (ret)
+		return ret;
+
+	return data->video_->queueBuffer(buffer);
+}
+
+bool QcomPipelineHandler::match(DeviceEnumerator *enumerator)
+{
+	DeviceMatch dm("qcom-camss");
+	dm.add("msm_vfe0_pix");
+
+	media_ = acquireMediaDevice(enumerator, dm);
+	if (!media_)
+		return false;
+
+	MediaEntity *sensorEntity = nullptr;
+	for (MediaEntity *entity : media_->entities()) {
+		if (entity->function() != MEDIA_ENT_F_CAM_SENSOR)
+			continue;
+		if (entity->name().find("s5k3m5") == std::string::npos)
+			continue;
+		sensorEntity = entity;
+		break;
+	}
+
+	if (!sensorEntity) {
+		LOG(QcomPipeline, Debug) << "No supported sensor found";
+		return false;
+	}
+
+	auto data = std::make_unique<QcomCameraData>(this, media_);
+	int ret = data->init(sensorEntity);
+	if (ret < 0)
+		return false;
+
+	std::set<Stream *> streams{ &data->stream_ };
+	std::shared_ptr<Camera> camera =
+		Camera::create(std::move(data), sensorEntity->name(), streams);
+	registerCamera(std::move(camera));
+
+	return true;
+}
+
+REGISTER_PIPELINE_HANDLER(QcomPipelineHandler, "qcom")
+
+} /* namespace libcamera */
