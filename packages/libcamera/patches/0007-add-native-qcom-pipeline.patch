+int QcomCameraData::findPath(MediaEntity *sensor, MediaEntity *target)
+{
+	std::map<MediaEntity *, std::pair<MediaEntity *, MediaLink *>> parents;
+	std::deque<MediaEntity *> queue;
+
+	parents[sensor] = { nullptr, nullptr };
+	queue.push_back(sensor);
+
+	while (!queue.empty()) {
+		MediaEntity *entity = queue.front();
+		queue.pop_front();
+
+		for (const MediaPad *pad : entity->pads()) {
+			if (!(pad->flags() & MEDIA_PAD_FL_SOURCE))
+				continue;
+
+			for (MediaLink *link : pad->links()) {
+				MediaEntity *next = link->sink()->entity();
+				if (parents.find(next) != parents.end())
+					continue;
+
+				parents[next] = { entity, link };
+				if (next == target)
+					break;
+				queue.push_back(next);
+			}
+		}
+	}
+
+	if (parents.find(target) == parents.end())
+		return -ENODEV;
+
+	std::vector<MediaEntity *> entities;
+	std::vector<MediaLink *> links;
+	MediaEntity *entity = target;
+
+	while (entity != sensor) {
+		MediaEntity *previous = parents[entity].first;
+		links.push_back(parents[entity].second);
+		entities.push_back(entity);
+		entity = previous;
+	}
+
+	std::reverse(entities.begin(), entities.end());
+	std::reverse(links.begin(), links.end());
+
+	path_.push_back(sensor);
+	path_.insert(path_.end(), entities.begin(), entities.end());
+	links_ = std::move(links);
+
+	return 0;
+}
+
+int QcomCameraData::disableLinks()
+{
+	for (MediaEntity *entity : media_->entities()) {
+		for (MediaPad *pad : entity->pads()) {
+			for (MediaLink *link : pad->links()) {
+				if (!(link->flags() & MEDIA_LNK_FL_ENABLED) ||
+				    link->flags() & MEDIA_LNK_FL_IMMUTABLE)
+					continue;
+
+				int ret = link->setEnabled(false);
+				if (ret < 0)
+					return ret;
+			}
+		}
+	}
+
+	for (MediaLink *link : links_) {
+		if (link->flags() & MEDIA_LNK_FL_ENABLED)
+			continue;
+
+		int ret = link->setEnabled(true);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
