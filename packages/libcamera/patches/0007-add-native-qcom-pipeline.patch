+int QcomCameraData::setFormats(const Size &size)
+{
+	const Size inputSize = size == kFullSize ? kFullSize : kNativeSize;
+	V4L2SubdeviceFormat format;
+	format.code = MEDIA_BUS_FMT_SGBRG10_1X10;
+	format.size = inputSize;
+
+	int ret = sensor_->setFormat(&format);
+	if (ret < 0)
+		return ret;
+
+	for (unsigned int i = 0; i < links_.size(); i++) {
+		MediaLink *link = links_[i];
+		MediaPad *sink = link->sink();
+
+		if (sink->entity()->function() != MEDIA_ENT_F_IO_V4L) {
+			V4L2Subdevice subdev(sink->entity());
+			ret = subdev.open();
+			if (ret < 0)
+				return ret;
+
+			V4L2SubdeviceFormat sinkFormat = format;
+			ret = subdev.setFormat(sink->index(), &sinkFormat);
+			if (ret < 0)
+				return ret;
+
+			if (sinkFormat.code != format.code ||
+			    sinkFormat.size != format.size) {
+				LOG(QcomPipeline, Error)
+					<< "Format mismatch at " << sink->entity()->name();
+				return -EINVAL;
+			}
+
+			if (sink->entity() == pixEntity_) {
+				Rectangle compose{ 0, 0, size };
+				ret = subdev.setSelection(sink->index(),
+							  V4L2_SEL_TGT_COMPOSE,
+							  &compose);
+				if (ret < 0)
+					return ret;
+
+				V4L2SubdeviceFormat sourceFormat = format;
+				sourceFormat.code = MEDIA_BUS_FMT_YUYV8_1_5X8;
+				sourceFormat.size = size;
+				ret = subdev.setFormat(1, &sourceFormat);
+				if (ret < 0)
+					return ret;
+				format = sourceFormat;
+			}
+		}
+
+		if (i + 1 < links_.size()) {
+			MediaPad *source = links_[i + 1]->source();
+			V4L2Subdevice subdev(source->entity());
+			ret = subdev.open();
+			if (ret < 0)
+				return ret;
+
+			V4L2SubdeviceFormat sourceFormat = format;
+			ret = subdev.setFormat(source->index(), &sourceFormat);
+			if (ret < 0)
+				return ret;
+			format = sourceFormat;
+		}
+	}
+
+	V4L2DeviceFormat videoFormat;
+	videoFormat.fourcc = video_->toV4L2PixelFormat(formats::NV12);
+	videoFormat.size = size;
+	videoFormat.colorSpace = ColorSpace::Sycc;
+
+	ret = video_->setFormat(&videoFormat);
+	if (ret < 0)
+		return ret;
+
+	if (videoFormat.fourcc != video_->toV4L2PixelFormat(formats::NV12) ||
+	    videoFormat.size != size)
+		return -EINVAL;
+
+	return refreshSensorInfo();
+}
+
+void QcomCameraData::pushSensorControls(int32_t exposure, int32_t gain)
+{
+	ControlList ctrls(sensor_->controls());
+	ctrls.set(V4L2_CID_EXPOSURE,
+		  std::clamp(exposure, exposureMin_, exposureMax_));
+	ctrls.set(V4L2_CID_ANALOGUE_GAIN,
+		  std::clamp(gain, gainMin_, gainMax_));
+	delayedCtrls_->push(ctrls);
+}
+
+void QcomCameraData::pushSensorControls()
+{
+	pushSensorControls(static_cast<int32_t>(std::lround(aeExposure_)),
+			   static_cast<int32_t>(std::lround(aeGain_)));
+}
+
+int QcomCameraData::setIfeWb(double gainR, double gainB)
+{
+	awbGainR_ = gainR;
+	awbGainB_ = gainB;
+	ifePending_ = true;
+	return 0;
+}
+
+int QcomCameraData::applyIfe(uint32_t sequence)
+{
+	struct qcom_camss_ife_config config = {};
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
+
+	config.version = QCOM_CAMSS_IFE_CONFIG_VERSION;
+	config.frame_sequence = sequence;
+	config.flags = QCOM_CAMSS_IFE_CONFIG_WHITE_BALANCE |
+		       QCOM_CAMSS_IFE_CONFIG_CCM;
+	config.wb_gain_q7[0] = std::clamp<int>(std::lround(awbGainR_ * 128), 0, 0xfff);
+	config.wb_gain_q7[1] = 128;
+	config.wb_gain_q7[2] = 128;
+	config.wb_gain_q7[3] = std::clamp<int>(std::lround(awbGainB_ * 128), 0, 0xfff);
+	memcpy(config.ccm_q7, ccmQ7_, sizeof(config.ccm_q7));
+
+	control.id = V4L2_CID_QCOM_CAMSS_IFE_CONFIG;
+	control.size = sizeof(config);
+	control.ptr = &config;
+
+	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.count = 1;
+	controls.request_fd = -1;
+	controls.controls = &control;
+
+	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	if (ret)
+		return ret;
+	IfeState state{ config.wb_gain_q7[0] / 128.0,
+			config.wb_gain_q7[3] / 128.0, colourTemperature_ };
+	if (streaming_)
+		nextIfe_ = std::make_pair(sequence, state);
+	else
+		appliedIfe_ = state;
+	ifePending_ = false;
+	LOG(QcomPipeline, Debug) << "IFE frame " << sequence << " gains "
+				 << state.red << " " << state.blue;
+	return 0;
+}
+
+int QcomCameraData::setLensPosition(int position)
+{
+	if (!lens_)
+		return -ENODEV;
+
+	position = std::clamp(position, kAfPositionMin, kAfPositionMax);
+	int ret = lens_->setFocusPosition(position);
+	if (!ret) {
+		afPosition_ = position;
+		lensSetTimestamp_ = monotonicNs();
+	}
+	return ret;
+}
+
+double QcomCameraData::lensPosition() const
+{
+	return qcom::lensPositionFromCode(afPosition_);
+}
+
+int QcomCameraData::lensPositionToCode(double position) const
+{
+	return qcom::lensPositionToCode(position);
+}
+
+uint64_t QcomCameraData::lensReadyTimestamp() const
+{
+	/* Exclude exposures and readout that overlap the lens movement. */
+	uint64_t exposureNs = std::llround(exposureMax_ * lineDurationNs_);
+	return lensSetTimestamp_ + kAfSettleNs + frameDurationNs_ + exposureNs;
+}
+
+void QcomCameraData::fetchStats()
+{
+	struct qcom_camss_stats request = {};
+	request.version = QCOM_CAMSS_STATS_VERSION;
+	request.awb_bg = reinterpret_cast<uintptr_t>(awb_.data());
+	request.bhist = reinterpret_cast<uintptr_t>(hist_.data());
+	request.bf = reinterpret_cast<uintptr_t>(bf_.data());
+
+	if (video_->ioctl(VIDIOC_QCOM_CAMSS_GET_STATS, &request) < 0)
+		return;
+
+	if (request.sequence == lastStatsSequence_)
+		return;
+
+	lastStatsSequence_ = request.sequence;
+	statsTimestamp_ = request.timestamp;
+
+	if (aeEnabled_)
+		updateAe(qcom::inputSequence(request.sequence));
+	if (awbEnabled_)
+		updateAwb();
+	if (afEnabled_)
+		updateAf(request.timestamp);
+}
+
+void QcomCameraData::updateAe(uint32_t sequence)
+{
+	if (++aeCounter_ % 2)
+		return;
+
+	uint64_t weighted = 0;
+	uint64_t total = 0;
+
+	for (unsigned int i = 0; i < hist_.size(); i++) {
+		weighted += static_cast<uint64_t>(i) * hist_[i];
+		total += hist_[i];
+	}
+
+	if (!total)
+		return;
+
+	double mean = static_cast<double>(weighted) / total;
+	constexpr double target = 200.0;
+
+	double ratio = target / std::max(mean, 1.0);
+	ratio = std::clamp(std::pow(ratio, 0.7), 0.5, 2.0);
+
+	ControlList applied = delayedCtrls_->get(sequence);
+	double exposure = applied.get(V4L2_CID_EXPOSURE).get<int32_t>();
+	double gain = applied.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>();
+	double effective = exposure * gain * ratio;
+	aeExposure_ = std::clamp(effective / gainMin_,
+				  static_cast<double>(exposureMin_),
+				  static_cast<double>(exposureMax_));
+	aeGain_ = std::clamp(effective / aeExposure_,
+			      static_cast<double>(gainMin_),
+			      static_cast<double>(gainMax_));
+	pushSensorControls();
+
+	LOG(QcomPipeline, Debug) << "AE mean " << mean << " exposure "
+				 << aeExposure_ << " gain " << aeGain_;
+}
+
+void QcomCameraData::updateCcm(double r, double g, double b)
+{
+	double cct = qcom::estimateCct(r / g, b / g);
+	colourTemperature_ = colourTemperature_ * 0.8 + cct * 0.2;
+	qcom::interpolateCcm(colourTemperature_, ccmQ7_);
+
+	LOG(QcomPipeline, Debug) << "AWB CCT " << colourTemperature_
+				 << " CCM " << ccmQ7_[0] << " " << ccmQ7_[4]
+				 << " " << ccmQ7_[8];
+}
+
+void QcomCameraData::updateAwb()
+{
+	if (++awbCounter_ % 4)
+		return;
+
+	uint64_t sumR = 0, sumB = 0, sumGr = 0, sumGb = 0;
+	uint64_t count = 0;
+
+	for (unsigned int y = 0; y < QCOM_CAMSS_AWB_BG_V_NUM; y++) {
+		for (unsigned int x = 0; x < QCOM_CAMSS_AWB_BG_H_NUM; x++) {
+			unsigned int i = y * QCOM_CAMSS_AWB_BG_H_NUM + x;
+			const uint32_t *region = &awb_[i *
+				(QCOM_CAMSS_AWB_BG_REGION_SIZE / sizeof(uint32_t))];
+			uint32_t samples = region[4] & 0xffff;
+			uint32_t satR = region[10] & 0xffff;
+			uint32_t satB = region[10] >> 16;
+			uint32_t satG = (region[11] & 0xffff) + (region[11] >> 16);
+			unsigned int weight = x >= 8 && x < 24 && y >= 6 && y < 18
+						? 4 : 1;
+
+			if (!samples || satR > samples || satB > samples ||
+			    satG > 2 * samples)
+				continue;
+			if (satR + satB + satG > samples / 2)
+				continue;
+
+			sumR += static_cast<uint64_t>(region[0]) * weight;
+			sumB += static_cast<uint64_t>(region[1]) * weight;
+			sumGr += static_cast<uint64_t>(region[2]) * weight;
+			sumGb += static_cast<uint64_t>(region[3]) * weight;
+			count += static_cast<uint64_t>(samples) * weight;
+		}
+	}
+
+	if (!count || !sumR || !sumB)
+		return;
+
+	double r = static_cast<double>(sumR) / count - kBlackLevel;
+	double b = static_cast<double>(sumB) / count - kBlackLevel;
+	double g = static_cast<double>(sumGr + sumGb) / (2 * count) - kBlackLevel;
+
+	if (r <= 4.0 || b <= 4.0 || g <= 4.0)
+		return;
+
+	double gainR = std::clamp(g / r, 0.25, 8.0);
+	double gainB = std::clamp(g / b, 0.25, 8.0);
+
+	awbGainR_ = awbGainR_ * 0.8 + gainR * 0.2;
+	awbGainB_ = awbGainB_ * 0.8 + gainB * 0.2;
+	updateCcm(r, g, b);
+	setIfeWb(awbGainR_, awbGainB_);
+
+	LOG(QcomPipeline, Debug) << "AWB R " << r << " G " << g << " B " << b
+				 << " gains " << awbGainR_ << " " << awbGainB_;
+}
+
+double QcomCameraData::focusScore() const
+{
+	double score = 0.0;
+
+	for (unsigned int i = 0; i < QCOM_CAMSS_BF_ROIS; i++) {
+		const uint64_t *roi = &bf_[1 + i * 4];
+		unsigned int x = i % 5;
+		unsigned int y = i / 5;
+		double weight = (x >= 1 && x <= 3 && y >= 1 && y <= 3) ? 2.0 : 1.0;
+
+		score += weight * ((roi[1] & 0xffffffffffULL) +
+				   (roi[3] & 0xffffffffffULL));
+	}
+
+	return score;
+}
+
+void QcomCameraData::setAfStage(AfStage stage)
+{
+	afStage_ = stage;
+}
+
+void QcomCameraData::startAfScan(uint64_t timestamp)
+{
+	if (!afEnabled_)
+		return;
+
+	afOriginalPosition_ = std::clamp(afPosition_, kAfPositionMin,
+					 kAfPositionMax);
+	afBestPosition_ = afOriginalPosition_;
+	afBestScore_ = -1.0;
+	afMinScore_ = std::numeric_limits<double>::max();
+	afCoarsePosition_ = kAfPositionMin;
+	afSceneChanges_ = 0;
+	afNextEval_ = timestamp ? timestamp + kAfWarmupNs : 0;
+	afState_ = controls::AfStateScanning;
+	setAfStage(AfStage::Warmup);
+	LOG(QcomPipeline, Debug) << "AF scan started at " << afOriginalPosition_;
+}
+
+void QcomCameraData::completeAfScan(bool success)
+{
+	if (success) {
+		setAfStage(AfStage::Idle);
+		afState_ = controls::AfStateFocused;
+		afReferenceScore_ = afBestScore_;
+		LOG(QcomPipeline, Info) << "AF focused at " << afBestPosition_;
+	} else {
+		setAfStage(AfStage::Restore);
+		afState_ = controls::AfStateFailed;
+		setLensPosition(afOriginalPosition_);
+		LOG(QcomPipeline, Info) << "AF scan failed";
+	}
+
+	if (afDeferredPause_) {
+		afPaused_ = true;
+		afDeferredPause_ = false;
+		afPauseState_ = controls::AfPauseStatePaused;
+	}
+}
+
+void QcomCameraData::updateAf(uint64_t timestamp)
+{
+	if (!afEnabled_)
+		return;
+
+	if (afMode_ != controls::AfModeContinuous &&
+	    afMode_ != controls::AfModeAuto) {
+		setAfStage(AfStage::Idle);
+		return;
+	}
+
+	if (afPaused_) {
+		if (afStage_ == AfStage::Warmup || afStage_ == AfStage::Coarse ||
+		    afStage_ == AfStage::Fine || afStage_ == AfStage::Confirm ||
+		    afStage_ == AfStage::Restore)
+			return;
+	}
+
+	if (afStage_ == AfStage::Idle) {
+		if (afMode_ == controls::AfModeContinuous && !afPaused_) {
+			double score = focusScore();
+			bool changed = afReferenceScore_ > 0.0
+				? score < afReferenceScore_ * 0.70 || score > afReferenceScore_ * 1.40
+				: afState_ == controls::AfStateFailed && score > 0.0;
+			if (changed && ++afSceneChanges_ >= 3)
+				startAfScan(timestamp);
+			else if (!changed)
+				afSceneChanges_ = 0;
+		}
+		return;
+	}
+
+	if (!afNextEval_) {
+		afNextEval_ = timestamp + kAfWarmupNs;
+		return;
+	}
+
+	if (timestamp < std::max(afNextEval_, lensReadyTimestamp()))
+		return;
+
+	double score = focusScore();
+
+	if (afStage_ == AfStage::Warmup) {
+		afCoarsePosition_ = kAfPositionMin;
+		setLensPosition(afCoarsePosition_);
+		afNextEval_ = timestamp + kAfSettleNs;
+		setAfStage(AfStage::Coarse);
+		return;
+	}
+
+	if (afStage_ == AfStage::Coarse || afStage_ == AfStage::Fine) {
+		afMinScore_ = std::min(afMinScore_, score);
+	}
+	if ((afStage_ == AfStage::Coarse || afStage_ == AfStage::Fine) &&
+	    score > afBestScore_) {
+		afBestScore_ = score;
+		afBestPosition_ = afPosition_;
+	}
+
+	if (afStage_ == AfStage::Coarse) {
+		afCoarsePosition_ += kAfCoarseStep;
+		if (afCoarsePosition_ > kAfPositionMax) {
+			int fineStart = std::max(kAfPositionMin,
+						 afBestPosition_ - kAfCoarseStep);
+			afFineEnd_ = std::min(kAfPositionMax, afBestPosition_ + kAfCoarseStep);
+			setLensPosition(fineStart);
+			afNextEval_ = timestamp + kAfSettleNs;
+			setAfStage(AfStage::Fine);
+		} else {
+			setLensPosition(afCoarsePosition_);
+			afNextEval_ = timestamp + kAfSettleNs;
+		}
+		return;
+	}
+
+	if (afStage_ == AfStage::Fine) {
+		if (afPosition_ >= afFineEnd_) {
+			setLensPosition(afBestPosition_);
+			afNextEval_ = timestamp + kAfSettleNs;
+			setAfStage(AfStage::Confirm);
+		} else {
+			setLensPosition(std::min(afPosition_ + kAfFineStep, afFineEnd_));
+			afNextEval_ = timestamp + kAfSettleNs;
+		}
+		return;
+	}
+
+	if (afStage_ == AfStage::Confirm) {
+		completeAfScan(afBestScore_ > afMinScore_ * 1.10 &&
+			       score > 0.0 && score >= afBestScore_ * 0.70);
+		return;
+	}
+
+	if (afStage_ == AfStage::Restore) {
+		afReferenceScore_ = score;
+		setAfStage(AfStage::Idle);
+	}
+}
+
+int QcomCameraData::processControls(const ControlList &controls)
+{
+	bool sensorUpdate = false;
+
+	if (controls.contains(controls::AeEnable.id())) {
+		aeEnabled_ = *controls.get(controls::AeEnable);
+		if (!aeEnabled_) {
+			if (controls.contains(controls::ExposureTime.id())) {
+				int32_t us = *controls.get(controls::ExposureTime);
+				aeExposure_ = std::clamp(us * 1000.0 / lineDurationNs_,
+							 static_cast<double>(exposureMin_),
+							 static_cast<double>(exposureMax_));
+			}
+			if (controls.contains(controls::AnalogueGain.id()))
+				aeGain_ = std::clamp(static_cast<double>(*controls.get(controls::AnalogueGain)),
+						     static_cast<double>(gainMin_),
+						     static_cast<double>(gainMax_));
+			sensorUpdate = true;
+		}
+	} else if (!aeEnabled_) {
+		if (controls.contains(controls::ExposureTime.id())) {
+			int32_t us = *controls.get(controls::ExposureTime);
+			aeExposure_ = std::clamp(us * 1000.0 / lineDurationNs_,
+						 static_cast<double>(exposureMin_),
+						 static_cast<double>(exposureMax_));
+			sensorUpdate = true;
+		}
+		if (controls.contains(controls::AnalogueGain.id())) {
+			aeGain_ = std::clamp(static_cast<double>(*controls.get(controls::AnalogueGain)),
+					     static_cast<double>(gainMin_),
+					     static_cast<double>(gainMax_));
+			sensorUpdate = true;
+		}
+	}
+
+	if (controls.contains(controls::AwbEnable.id())) {
+		awbEnabled_ = *controls.get(controls::AwbEnable);
+		if (!awbEnabled_ && controls.contains(controls::ColourGains.id())) {
+			const auto gains = *controls.get(controls::ColourGains);
+			awbGainR_ = std::clamp(static_cast<double>(gains[0]), 0.25, 8.0);
+			awbGainB_ = std::clamp(static_cast<double>(gains[1]), 0.25, 8.0);
+			setIfeWb(awbGainR_, awbGainB_);
+		}
+	} else if (!awbEnabled_ && controls.contains(controls::ColourGains.id())) {
+		const auto gains = *controls.get(controls::ColourGains);
+		awbGainR_ = std::clamp(static_cast<double>(gains[0]), 0.25, 8.0);
+		awbGainB_ = std::clamp(static_cast<double>(gains[1]), 0.25, 8.0);
+		setIfeWb(awbGainR_, awbGainB_);
+	}
+
+	if (controls.contains(controls::AfMode.id())) {
+		int mode = *controls.get(controls::AfMode);
+		if (mode != afMode_) {
+			afMode_ = mode;
+			afPaused_ = false;
+			afDeferredPause_ = false;
+			afPauseState_ = controls::AfPauseStateRunning;
+			afState_ = controls::AfStateIdle;
+			setAfStage(AfStage::Idle);
+			if (afMode_ == controls::AfModeContinuous)
+				startAfScan(statsTimestamp_);
+		}
+	}
+
+	if (afMode_ == controls::AfModeManual && lens_ &&
+	    controls.contains(controls::LensPosition.id())) {
+		double position = *controls.get(controls::LensPosition);
+		int ret = setLensPosition(lensPositionToCode(position));
+		if (ret)
+			return ret;
+	}
+
+	if (afMode_ == controls::AfModeAuto &&
+	    controls.contains(controls::AfTrigger.id())) {
+		int trigger = *controls.get(controls::AfTrigger);
+		if (trigger == controls::AfTriggerStart &&
+		    afStage_ == AfStage::Idle)
+			startAfScan(statsTimestamp_);
+		else if (trigger == controls::AfTriggerCancel) {
+			afState_ = controls::AfStateIdle;
+			setAfStage(AfStage::Idle);
+			if (afPosition_ != afOriginalPosition_)
+				setLensPosition(afOriginalPosition_);
+		}
+	}
+
+	if (afMode_ == controls::AfModeContinuous &&
+	    controls.contains(controls::AfPause.id())) {
+		int pause = *controls.get(controls::AfPause);
+		if (pause == controls::AfPauseResume) {
+			afPaused_ = false;
+			afDeferredPause_ = false;
+			afPauseState_ = controls::AfPauseStateRunning;
+		} else if (afStage_ == AfStage::Idle ||
+			   pause == controls::AfPauseImmediate) {
+			afPaused_ = true;
+			afDeferredPause_ = false;
+			afPauseState_ = controls::AfPauseStatePaused;
+		} else {
+			afDeferredPause_ = true;
+			afPauseState_ = controls::AfPauseStatePausing;
+		}
+	}
+
+	if (sensorUpdate)
+		pushSensorControls();
+	return 0;
+}
+
+void QcomCameraData::updateMetadata(Request *request, uint32_t sequence)
+{
+	ControlList &metadata = request->_d()->metadata();
+	ControlList applied = delayedCtrls_->get(sequence);
+
+	if (applied.contains(V4L2_CID_EXPOSURE)) {
+		int32_t lines = applied.get(V4L2_CID_EXPOSURE).get<int32_t>();
+		int32_t us = static_cast<int32_t>(lines * lineDurationNs_ / 1000.0);
+		metadata.set(controls::ExposureTime, us);
+	}
+
+	if (applied.contains(V4L2_CID_ANALOGUE_GAIN)) {
+		int32_t gain = applied.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>();
+		metadata.set(controls::AnalogueGain, static_cast<float>(gain));
+	}
+
+	auto it = frameStates_.find(sequence);
+	if (it == frameStates_.end()) {
+		LOG(QcomPipeline, Error) << "Missing state for frame " << sequence;
+		return;
+	}
+	const FrameState &state = it->second;
+	metadata.set(controls::ColourGains,
+		     { static_cast<float>(state.ife.red),
+		       static_cast<float>(state.ife.blue) });
+	metadata.set(controls::ColourTemperature,
+		     static_cast<int32_t>(std::lround(state.ife.cct)));
+	metadata.set(controls::AfMode, state.afMode);
+	metadata.set(controls::AfState, state.afState);
+	metadata.set(controls::AfPauseState, state.afPauseState);
+	if (lens_)
+		metadata.set(controls::LensPosition, state.lensPosition);
+	if (lastStatsSequence_ != UINT32_MAX &&
+	    qcom::inputSequence(lastStatsSequence_) == sequence)
+		metadata.set(controls::FocusFoM,
+		     static_cast<int32_t>(std::clamp(focusScore() / 1000.0,
+						     0.0, 2147483647.0)));
+}
+
+void QcomCameraData::imageBufferReady(FrameBuffer *buffer)
+{
+	QcomPipelineHandler *pipe =
+		static_cast<QcomPipelineHandler *>(this->pipe());
+
+	if (buffer->metadata().status != FrameMetadata::FrameSuccess &&
+	    buffer->metadata().status != FrameMetadata::FrameCancelled) {
+		Request *request = buffer->request();
+		pipe->completeBuffer(request, buffer);
+		pipe->completeRequest(request);
+		return;
+	}
+
+	Request *request = buffer->request();
+
+	if (buffer->metadata().status == FrameMetadata::FrameCancelled) {
+		for (const auto &[stream, fb] : request->buffers()) {
+			fb->_d()->cancel();
+			pipe->completeBuffer(request, fb);
+		}
+		pipe->completeRequest(request);
+		return;
+	}
+
+	request->_d()->metadata().set(controls::SensorTimestamp,
+				      buffer->metadata().timestamp);
+	fetchStats();
+	updateMetadata(request, qcom::inputSequence(
+		buffer->metadata().sequence + video_->sequenceOffset()));
+
+	pipe->completeBuffer(request, buffer);
+	pipe->completeRequest(request);
+}
+
+std::unique_ptr<CameraConfiguration>
+QcomPipelineHandler::generateConfiguration(Camera *camera,
+					   Span<const StreamRole> roles)
+{
+	QcomCameraData *data = cameraData(camera);
+	auto config = std::make_unique<QcomCameraConfiguration>(data);
+
+	if (roles.empty())
+		return config;
+
+	std::map<PixelFormat, std::vector<SizeRange>> formats;
+	std::vector<SizeRange> sizes;
+	for (const Size &size : kOutputSizes)
+		sizes.emplace_back(size, size);
+	formats[formats::NV12] = std::move(sizes);
+
+	StreamConfiguration cfg(formats);
+	cfg.pixelFormat = formats::NV12;
+	cfg.size = kNativeSize;
+	cfg.colorSpace = ColorSpace::Sycc;
+	cfg.bufferCount = kBufferCount;
+
+	config->addConfiguration(cfg);
+	config->validate();
+
+	return config;
+}
+
+int QcomPipelineHandler::configure(Camera *camera, CameraConfiguration *config)
+{
+	QcomCameraData *data = cameraData(camera);
+	StreamConfiguration &cfg = config->at(0);
+	int ret;
+
+	ret = data->setFormats(cfg.size);
+	if (ret < 0)
+		return ret;
+
+	cfg.setStream(&data->stream_);
+
+	return 0;
+}
+
+int QcomPipelineHandler::exportFrameBuffers(Camera *camera, Stream *stream,
+					    std::vector<std::unique_ptr<FrameBuffer>> *buffers)
+{
+	QcomCameraData *data = cameraData(camera);
+	unsigned int count = stream->configuration().bufferCount;
+
+	return data->video_->exportBuffers(count, buffers);
+}
+
+int QcomPipelineHandler::start(Camera *camera, const ControlList *controls)
+{
+	QcomCameraData *data = cameraData(camera);
+	int ret;
+
+	data->delayedCtrls_->reset();
+	data->lastStatsSequence_ = UINT32_MAX;
+	data->statsTimestamp_ = 0;
+	data->aeCounter_ = data->awbCounter_ = 0;
+	data->frameStates_.clear();
+	data->nextIfe_.reset();
+	data->streaming_ = false;
+	data->ifePending_ = true;
+	data->afReferenceScore_ = 0.0;
+	data->afSceneChanges_ = 0;
+	if (data->afEnabled_)
+		data->setLensPosition(data->afPosition_);
+
+	if (controls) {
+		ret = data->processControls(*controls);
+		if (ret)
+			return ret;
+	}
+	ret = data->applyIfe(0);
+	if (ret)
+		return ret;
+	data->pushSensorControls();
+
+	if (data->afEnabled_ && data->afMode_ == controls::AfModeContinuous &&
+	    !data->afPaused_)
+		data->startAfScan(0);
+
+	ret = data->video_->importBuffers(data->stream_.configuration().bufferCount);
+	if (ret < 0)
+		return ret;
+
+	ret = data->pix_->setFrameStartEnabled(true);
+	if (ret < 0) {
+		data->video_->releaseBuffers();
+		return ret;
+	}
+
+	data->streaming_ = true;
+	ret = data->video_->streamOn();
+	if (ret < 0) {
+		data->streaming_ = false;
+		data->pix_->setFrameStartEnabled(false);
+		data->video_->releaseBuffers();
+		return ret;
+	}
+
+	return 0;
+}
+
+void QcomPipelineHandler::stopDevice(Camera *camera)
+{
+	QcomCameraData *data = cameraData(camera);
+
+	data->streaming_ = false;
+	data->video_->streamOff();
+	data->pix_->setFrameStartEnabled(false);
+	data->video_->releaseBuffers();
+	data->delayedCtrls_->reset();
+	data->lastStatsSequence_ = UINT32_MAX;
+}
+
+int QcomPipelineHandler::queueRequestDevice(Camera *camera, Request *request)
+{
+	QcomCameraData *data = cameraData(camera);
+	FrameBuffer *buffer = request->findBuffer(&data->stream_);
+
+	if (!buffer) {
+		LOG(QcomPipeline, Error) << "Request has no VFE PIX buffer";
+		return -ENOENT;
+	}
+
+	int ret = data->processControls(request->controls());
+	if (ret)
+		return ret;
+
+	return data->video_->queueBuffer(buffer);
+}
+
+bool QcomPipelineHandler::match(DeviceEnumerator *enumerator)
+{
+	DeviceMatch dm("qcom-camss");
+	dm.add("msm_vfe0_pix");
+
+	media_ = acquireMediaDevice(enumerator, dm);
+	if (!media_)
+		return false;
+
+	MediaEntity *sensorEntity = nullptr;
+	for (MediaEntity *entity : media_->entities()) {
+		if (entity->function() != MEDIA_ENT_F_CAM_SENSOR)
+			continue;
+		if (entity->name().find("s5k3m5") == std::string::npos)
+			continue;
+		sensorEntity = entity;
+		break;
+	}
+
+	if (!sensorEntity) {
+		LOG(QcomPipeline, Debug) << "No supported sensor found";
+		return false;
+	}
+
+	auto data = std::make_unique<QcomCameraData>(this, media_);
+	int ret = data->init(sensorEntity);
+	if (ret < 0)
+		return false;
+
+	std::set<Stream *> streams{ &data->stream_ };
+	std::shared_ptr<Camera> camera =
+		Camera::create(std::move(data), sensorEntity->name(), streams);
+	registerCamera(std::move(camera));
+
+	return true;
+}
+
+REGISTER_PIPELINE_HANDLER(QcomPipelineHandler, "qcom")
+
+} /* namespace libcamera */
