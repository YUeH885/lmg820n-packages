From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add native LG AWB gain adjustment and convergence

Generate both lux-dependent gain-offset tables, filter factors, fallback
gains and channel bounds. Apply CCT offsets, track convergence paths and
unclipped temporal history, and reproduce manual, fast, startup, flash,
AF and timing overrides. Normalize and clip final output separately from
the temporal history used by the next frame.

diff --git a/src/libcamera/pipeline/qcom/lg_awb_gain.h b/src/libcamera/pipeline/qcom/lg_awb_gain.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_gain.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_math.h"
+
+namespace libcamera::qcom {
+
+using LgAwbGainOffsets = std::array<LgAwbRatios, 6>;
+
+struct LgAwbGainConfiguration {
+	std::array<int16_t, 24> luxKnots;
+	std::array<std::array<LgAwbGainOffsets, 24>, 2> offsets;
+	std::array<float, 6> filterFactors;
+	std::array<std::array<float, 2>, 3> limits;
+	LgAwbRgb fallback;
+};
+
+class LgAwbGain
+{
+public:
+	explicit LgAwbGain(const LgAwbGainConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	LgAwbGainOffsets offsets(unsigned int selector, int lux) const
+	{
+		unsigned int region = std::lower_bound(config_.luxKnots.begin(), config_.luxKnots.end(), lux) -
+			config_.luxKnots.begin();
+		unsigned int first = region ? region - 1 : 0;
+		unsigned int last = std::min<unsigned int>(region, config_.luxKnots.size() - 1);
+		float t = first == last ? 0.0f : static_cast<float>(lux - config_.luxKnots[first]) /
+			(config_.luxKnots[last] - config_.luxKnots[first]);
+		LgAwbGainOffsets result;
+		for (unsigned int i = 0; i < result.size(); i++) {
+			auto a = config_.offsets[selector][first][i], b = config_.offsets[selector][last][i];
+			result[i] = { a.red + lgAwbProduct(t, b.red - a.red),
+				      a.blue + lgAwbProduct(t, b.blue - a.blue) };
+		}
+		return result;
+	}
+
+	static LgAwbRgb apply(LgAwbRgb rgb, int32_t cct, const LgAwbGainOffsets &offsets)
+	{
+		constexpr std::array<int32_t, 6> ccts{ 7500, 6500, 5000, 4000, 2856, 2300 };
+		LgAwbRatios factor = offsets.back();
+		if (cct >= ccts.front()) {
+			factor = offsets.front();
+		} else {
+			for (unsigned int i = 1; i < ccts.size(); i++) {
+				if (cct < ccts[i])
+					continue;
+				float t = static_cast<float>(cct - ccts[i]) / (ccts[i - 1] - ccts[i]);
+				factor = { offsets[i].red + lgAwbProduct(t, offsets[i - 1].red - offsets[i].red),
+					   offsets[i].blue + lgAwbProduct(t, offsets[i - 1].blue - offsets[i].blue) };
+				break;
+			}
+		}
+		rgb[0] = lgAwbProduct(rgb[0], factor.red);
+		rgb[2] = lgAwbProduct(rgb[2], factor.blue);
+		return rgb;
+	}
+
+	static bool invalid(const LgAwbRgb &rgb)
+	{
+		return !std::all_of(rgb.begin(), rgb.end(), [](float value) { return std::isfinite(value); }) ||
+			(std::abs(rgb[0]) <= 1e-6f && std::abs(rgb[2]) <= 1e-6f) ||
+			(rgb[0] >= 1.0f - 1e-6f && rgb[0] <= 1.0f + 1e-6f &&
+			 rgb[2] >= 1.0f - 1e-6f && rgb[2] <= 1.0f + 1e-6f);
+	}
+
+	LgAwbRgb limit(LgAwbRgb rgb) const
+	{
+		if (invalid(rgb))
+			rgb = config_.fallback;
+		for (unsigned int channel = 0; channel < rgb.size(); channel++) {
+			if (rgb[channel] < config_.limits[channel][0]) {
+				float factor = config_.limits[channel][0] / rgb[channel];
+				for (float &value : rgb)
+					value = lgAwbProduct(value, factor);
+			}
+		}
+		for (unsigned int channel = 0; channel < rgb.size(); channel++)
+			rgb[channel] = std::min(rgb[channel], config_.limits[channel][1]);
+		return rgb;
+	}
+
+private:
+	LgAwbGainConfiguration config_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_convergence.h b/src/libcamera/pipeline/qcom/lg_awb_convergence.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_convergence.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+#include "lg_awb_colour.h"
+#include "lg_awb_math.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbGainTiming {
+	int32_t counter, frames;
+};
+
+struct LgAwbConvergenceControls {
+	unsigned int path, mode, flashState;
+	bool fastRequest, startup, afRequest;
+	std::optional<LgAwbGainTiming> timing;
+};
+
+struct LgAwbGainFilterState {
+	LgAwbRgb rgb{};
+	int32_t cct = 0;
+	unsigned int previousPath = 0, stickyPath = 0;
+};
+
+struct LgAwbConvergenceResult {
+	LgAwbRgb rgb;
+	int32_t cct;
+	unsigned int state;
+	float factor;
+	LgAwbXyY colour;
+};
+
+class LgAwbConvergence
+{
+public:
+	explicit LgAwbConvergence(const std::array<float, 6> &factors, LgAwbGainFilterState history = {})
+		: factors_(factors), history_(history)
+	{
+	}
+
+	void reset() { history_ = {}; }
+
+	LgAwbConvergenceResult update(LgAwbRgb target, int32_t cct,
+				      const LgAwbConvergenceControls &controls, const LgAwbColour &colour)
+	{
+		float alpha = factors_[0];
+		if (controls.path == history_.previousPath) {
+			if (history_.stickyPath == 4)
+				alpha = factors_[2];
+			else if (history_.stickyPath == 5)
+				alpha = factors_[3];
+		} else if (controls.path == 4 || history_.previousPath == 4) {
+			history_.stickyPath = 4;
+		} else if (controls.path == 5 || history_.previousPath == 5) {
+			history_.stickyPath = 5;
+		}
+		history_.previousPath = controls.path;
+		float red = std::abs(1.0f - (target[1] / target[0]) / (history_.rgb[1] / history_.rgb[0]));
+		float blue = std::abs(1.0f - (target[1] / target[2]) / (history_.rgb[1] / history_.rgb[2]));
+		unsigned int state = !controls.startup && red < 0.01f && blue < 0.01f ? 2 : 1;
+		if (state == 2)
+			history_.stickyPath = 0;
+		if (controls.mode != 1)
+			alpha = factors_[4];
+		else if (controls.fastRequest)
+			alpha = 0.99f;
+		else if (controls.startup)
+			alpha = factors_[1];
+		else if (controls.flashState >= 1 && controls.flashState <= 3)
+			alpha = factors_[5];
+		else if (controls.flashState == 4 || controls.afRequest)
+			alpha = factors_[1];
+		else if (controls.timing && controls.timing->counter <= controls.timing->frames)
+			alpha = 1.0f / controls.timing->frames;
+		else if (!(alpha > 0))
+			alpha = 0.02f;
+		LgAwbConvergenceResult result;
+		result.state = state;
+		result.factor = alpha;
+		float inverse = 1.0f - alpha;
+		for (unsigned int channel = 0; channel < target.size(); channel++)
+			result.rgb[channel] = lgAwbProduct(target[channel], alpha) + lgAwbProduct(history_.rgb[channel], inverse);
+		result.cct = static_cast<int32_t>(lgAwbProduct(static_cast<float>(cct), alpha) +
+			lgAwbProduct(static_cast<float>(history_.cct), inverse));
+		history_.rgb = result.rgb;
+		history_.cct = result.cct;
+		result.colour = colour.fromRgb({ result.rgb[1] / result.rgb[0], result.rgb[1] / result.rgb[2] });
+		return result;
+	}
+
+	const LgAwbGainFilterState &history() const { return history_; }
+
+private:
+	std::array<float, 6> factors_;
+	LgAwbGainFilterState history_;
+};
+
+} /* namespace libcamera::qcom */
