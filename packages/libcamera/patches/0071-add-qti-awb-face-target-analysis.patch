From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add QTI AWB face target and confidence analysis

Generate face target, skin weight, and confidence tables. Retain the
factory inverse-gain distance ratio, candidate blending, and history.

diff --git a/src/libcamera/pipeline/qcom/awb_face_analysis.h b/src/libcamera/pipeline/qcom/awb_face_analysis.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/awb_face_analysis.h
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <utility>
+#include <vector>
+
+#include "awb_face.h"
+
+namespace libcamera::qcom {
+
+using QtiAwbFaceMetrics = std::array<float, 9>;
+
+template<std::size_t Width>
+struct QtiAwbFaceTable {
+	std::array<unsigned int, 2> indices;
+	QtiAwbTriggerTable<2, Width> table;
+
+	std::array<float, Width> evaluate(const QtiAwbFaceMetrics &metrics) const
+	{
+		float triggers[] = { metrics[indices[0]], metrics[indices[1]] };
+		for (float &value : triggers)
+			if (std::isnan(value))
+				value = 0;
+		return qtiAwbEvaluateTrigger(table, triggers);
+	}
+};
+
+struct QtiAwbFaceAnalysisConfiguration {
+	float weight;
+	std::array<QtiAwbFaceTable<2>, 2> targets;
+	std::array<QtiAwbFaceTable<1>, 3> skinWeights;
+	std::vector<QtiAwbFaceTable<1>> confidences;
+};
+
+struct QtiAwbFaceAnalysisState {
+	std::array<QtiAwbPoint, 2> skinReferences;
+	std::array<QtiAwbPoint, 2> points;
+	std::array<QtiAwbPoint, 2> gains;
+	std::array<float, 2> ccts;
+	float blend;
+	float distanceRatio;
+	QtiAwbPoint target;
+	float confidence;
+};
+
+struct QtiAwbFaceResult {
+	QtiAwbPoint point;
+	float confidence;
+	float weight;
+};
+
+class QtiAwbFaceAnalysis
+{
+public:
+	explicit QtiAwbFaceAnalysis(QtiAwbFaceAnalysisConfiguration config)
+		: config_(std::move(config))
+	{
+	}
+
+	void reset() { state_ = {}; }
+	const QtiAwbFaceAnalysisState &state() const { return state_; }
+
+	QtiAwbFaceResult process(const QtiAwbFaceStatistics &face, QtiAwbPoint global,
+				 float lux, float cct, unsigned int admitted,
+				 unsigned int regions, const QtiAwbLocus &locus)
+	{
+		QtiAwbFaceMetrics metrics{ lux, cct, float(admitted) / regions,
+			float(face.count) / regions, state_.ccts[0], state_.ccts[1],
+			state_.distanceRatio, global.rg, global.bg };
+		state_.blend = state_.confidence = 1;
+		for (unsigned int i = 0; i < 2; i++) {
+			auto reference = config_.targets[1 - i].evaluate(metrics);
+			state_.skinReferences[i] = { reference[0], reference[1] };
+		}
+		if (!face.count)
+			return { state_.target, 0, config_.weight };
+		for (unsigned int i = 0; i < 2; i++) {
+			const auto &reference = state_.skinReferences[i];
+			state_.points[i] = { face.mean.rg / reference.rg, face.mean.bg / reference.bg };
+			state_.gains[i] = { 1.0f / state_.points[i].rg, 1.0f / state_.points[i].bg };
+		}
+		QtiAwbPoint inverse{ 1.0f / global.rg, 1.0f / global.bg };
+		float firstRed = state_.gains[0].rg - inverse.rg;
+		float firstBlue = state_.gains[0].bg - inverse.bg;
+		float secondRed = state_.gains[1].rg - inverse.rg;
+		float secondBlue = state_.gains[1].bg - inverse.bg;
+		float denominator = std::fma(firstRed, firstRed, firstBlue * firstBlue);
+		state_.distanceRatio = denominator == 0 ? 9999.0f :
+			std::fma(secondRed, secondRed, secondBlue * secondBlue) / denominator;
+		for (unsigned int i = 0; i < 2; i++)
+			state_.ccts[i] = locus.evaluate(state_.points[i]).cct;
+		metrics[4] = state_.ccts[0];
+		metrics[5] = state_.ccts[1];
+		metrics[6] = state_.distanceRatio;
+		float first = config_.skinWeights[0].evaluate(metrics)[0];
+		float second = config_.skinWeights[1].evaluate(metrics)[0];
+		float third = 1.0f - config_.skinWeights[2].evaluate(metrics)[0];
+		state_.blend = std::fma(second, first, third * (1.0f - first));
+		state_.target = {
+			std::fma(state_.points[0].rg, state_.blend, state_.points[1].rg * (1.0f - state_.blend)),
+			std::fma(state_.points[0].bg, state_.blend, state_.points[1].bg * (1.0f - state_.blend)),
+		};
+		for (const auto &table : config_.confidences)
+			state_.confidence *= table.evaluate(metrics)[0];
+		return { state_.target, state_.confidence, config_.weight };
+	}
+
+private:
+	QtiAwbFaceAnalysisConfiguration config_;
+	QtiAwbFaceAnalysisState state_{};
+};
+
+} /* namespace libcamera::qcom */
