@@ -1720,6 +1732,39 @@
 	float currentIndex = aeExposureIndex(profile_, requested);
 	float minimumIndex = aeExposureIndex(profile_, exposureMin_ * lineDurationNs_ * gainMin_);
 	float maximumIndex = aeExposureIndex(profile_, exposureMax_ * lineDurationNs_ * gainMax_);
+	if (aeLocked_) {
+		float evDelta = aeEvOffset(aeEvStep_, profile_.aeLuxLogScale) -
+				aeEvOffset(lockedEvStep_, profile_.aeLuxLogScale);
+		float activeIndex = std::clamp(lockedIndex_ + evDelta, minimumIndex, maximumIndex);
+		LOG(QcomPipeline, Debug) << std::setprecision(9)
+			<< "AE locked frame " << sequence << " baseline " << lockedIndex_
+			<< " locked EV " << aeEvValue(lockedEvStep_) << " current EV " << aeEvValue(aeEvStep_)
+			<< " offset " << evDelta << " active " << activeIndex;
+
+		double corrected = aeExposureForIndex(profile_, activeIndex);
+		if (activeIndex == minimumIndex)
+			corrected = exposureMin_ * lineDurationNs_ * gainMin_;
+		else if (activeIndex == maximumIndex)
+			corrected = exposureMax_ * lineDurationNs_ * gainMax_;
+		double allocatedGain, allocatedExposure;
+		aeAllocateExposure(profile_, corrected, allocatedGain, allocatedExposure);
+
+		double exposureMinNs = exposureMin_ * lineDurationNs_;
+		double exposureMaxNs = exposureMax_ * lineDurationNs_;
+		allocatedGain = std::clamp(allocatedGain, gainMin_, gainMax_);
+		allocatedExposure = std::clamp(corrected / allocatedGain,
+					       exposureMinNs, exposureMaxNs);
+		allocatedGain = std::clamp(corrected / allocatedExposure,
+					   gainMin_, gainMax_);
+
+		aeExposure_ = allocatedExposure / lineDurationNs_;
+		aeGain_ = allocatedGain;
+
+		LOG(QcomPipeline, Debug) << "AE locked luma " << luma << " target " << target
