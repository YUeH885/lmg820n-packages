From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add AE lock control and runtime handling

Expose draft AeLock control and support ANDROID_CONTROL_AE_LOCK in Android
HAL. When AE lock is enabled, capture the current exposure index and EV
offset as baseline, freeze automatic convergence adjustments, apply EV
offset deltas directly to the locked index, and publish draft AeLock and
AeState controls in request metadata.

--- a/src/libcamera/control_ids_draft.yaml
+++ b/src/libcamera/control_ids_draft.yaml
@@ -8,6 +8,14 @@
 # set through Request::controls() and returned out through Request::metadata().
 vendor: draft
 controls:
+  - AeLock:
+      type: bool
+      direction: inout
+      description: |
+        Control for AE lock. Currently identical to ANDROID_CONTROL_AE_LOCK.
+
+        Whether the camera device will lock automatic exposure algorithm.
+
   - AePrecaptureTrigger:
       type: int32_t
       direction: inout

--- a/src/android/camera_capabilities.cpp
+++ b/src/android/camera_capabilities.cpp
@@ -1010,7 +1010,7 @@
 	staticMetadata_->addEntry(ANDROID_CONTROL_SCENE_MODE_OVERRIDES,
 				  sceneModesOverride);
 
-	uint8_t aeLockAvailable = ANDROID_CONTROL_AE_LOCK_AVAILABLE_FALSE;
+	uint8_t aeLockAvailable = ANDROID_CONTROL_AE_LOCK_AVAILABLE_TRUE;
 	staticMetadata_->addEntry(ANDROID_CONTROL_AE_LOCK_AVAILABLE,
 				  aeLockAvailable);
 

--- a/src/android/camera_device.cpp
+++ b/src/android/camera_device.cpp
@@ -819,6 +819,11 @@
 		controls.set(controls::draft::FaceDetectMode, data[0]);
 	}
 
+	if (settings.getEntry(ANDROID_CONTROL_AE_LOCK, &entry)) {
+		const uint8_t *data = entry.data.u8;
+		controls.set(controls::draft::AeLock, data[0] == ANDROID_CONTROL_AE_LOCK_ON);
+	}
+
 	if (settings.getEntry(ANDROID_SENSOR_TEST_PATTERN_MODE, &entry)) {
 		const int32_t data = *entry.data.i32;
 		int32_t testPatternMode = controls::draft::TestPatternModeOff;
@@ -1468,7 +1473,11 @@
 	resultMetadata->addEntry(ANDROID_CONTROL_AE_EXPOSURE_COMPENSATION,
 				 value32);
 
-	value = ANDROID_CONTROL_AE_LOCK_OFF;
+	bool aeLocked = false;
+	if (metadata.contains(controls::draft::AeLock))
+		aeLocked = metadata.get(controls::draft::AeLock);
+
+	value = aeLocked ? ANDROID_CONTROL_AE_LOCK_ON : ANDROID_CONTROL_AE_LOCK_OFF;
 	resultMetadata->addEntry(ANDROID_CONTROL_AE_LOCK, value);
 
 	value = ANDROID_CONTROL_AE_MODE_ON;
@@ -1488,7 +1497,7 @@
 			(uint8_t)ANDROID_CONTROL_AE_PRECAPTURE_TRIGGER_IDLE;
 	resultMetadata->addEntry(ANDROID_CONTROL_AE_PRECAPTURE_TRIGGER, value);
 
-	value = ANDROID_CONTROL_AE_STATE_CONVERGED;
+	value = aeLocked ? ANDROID_CONTROL_AE_STATE_LOCKED : ANDROID_CONTROL_AE_STATE_CONVERGED;
 	resultMetadata->addEntry(ANDROID_CONTROL_AE_STATE, value);
 
 	value = ANDROID_CONTROL_AF_MODE_OFF;

