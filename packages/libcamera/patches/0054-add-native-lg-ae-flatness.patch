From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add native LG AE histogram flatness

Reproduce the histogram window decision, bright-tail correction, temporal
filter and hysteresis that produce deltaMaxForFlat for rear LG AWB.
Generate each sensor configuration from its LG AEC parameter library.

diff --git a/src/libcamera/pipeline/qcom/lg_ae_flat.h b/src/libcamera/pipeline/qcom/lg_ae_flat.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_ae_flat.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace libcamera::qcom {
+
+struct LgAeFlatConfiguration {
+	int firstBin, lastBin;
+	float enterThreshold, exitThreshold;
+	int windowWidth;
+	float filterFactor;
+	int extension;
+	bool brightCorrection;
+	int brightBin, brightPenalty;
+};
+
+struct LgAeFlatResult {
+	float metric = 0;
+	uint32_t flat = 0;
+	int32_t firstBin = 0;
+};
+
+class LgAeFlat
+{
+public:
+	explicit LgAeFlat(const LgAeFlatConfiguration &config) : config_(config) {}
+
+	void reset() { result_ = {}; }
+
+	const LgAeFlatResult &process(const std::array<uint32_t, 256> &histogram)
+	{
+		std::array<uint32_t, 256> cumulative;
+		uint32_t total = 0;
+		for (unsigned int i = 0; i < histogram.size(); i++)
+			cumulative[i] = total += histogram[i];
+		float maximum = 0;
+		result_.firstBin = 0;
+		int last = config_.lastBin + (result_.flat == 1 ? config_.extension : 0);
+		if (total) {
+			for (int bin = config_.firstBin; bin <= last; bin++) {
+				int first = bin - config_.windowWidth;
+				float fraction = static_cast<float>(cumulative[bin] - cumulative[first]) /
+						 static_cast<float>(total);
+				if (fraction > maximum) {
+					maximum = fraction;
+					result_.firstBin = first;
+				}
+			}
+		}
+		float bright = total ? static_cast<float>(total - cumulative[config_.brightBin]) /
+				       static_cast<float>(total) : 0;
+		if (static_cast<double>(bright) > 0.1)
+			bright = 0.1f;
+		if (!config_.brightCorrection)
+			bright = 0;
+		float corrected = maximum / std::fma(bright, static_cast<float>(config_.brightPenalty), 1.0f);
+		/* Preserve the factory's separate product followed by a fused history blend. */
+		volatile float current = config_.filterFactor * corrected;
+		result_.metric = std::fma(result_.metric, 1.0f - config_.filterFactor, current);
+		result_.flat = result_.metric > config_.enterThreshold ||
+			(result_.flat == 1 && result_.metric > config_.exitThreshold);
+		return result_;
+	}
+
+private:
+	LgAeFlatConfiguration config_;
+	LgAeFlatResult result_;
+};
+
+} /* namespace libcamera::qcom */
