From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: bind IFE configuration to capture requests

Queue each PIX buffer and its IFE snapshot in one V4L2 media request.
Verify the applied configuration and input sequence on completion before
publishing white balance metadata. Reuse request fds with their buffers.

diff --git a/src/libcamera/pipeline/qcom/qcom.cpp b/src/libcamera/pipeline/qcom/qcom.cpp
--- a/src/libcamera/pipeline/qcom/qcom.cpp
+++ b/src/libcamera/pipeline/qcom/qcom.cpp
@@ -540,0 +541,4 @@
+	qcom_camss_ife_config ifeConfiguration() const;
+	int transferIfe(qcom_camss_ife_config &config, const V4L2Request *request, bool read);
+	int queueFrameBuffer(FrameBuffer *buffer);
+	int completeIfe(FrameBuffer *buffer, uint32_t sequence);
@@ -573 +577 @@
-	bool ifePending_ = true;
+	bool videoStarted_ = false;
@@ -596 +600,6 @@
-	std::map<uint32_t, IfeState> ifeStates_;
+	struct FrameContext {
+		std::unique_ptr<V4L2Request> request;
+		qcom_camss_ife_config config;
+		IfeState ife;
+	};
+	std::map<FrameBuffer *, FrameContext> frameContexts_;
@@ -1006,0 +1016,4 @@
+	if (!media_->supportsRequests()) {
+		LOG(QcomPipeline, Error) << "CAMSS media requests are required";
+		return -EOPNOTSUPP;
+	}
@@ -1158,6 +1170,0 @@
-	if (ifePending_) {
-		int ret = applyIfe(sequence + 1);
-		if (ret)
-			LOG(QcomPipeline, Error) << "IFE update for frame " << sequence + 1
-						 << " failed: " << ret;
-	}
@@ -1291 +1297,0 @@
-	ifePending_ = true;
@@ -1342,6 +1348,3 @@
-int QcomCameraData::applyIfe(uint32_t sequence)
-{
-	struct qcom_camss_ife_config config = {};
-	struct v4l2_ext_control control = {};
-	struct v4l2_ext_controls controls = {};
-
+qcom_camss_ife_config QcomCameraData::ifeConfiguration() const
+{
+	qcom_camss_ife_config config = {};
@@ -1349,3 +1352 @@
-	config.frame_sequence = sequence;
-	config.flags = QCOM_CAMSS_IFE_CONFIG_WHITE_BALANCE |
-		       QCOM_CAMSS_IFE_CONFIG_CCM;
+	config.flags = QCOM_CAMSS_IFE_CONFIG_WHITE_BALANCE | QCOM_CAMSS_IFE_CONFIG_CCM;
@@ -1357 +1358,8 @@
-
+	return config;
+}
+
+int QcomCameraData::transferIfe(qcom_camss_ife_config &config,
+			      const V4L2Request *request, bool read)
+{
+	struct v4l2_ext_control control = {};
+	struct v4l2_ext_controls controls = {};
@@ -1361,2 +1369 @@
-
-	controls.which = V4L2_CTRL_WHICH_CUR_VAL;
+	controls.which = request ? V4L2_CTRL_WHICH_REQUEST_VAL : V4L2_CTRL_WHICH_CUR_VAL;
@@ -1364 +1371 @@
-	controls.request_fd = -1;
+	controls.request_fd = request ? request->fd() : -1;
@@ -1366,2 +1373,37 @@
-
-	int ret = pix_->ioctl(VIDIOC_S_EXT_CTRLS, &controls);
+	return pix_->ioctl(read ? VIDIOC_G_EXT_CTRLS : VIDIOC_S_EXT_CTRLS, &controls);
+}
+
+int QcomCameraData::applyIfe(uint32_t sequence)
+{
+	auto config = ifeConfiguration();
+	config.frame_sequence = sequence;
+	return transferIfe(config, nullptr, false);
+}
+
+int QcomCameraData::queueFrameBuffer(FrameBuffer *buffer)
+{
+	auto [it, inserted] = frameContexts_.try_emplace(buffer);
+	FrameContext &context = it->second;
+	int ret;
+	if (inserted) {
+		std::vector<std::unique_ptr<V4L2Request>> requests;
+		ret = media_->allocateRequests(1, &requests);
+		if (ret) {
+			frameContexts_.erase(it);
+			return ret;
+		}
+		context.request = std::move(requests[0]);
+	} else {
+		ret = context.request->reinit();
+		if (ret)
+			return ret;
+	}
+	context.config = ifeConfiguration();
+	context.ife.red = context.config.wb_gain_q7[0] / 128.0;
+	context.ife.green = context.config.wb_gain_q7[1] / 128.0;
+	context.ife.blue = context.config.wb_gain_q7[3] / 128.0;
+	context.ife.cct = colourTemperature_;
+	context.ife.awbEnabled = awbEnabled_;
+	for (unsigned int i = 0; i < context.ife.ccm.size(); i++)
+		context.ife.ccm[i] = context.config.ccm_q7[i] / 128.0f;
+	ret = transferIfe(context.config, context.request.get(), false);
@@ -1370,14 +1412,42 @@
-	IfeState state;
-	state.red = config.wb_gain_q7[0] / 128.0;
-	state.blue = config.wb_gain_q7[3] / 128.0;
-	state.green = config.wb_gain_q7[1] / 128.0;
-	state.cct = colourTemperature_;
-	state.awbEnabled = awbEnabled_;
-	for (unsigned int i = 0; i < state.ccm.size(); i++)
-		state.ccm[i] = config.ccm_q7[i] / 128.0f;
-	ifeStates_[sequence] = state;
-	while (ifeStates_.size() > 64)
-		ifeStates_.erase(ifeStates_.begin());
-	ifePending_ = false;
-	LOG(QcomPipeline, Debug) << "IFE frame " << sequence << " gains "
-				 << state.red << " " << state.green << " " << state.blue;
+	ret = video_->queueBuffer(buffer, context.request.get());
+	if (ret)
+		return ret;
+	ret = context.request->queue();
+	if (!ret && !videoStarted_) {
+		ret = video_->streamOn();
+		if (!ret)
+			videoStarted_ = true;
+	}
+	if (ret) {
+		LOG(QcomPipeline, Error) << "Failed to start queued IFE request: " << ret;
+		/* streamOff() completes accepted buffers through bufferReady. */
+		int cancel = video_->streamOff();
+		if (cancel)
+			LOG(QcomPipeline, Error) << "Failed to cancel queued buffers: " << cancel;
+		else
+			videoStarted_ = false;
+	}
+	return 0;
+}
+
+int QcomCameraData::completeIfe(FrameBuffer *buffer, uint32_t sequence)
+{
+	auto it = frameContexts_.find(buffer);
+	if (it == frameContexts_.end())
+		return -ENOENT;
+	FrameContext &context = it->second;
+	qcom_camss_ife_config config = {};
+	int ret = transferIfe(config, context.request.get(), true);
+	if (ret)
+		return ret;
+	const auto &expected = context.config;
+	if (config.version != expected.version || config.flags != expected.flags ||
+	    config.frame_sequence != sequence ||
+	    memcmp(config.wb_gain_q7, expected.wb_gain_q7, sizeof(config.wb_gain_q7)) ||
+	    memcmp(config.wb_offset, expected.wb_offset, sizeof(config.wb_offset)) ||
+	    memcmp(config.ccm_q7, expected.ccm_q7, sizeof(config.ccm_q7)) ||
+	    memcmp(config.ccm_offset, expected.ccm_offset, sizeof(config.ccm_offset)))
+		return -EIO;
+	LOG(QcomPipeline, Debug) << "IFE request frame " << sequence << " gains "
+		<< context.ife.red << " " << context.ife.green << " " << context.ife.blue
+		<< " CCT " << context.ife.cct << " AWB " << context.ife.awbEnabled;
@@ -1946 +2015,0 @@
-		ifePending_ |= enabled != awbEnabled_;
@@ -2040,6 +2109 @@
-	auto ife = ifeStates_.upper_bound(sequence);
-	if (ife == ifeStates_.begin()) {
-		LOG(QcomPipeline, Error) << "Missing IFE configuration for frame " << sequence;
-		return;
-	}
-	const IfeState &appliedIfe = std::prev(ife)->second;
+	const IfeState &appliedIfe = frameContexts_.at(request->findBuffer(&stream_)).ife;
@@ -2100,0 +2165,10 @@
+	uint32_t sequence = qcom::inputSequence(buffer->metadata().sequence + video_->sequenceOffset());
+	int ret = completeIfe(buffer, sequence);
+	if (ret) {
+		LOG(QcomPipeline, Error) << "IFE request verification for frame " << sequence
+					 << " failed: " << ret;
+		buffer->_d()->metadata().status = FrameMetadata::FrameError;
+		pipe->completeBuffer(request, buffer);
+		pipe->completeRequest(request);
+		return;
+	}
@@ -2104,2 +2178 @@
-	updateMetadata(request, qcom::inputSequence(
-		buffer->metadata().sequence + video_->sequenceOffset()));
+	updateMetadata(request, sequence);
@@ -2188,2 +2261 @@
-	data->ifeStates_.clear();
-	data->ifePending_ = true;
+	data->frameContexts_.clear();
@@ -2226,6 +2297,0 @@
-	ret = data->video_->streamOn();
-	if (ret < 0) {
-		data->pix_->setFrameStartEnabled(false);
-		data->video_->releaseBuffers();
-		return ret;
-	}
@@ -2262,0 +2329 @@
+	data->videoStarted_ = false;
@@ -2264,0 +2332 @@
+	data->frameContexts_.clear();
@@ -2286 +2354 @@
-	return data->video_->queueBuffer(buffer);
+	return data->queueFrameBuffer(buffer);
