+		{ 0.0f, 999.0f, { 5.0f, 5.0f, 5.0f } },
+	} };
+	config.faceStatistics.maximumRgb = { {
+		{ 0.0f, 999.0f, { 240.0f, 240.0f, 240.0f } },
+	} };
