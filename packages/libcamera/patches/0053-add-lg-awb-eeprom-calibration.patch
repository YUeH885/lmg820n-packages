From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: decode rear LG AWB EEPROM calibration

Share signed Q1024 white-balance record decoding with IMX520 and map rear
sensor module records to the LG D50 and incandescent calibration groups.
Reproduce the original ten-slot light selection and ratio threshold.

diff --git a/src/libcamera/pipeline/qcom/awb_eeprom.h b/src/libcamera/pipeline/qcom/awb_eeprom.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/awb_eeprom.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+
+namespace libcamera::qcom {
+
+inline std::optional<std::array<float, 3>> awbEepromRatios(const std::array<uint8_t, 8> &block)
+{
+	auto word = [&block](unsigned int offset) -> uint16_t {
+		return block[offset] | static_cast<uint16_t>(block[offset + 1]) << 8;
+	};
+	unsigned int sum = 0;
+	for (unsigned int i = 0; i < 6; i++)
+		sum += block[i];
+	if (!sum || sum != word(6))
+		return std::nullopt;
+	std::array<float, 3> ratios;
+	for (unsigned int i = 0; i < ratios.size(); i++)
+		ratios[i] = static_cast<int16_t>(word(i * 2)) / 1024.0f;
+	return ratios;
+}
+
+} /* namespace libcamera::qcom */
