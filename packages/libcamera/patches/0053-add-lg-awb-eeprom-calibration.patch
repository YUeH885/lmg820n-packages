diff --git a/src/libcamera/pipeline/qcom/lg_awb_calibration.h b/src/libcamera/pipeline/qcom/lg_awb_calibration.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_calibration.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+
+#include "awb_eeprom.h"
+#include "lg_awb_colour.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbCalibrationLight {
+	uint32_t valid, cct;
+	LgAwbRatios measured;
+};
+
+inline LgAwbWhiteBalanceCalibration lgAwbSelectCalibration(const std::array<LgAwbCalibrationLight, 10> &lights)
+{
+	LgAwbWhiteBalanceCalibration result;
+	for (const auto &light : lights) {
+		if (light.valid != 1 || !(light.measured.red > 0.01f && light.measured.blue > 0.01f))
+			continue;
+		if (light.cct != 5000 && light.cct != 2850)
+			continue;
+		unsigned int index = light.cct == 5000 ? 0 : 1;
+		result.valid[index] = 1;
+		result.measured[index] = light.measured;
+	}
+	return result;
+}
+
+inline std::optional<LgAwbWhiteBalanceCalibration>
+lgAwbEepromCalibration(const std::array<std::array<uint8_t, 8>, 2> &blocks)
+{
+	std::array<LgAwbCalibrationLight, 10> lights{};
+	constexpr std::array<uint32_t, 2> ccts{ 5000, 2850 };
+	for (unsigned int i = 0; i < blocks.size(); i++) {
+		auto ratios = awbEepromRatios(blocks[i]);
+		if (!ratios)
+			return std::nullopt;
+		lights[i] = { 1, ccts[i], { (*ratios)[0], (*ratios)[1] } };
+	}
+	return lgAwbSelectCalibration(lights);
+}
+
+} /* namespace libcamera::qcom */
