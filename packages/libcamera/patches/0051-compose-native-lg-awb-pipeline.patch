+		 imx363LgAwbGainConfiguration(), imx363LgAwbOheConfiguration(),
+		 imx363LgAwbDtbConfiguration(), imx363LgAwbScdConfiguration(),
+		 imx363LgAwbFoeConfiguration() };
+}
+
@@ -1861,0 +1871,8 @@
+inline LgAwbPipelineConfiguration imx351LgAwbPipelineConfiguration()
+{
+	return { imx351LgAwbGrayCoreConfiguration(), imx351LgAwbHistoryConfiguration(),
+		 imx351LgAwbGainConfiguration(), imx351LgAwbOheConfiguration(),
+		 imx351LgAwbDtbConfiguration(), imx351LgAwbScdConfiguration(),
+		 imx351LgAwbFoeConfiguration() };
+}
+
@@ -2853,0 +2871,8 @@
+inline LgAwbPipelineConfiguration s5k3m5LgAwbPipelineConfiguration()
+{
+	return { s5k3m5LgAwbGrayCoreConfiguration(), s5k3m5LgAwbHistoryConfiguration(),
+		 s5k3m5LgAwbGainConfiguration(), s5k3m5LgAwbOheConfiguration(),
+		 s5k3m5LgAwbDtbConfiguration(), s5k3m5LgAwbScdConfiguration(),
+		 s5k3m5LgAwbFoeConfiguration() };
+}
+
