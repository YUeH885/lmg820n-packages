+double aeExposureForIndex(const SensorProfile &profile, double index)
+{
+	const AeExposureKnee *knees = profile.aeExposureKnees;
+	if (index <= knees[0].index)
+		return profileTotalExposure(knees[0]);
+	for (std::size_t i = 0; i + 1 < profile.aeExposureKneeCount; i++) {
+		if (index <= knees[i + 1].index) {
+			double t = (index - knees[i].index) /
+				   (knees[i + 1].index - knees[i].index);
+			return profileTotalExposure(knees[i]) *
+			       std::pow(profileTotalExposure(knees[i + 1]) /
+					profileTotalExposure(knees[i]), t);
+		}
+	}
+	return profileTotalExposure(knees[profile.aeExposureKneeCount - 1]);
+}
+
 double aeLuxIndex(const SensorProfile &profile, double exposureIndex,
 		  double luma10)
 {
@@ -1427,7 +1450,8 @@ bool QcomCameraData::updateAe(uint32_t sequence, double luma)
 	double gain = gainFromCode(
 		profile_, applied.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>());
 	double total = exposure * gain;
-	double index = aeLuxIndex(profile_, aeExposureIndex(profile_, total), luma);
+	float appliedIndex = aeExposureIndex(profile_, total);
+	double index = aeLuxIndex(profile_, appliedIndex, luma);
 	luxIndex_ = luxIndex_ ? *luxIndex_ * profile_.aeLuxFilterFactor +
 			       index * (1.0 - profile_.aeLuxFilterFactor) : index;
 	float luxTarget = aeTargetForLux(profile_, *luxIndex_);
@@ -1444,11 +1468,35 @@ bool QcomCameraData::updateAe(uint32_t sequence, double luma)
 				 << " target " << histogramTarget;
 
 	double ratio = target / std::max(luma, profile_.aeLuxLumaMinimum8 * kAeTargetScale);
-	if (aeWithinTolerance(ratio, profile_.aeLuxLogScale, profile_.aeToleranceSteps))
-		return true;
-
-	double stepRatio = std::pow(ratio, profile_.aeAggressiveness);
-	double corrected = total * stepRatio;
+	float targetIndex = appliedIndex + profile_.aeLuxLogScale * std::log10(ratio);
+	int32_t previousExposure = std::lround(aeExposure_);
+	int32_t previousGain = gainToCode(profile_, aeGain_);
+	double requested = previousExposure * lineDurationNs_ *
+		gainFromCode(profile_, previousGain);
+	float currentIndex = aeExposureIndex(profile_, requested);
+	float minimumIndex = aeExposureIndex(profile_, exposureMin_ * lineDurationNs_ * gainMin_);
+	float maximumIndex = aeExposureIndex(profile_, exposureMax_ * lineDurationNs_ * gainMax_);
+	const auto &delays = sensor_->sensorDelays();
+	/* Include the statistics age and the next SOF control write. */
+	unsigned int latency = std::max(delays.exposureDelay, delays.gainDelay) +
+		frameStates_.rbegin()->first - sequence + 1;
+	AeConvergenceTuning convergence{ static_cast<float>(profile_.aeUnitStep),
+		static_cast<float>(profile_.aeToleranceSteps),
+		static_cast<float>(profile_.aeAggressiveness) };
+	auto result = aeConvergeFast(convergence, currentIndex, appliedIndex, targetIndex,
+				     minimumIndex, maximumIndex, latency);
+	LOG(QcomPipeline, Debug) << std::setprecision(9)
+		<< "AE convergence frame " << sequence << " current " << currentIndex
+		<< " applied " << appliedIndex << " target " << targetIndex
+		<< " bounds " << minimumIndex << " " << maximumIndex
+		<< " latency " << latency << " output " << result.index
+		<< " settled " << result.settled;
+	double corrected = aeExposureForIndex(profile_, result.index);
+	/* Preserve exact control limits when their float indices are rounded. */
+	if (result.index == minimumIndex)
+		corrected = exposureMin_ * lineDurationNs_ * gainMin_;
+	else if (result.index == maximumIndex)
+		corrected = exposureMax_ * lineDurationNs_ * gainMax_;
 	double allocatedGain, allocatedExposure;
 	aeAllocateExposure(profile_, corrected, allocatedGain, allocatedExposure);
 
@@ -1462,17 +1510,14 @@ bool QcomCameraData::updateAe(uint32_t sequence, double luma)
 
 	aeExposure_ = allocatedExposure / lineDurationNs_;
 	aeGain_ = allocatedGain;
-	if (static_cast<int32_t>(std::lround(aeExposure_)) ==
-		    applied.get(V4L2_CID_EXPOSURE).get<int32_t>() &&
-	    gainToCode(profile_, aeGain_) ==
-		    applied.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>())
-		return true;
-	pushSensorControls();
+	if (static_cast<int32_t>(std::lround(aeExposure_)) != previousExposure ||
+	    gainToCode(profile_, aeGain_) != previousGain)
+		pushSensorControls();
 
 	LOG(QcomPipeline, Debug) << "AE luma " << luma << " target " << target
 				 << " index " << *luxIndex_ << " exposure "
 				 << aeExposure_ << " gain " << aeGain_;
