From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: apply the factory fast AE convergence path

Use the Chromatix base index step and tolerance multiplier. Converge from
the latest requested exposure while limiting the step by the measured
frame exposure and pipeline latency. Round and cap indices in the factory
domain, and report settling from the delayed exposure and table limits.

diff --git a/src/libcamera/pipeline/qcom/ae_convergence.h b/src/libcamera/pipeline/qcom/ae_convergence.h
new file mode 100644
index 0000000..620fa8b
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/ae_convergence.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace libcamera::qcom {
+
+struct AeConvergenceTuning {
+	float unitStep;
+	float toleranceSteps;
+	float aggressiveness;
+};
+
+struct AeConvergenceResult {
+	float index;
+	bool settled;
+};
+
+inline AeConvergenceResult aeConvergeFast(const AeConvergenceTuning &tuning,
+					 float current, float applied, float target,
+					 float minimum, float maximum,
+					 unsigned int latency)
+{
+	float tolerance = tuning.unitStep * tuning.toleranceSteps;
+	float delta = target - current;
+	float index = current;
+	if (std::abs(delta) >= tolerance) {
+		float appliedDelta = target - applied;
+		float step = 0.0f;
+		if (delta * appliedDelta >= 0.0f) {
+			step = delta * tuning.aggressiveness;
+			float limit = appliedDelta / static_cast<float>(latency);
+			if (std::abs(step) > std::abs(limit))
+				step = limit;
+			if (std::abs(step) < tuning.unitStep)
+				step = step > 0.0f ? tuning.unitStep : -tuning.unitStep;
+		}
+		index += step;
+	}
+	index = std::clamp(std::round(index / tuning.unitStep) * tuning.unitStep,
+			   minimum, maximum);
+	float settledRange = 2.0f * tolerance;
+	return { index, index + settledRange >= maximum ||
+			index - settledRange <= minimum ||
+			std::abs(index - applied) <= settledRange };
+}
+
+} /* namespace libcamera::qcom */
