From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add factory AWB reference locus

Select reference segments with the QTI normal boundaries and reproduce
signed distance, Kelvin interpolation and illuminant selection in the
calibrated reference domain. Preserve factory single-precision arithmetic.

diff --git a/src/libcamera/pipeline/qcom/awb_locus.h b/src/libcamera/pipeline/qcom/awb_locus.h
new file mode 100644
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/awb_locus.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace libcamera::qcom {
+
+struct QtiAwbPoint {
+	float rg;
+	float bg;
+};
+
+struct QtiAwbLocusResult {
+	float distance;
+	float cct;
+	unsigned int illuminant;
+};
+
+class QtiAwbLocus
+{
+public:
+	explicit QtiAwbLocus(const std::array<QtiAwbPoint, 15> &points)
+		: points_(points)
+	{
+		constexpr std::array<unsigned int, 8> anchors{ 0, 1, 2, 3, 5, 7, 8, 9 };
+		constexpr std::array<unsigned int, 8> first{ 0, 1, 2, 2, 3, 5, 7, 8 };
+		constexpr std::array<unsigned int, 8> last{ 1, 2, 3, 3, 5, 7, 8, 9 };
+		for (unsigned int i = 0; i < normals_.size(); i++) {
+			float slope = (points_[last[i]].bg - points_[first[i]].bg) /
+				      (points_[last[i]].rg - points_[first[i]].rg);
+			float normal = -1.0f / slope;
+			normals_[i] = { normal, std::fma(-points_[anchors[i]].rg,
+						       normal, points_[anchors[i]].bg) };
+		}
+	}
+
+	QtiAwbLocusResult project(QtiAwbPoint point, unsigned int first,
+				 unsigned int last) const
+	{
+		QtiAwbPoint a = points_[first];
+		QtiAwbPoint b = points_[last];
+		float dx = b.rg - a.rg;
+		float dy = b.bg - a.bg;
+		float length = std::fma(dx, dx, dy * dy);
+		float slope = dy / dx;
+		float intercept = std::fma(-b.rg, slope, b.bg);
+		float residual = std::fma(point.rg, slope, -point.bg) + intercept;
+		float signedResidual = slope * residual;
+		float ar = point.rg - a.rg;
+		float ab = point.bg - a.bg;
+		float br = point.rg - b.rg;
+		float bb = point.bg - b.bg;
+		float firstDistance = std::fma(ar, ar, ab * ab);
+		float lastDistance = std::fma(br, br, bb * bb);
+		/* The factory uses squared endpoint distance when the residual is exactly zero. */
+		float numerator = signedResidual != 0
+					? (length + (firstDistance - lastDistance)) * 0.5f
+					: firstDistance;
+		float coefficient = numerator / length;
+		float twice = coefficient + coefficient;
+		float polynomial = std::fma(coefficient, twice, -twice) + 1.0f;
+		float radicand = std::fma(-length, polynomial, firstDistance + lastDistance) * 0.5f;
+		float distance = std::sqrt(radicand);
+		if (coefficient < 0) {
+			coefficient = 0;
+			distance = std::sqrt(firstDistance);
+		}
+		distance *= signedResidual > 0 ? 1.0f : -1.0f;
+		/* Match the factory result when cancellation makes the radicand negative. */
+		if (std::isnan(distance))
+			distance = 0;
+		float weight = std::clamp(coefficient, 0.0f, 1.0f);
+		float cct = std::fma(weight, ccts_[last], (1.0f - weight) * ccts_[first]);
+		return { distance, cct, coefficient > 0.5f ? last : first };
+	}
+
+	QtiAwbLocusResult evaluate(QtiAwbPoint point) const
+	{
+		int boundary = 4;
+		int direction = 0;
+		while (boundary >= 0 && boundary < static_cast<int>(normals_.size())) {
+			float product = point.rg * normals_[boundary].rg;
+			float residual = (product - point.bg) + normals_[boundary].bg;
+			if (residual > 0) {
+				if (direction < 0)
+					break;
+				direction = 1;
+				boundary++;
+			} else if (residual < 0) {
+				if (direction > 0)
+					break;
+				direction = -1;
+				boundary--;
+			} else {
+				break;
+			}
+		}
+		if (boundary == -1 || boundary == 8) {
+			unsigned int endpoint = boundary == -1 ? 0 : 9;
+			float dx = point.rg - points_[endpoint].rg;
+			float dy = point.bg - points_[endpoint].bg;
+			return { std::sqrt(std::fma(dx, dx, dy * dy)), ccts_[endpoint],
+				 endpoint == 0 ? 1U : 8U };
+		}
+		constexpr std::array<unsigned int, 8> first{ 0, 1, 2, 3, 3, 5, 7, 8 };
+		constexpr std::array<unsigned int, 8> last{ 1, 2, 3, 5, 5, 7, 8, 9 };
+		return project(point, first[boundary], last[boundary]);
+	}
+
+private:
+	static constexpr std::array<float, 10> ccts_{
+		12000, 7500, 6500, 5000, 0, 4000, 0, 2850, 2300, 1500,
+	};
+	std::array<QtiAwbPoint, 15> points_;
+	std::array<QtiAwbPoint, 8> normals_;
+};
+
+} /* namespace libcamera::qcom */
