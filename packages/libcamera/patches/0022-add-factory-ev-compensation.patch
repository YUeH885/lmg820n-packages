From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: expose factory EV compensation controls

Map ExposureValue to the shared factory 1/6 EV table and add its index
offset after histogram target calculation. Ignore EV changes in manual
exposure mode and report the active EV with the frame AE mode.

diff --git a/src/libcamera/pipeline/qcom/ae_exposure_compensation.h b/src/libcamera/pipeline/qcom/ae_exposure_compensation.h
new file mode 100644
index 0000000..147ff5d
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/ae_exposure_compensation.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace libcamera::qcom {
+
+/* Shared Metering v8 EV tuning from all four factory Chromatix files. */
+constexpr int kAeStepsPerEv = 6;
+constexpr float kAeMinEv = -2.0f;
+constexpr float kAeMaxEv = 2.0f;
+constexpr std::array<float, 25> kAeEvMultipliers = {
+	0.25f, 0.2806f, 0.315f, 0.3536f, 0.3969f, 0.4454f,
+	0.5f, 0.5612f, 0.6299f, 0.7071f, 0.7937f, 0.8909f,
+	1.0f, 1.1225f, 1.2599f, 1.4142f, 1.5874f, 1.7818f,
+	2.0f, 2.2449f, 2.5198f, 2.8284f, 3.1748f, 3.5636f, 4.0f,
+};
+
+inline int aeEvStep(float ev)
+{
+	return std::lround(std::clamp(ev, kAeMinEv, kAeMaxEv) * kAeStepsPerEv);
+}
+
+inline float aeEvValue(int step)
+{
+	return static_cast<float>(step) / kAeStepsPerEv;
+}
+
+inline float aeEvOffset(int step, double logScale)
+{
+	unsigned int index = step - static_cast<int>(kAeMinEv * kAeStepsPerEv);
+	return logScale * std::log10(static_cast<double>(kAeEvMultipliers[index]));
+}
+
+} /* namespace libcamera::qcom */
