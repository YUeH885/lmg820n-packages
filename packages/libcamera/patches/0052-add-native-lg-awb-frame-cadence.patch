From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add native LG AWB startup and frame cadence

Generate the four sensor cadence periods and reproduce startup counting,
fps and lux selection, camera and input-mode rules, flash pauses and
forced skips. Compute startup, skipped and gray-zone widening inside the
streaming pipeline instead of accepting externally computed flags.

diff --git a/src/libcamera/pipeline/qcom/lg_awb_cadence.h b/src/libcamera/pipeline/qcom/lg_awb_cadence.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_cadence.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+namespace libcamera::qcom {
+
+struct LgAwbCadenceControls {
+	unsigned int fps, cameraId, mode, flashState;
+	int lux;
+	bool forceSkip;
+};
+
+struct LgAwbCadenceResult {
+	bool startup = true, skipped = false;
+	uint32_t counter = 0;
+};
+
+class LgAwbCadence
+{
+public:
+	explicit LgAwbCadence(const std::array<int16_t, 4> &periods)
+		: periods_(periods)
+	{
+	}
+
+	void reset() { state_ = {}; }
+
+	const LgAwbCadenceResult &update(const LgAwbCadenceControls &controls)
+	{
+		unsigned int index = controls.fps <= 44 ? 0 : controls.fps <= 89 ? 1 : controls.fps <= 179 ? 2 : 3;
+		unsigned int period = periods_[index];
+		if (controls.lux > 350)
+			period >>= 2;
+		unsigned int skip = period ? std::max(period - 1, 3U) : 3;
+		if (!controls.mode && controls.fps < 61)
+			skip = 2;
+		if (controls.cameraId == 1 || controls.cameraId == 4)
+			skip = 0;
+		state_.skipped = false;
+		if (controls.flashState == 0 || controls.flashState == 5) {
+			if (state_.startup) {
+				if (state_.counter <= 8) {
+					state_.counter++;
+				} else {
+					state_.counter = 0;
+					state_.startup = false;
+				}
+			} else if (state_.counter < skip) {
+				state_.counter++;
+				state_.skipped = true;
+			} else {
+				state_.counter = 0;
+			}
+		}
+		state_.skipped |= controls.forceSkip;
+		return state_;
+	}
+
+private:
+	std::array<int16_t, 4> periods_;
+	LgAwbCadenceResult state_;
+};
+
+} /* namespace libcamera::qcom */
