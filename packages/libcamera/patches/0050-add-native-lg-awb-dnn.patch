From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add native LG AWB DNN fusion

Consume both plugin policies and IQM scene scores and gains. Preserve
source memory, confidence and lux weighting, scene-zero geometry and
distance limits, and the saturating no-fusion counter. Expose the policy
frame count and current counter for the subsequent convergence step.

diff --git a/src/libcamera/pipeline/qcom/lg_awb_dnn.h b/src/libcamera/pipeline/qcom/lg_awb_dnn.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_dnn.h
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+
+#include "lg_awb_convergence.h"
+#include "lg_awb_target.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbDnnPolicy {
+	bool enabled;
+	float threshold;
+	LgAwbRatios weights;
+	float maximumDistance;
+	std::array<int32_t, 4> lux;
+	int32_t frames;
+};
+
+class LgAwbDnn
+{
+public:
+	LgAwbDnn(const std::array<LgAwbDnnPolicy, 2> &policies,
+		 const std::array<std::array<float, 2>, 3> &limits)
+		: policies_(policies), limits_(limits)
+	{
+	}
+
+	void reset() { previousSource_ = 0; counter_ = 0; }
+	unsigned int previousSource() const { return previousSource_; }
+	LgAwbGainTiming timing() const { return { counter_, policies_[1].frames }; }
+
+	void apply(LgAwbGainTarget &target, const std::optional<std::array<float, 4>> &iqm,
+		   int lux, bool startup, unsigned int flashState)
+	{
+		if (!iqm)
+			return;
+		counter_ = std::min(counter_ + 1, policies_[1].frames + 1);
+		if (target.source != LgAwbGainSource::Previous)
+			previousSource_ = static_cast<unsigned int>(target.source);
+		if (previousSource_ != 1 || startup || flashState)
+			return;
+		float red = (*iqm)[2], blue = (*iqm)[3];
+		if (!(red > limits_[0][0] && red < limits_[0][1] && blue > limits_[2][0] && blue < limits_[2][1]))
+			return;
+		int scene = -1;
+		float confidence = 0;
+		for (unsigned int i = 0; i < policies_.size(); i++) {
+			if (policies_[i].enabled && (*iqm)[i] > confidence && (*iqm)[i] > policies_[i].threshold) {
+				scene = i;
+				confidence = (*iqm)[i];
+			}
+		}
+		if (scene < 0)
+			return;
+		const auto &policy = policies_[scene];
+		if (lux < policy.lux[0] || lux > policy.lux[3])
+			return;
+		float luxWeight = 1;
+		if (lux < policy.lux[1])
+			luxWeight = interpolate(lux, policy.lux[0], policy.lux[1]);
+		else if (lux > policy.lux[2])
+			luxWeight = 1.0f - interpolate(lux, policy.lux[2], policy.lux[3]);
+		LgAwbRatios weights{ lgAwbProduct(policy.weights.red, luxWeight),
+				     lgAwbProduct(policy.weights.blue, luxWeight) };
+		if (scene == 0) {
+			if (target.rgb[0] / target.rgb[2] > red / blue)
+				return;
+			if (red < target.rgb[0]) {
+				blue = lgAwbProduct(blue, target.rgb[0]) / red;
+				red = target.rgb[0];
+			} else {
+				blue = std::min(blue, target.rgb[2]);
+			}
+			float dx = red - target.rgb[0], dy = blue - target.rgb[2];
+			float distance = std::sqrt(lgAwbProduct(dx, dx) + lgAwbProduct(dy, dy));
+			if (distance > policy.maximumDistance) {
+				float factor = policy.maximumDistance / distance;
+				red = target.rgb[0] + lgAwbProduct(dx, factor);
+				blue = target.rgb[2] + lgAwbProduct(dy, factor);
+			}
+		}
+		float factor = interpolate(confidence, policy.threshold, 1.0f);
+		float resultRed = target.rgb[0] + lgAwbProduct(lgAwbProduct(weights.red, factor), red - target.rgb[0]);
+		float resultBlue = target.rgb[2] + lgAwbProduct(lgAwbProduct(weights.blue, factor), blue - target.rgb[2]);
+		target.cct = static_cast<int32_t>(lgAwbProduct(resultRed / target.rgb[0], target.cct));
+		target.rgb = { resultRed, 1, resultBlue };
+		target.source = static_cast<LgAwbGainSource>(static_cast<unsigned int>(target.source) + 10);
+		counter_ = 0;
+	}
+
+private:
+	static float interpolate(float value, float first, float last)
+	{
+		if (first >= last - 1e-6f && first <= last + 1e-6f)
+			return 0.5f;
+		return (value - first) / (last - first);
+	}
+
+	std::array<LgAwbDnnPolicy, 2> policies_;
+	std::array<std::array<float, 2>, 3> limits_;
+	unsigned int previousSource_ = 0;
+	int32_t counter_ = 0;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_dnn_tuning.h b/src/libcamera/pipeline/qcom/lg_awb_dnn_tuning.h
--- /dev/null
