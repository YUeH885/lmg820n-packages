+		{ true, 0.100000001f, { 1.0f, 1.0f }, 0.280000001f, { 160, 180, 700, 700 }, 10 },
+		{ true, 0.100000001f, { 1.0f, 1.0f }, 0.5f, { 160, 180, 700, 700 }, 10 },
+	} };
+}
+
