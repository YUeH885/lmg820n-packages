From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add generated IMX520 AWB configuration

Bundle factory front-camera AWB reference, filtering, mixed-light, scene,
aggregation, temporal and gain tables as a typed configuration. The tuning
header is generated from the matching IMX520 Chromatix input.

diff --git a/src/libcamera/pipeline/qcom/awb_front_configuration.h b/src/libcamera/pipeline/qcom/awb_front_configuration.h
new file mode 100644
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/awb_front_configuration.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "awb_gain_adjustment.h"
+#include "awb_mlc.h"
+#include "awb_scenes.h"
+#include "awb_statistics.h"
+#include "awb_temporal.h"
+
+namespace libcamera::qcom {
+
+struct QtiAwbSceneZone {
+	unsigned int group;
+	QtiAwbGeometry geometry;
+	QtiAwbCoordinateTable<1> coordinates;
+};
+
+struct QtiAwbFrontScene {
+	QtiAwbSceneConfiguration analysis;
+	std::vector<QtiAwbSceneZone> zones;
+};
+
+struct QtiAwbFrontConfiguration {
+	std::array<QtiAwbPoint, 15> reference;
+	QtiAwbScreening screening;
+	QtiAwbRegionWeights regionWeights;
+	QtiAwbCoordinateTable<1> mlcDetection;
+	QtiAwbCoordinateTable<3> mlcExclusion;
+	std::vector<QtiAwbFrontScene> scenes;
+	QtiAwbSceneConfidence agw;
+	QtiAwbAggregationConfiguration aggregation;
+	QtiAwbTemporalConfiguration temporal;
+	QtiAwbGainConfiguration gain;
+};
+
+} /* namespace libcamera::qcom */
