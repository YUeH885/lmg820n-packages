From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add native LG AWB face assist and FWB exception

Implement LG AWB face tracking with 5-frame debounce filter, grid coordinate
scaling and boundary shrinking. In RGB preprocessing, screen face regions
and remove valid samples from subsequent gray zone classification.
Calculate target gain from observed skin ratios and sensor D50 reference,
and apply FWB modes 0, 1 and 2 (90-frame alternation) in pipeline exception
handling. Bind face detection controls and metadata to rear camera pipeline.

--- a/src/libcamera/pipeline/qcom/lg_awb_face.h
+++ b/src/libcamera/pipeline/qcom/lg_awb_face.h
@@ -0,0 +1,238 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_math.h"
+#include "lg_awb_target.h"
+#include "lg_awb_types.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbFaceInput {
+	uint32_t x;
+	uint32_t y;
+	uint32_t width;
+	uint32_t height;
+};
+
+struct LgAwbFaceBox {
+	uint32_t left = 1;
+	uint32_t top = 1;
+	uint32_t right = 0;
+	uint32_t bottom = 0;
+
+	bool valid() const { return left <= right && top <= bottom && right < 64 && bottom < 48; }
+};
+
+struct LgAwbFwbConfiguration {
+	int16_t mode;
+	int16_t minimumValidRegionCount;
+	LgAwbRatios skinReference;
+	LgAwbRatios gainCoefficients;
+	int16_t maximumWeightPercent;
+};
+
+struct LgAwbFaceResult {
+	bool valid = false;
+	uint32_t sampleCount = 0;
+	LgAwbRgb rgb{ 1.0f, 1.0f, 1.0f };
+};
+
+class LgAwbFaceTracker
+{
+public:
+	LgAwbFaceTracker() = default;
+
+	void reset()
+	{
+		previousFaceCount_ = 0;
+		faceStabilityCount_ = 0;
+		activeCount_ = 0;
+		boxes_.fill({});
+	}
+
+	uint32_t activeCount() const { return activeCount_; }
+	const std::array<LgAwbFaceBox, 3> &boxes() const { return boxes_; }
+	const LgAwbFaceBox *data() const { return boxes_.data(); }
+
+	void update(const LgAwbFaceInput *faces, size_t count, uint32_t imageWidth, uint32_t imageHeight)
+	{
+		uint32_t inputCount = static_cast<uint32_t>(count);
+		if (inputCount == previousFaceCount_) {
+			if (faceStabilityCount_ < 100)
+				faceStabilityCount_++;
+		} else {
+			faceStabilityCount_ = 0;
+		}
+
+		previousFaceCount_ = inputCount;
+
+		if (faceStabilityCount_ <= 5)
+			return;
+
+		activeCount_ = std::min(inputCount, 3u);
+		if (imageWidth == 0 || imageHeight == 0 || activeCount_ == 0 || !faces) {
+			if (activeCount_ == 0)
+				boxes_.fill({});
+			return;
+		}
+
+		float scaleX = 64.0f / static_cast<float>(imageWidth);
+		float scaleY = 48.0f / static_cast<float>(imageHeight);
+
+		for (uint32_t i = 0; i < activeCount_; i++) {
+			float fx0 = static_cast<float>(faces[i].x) * scaleX + 0.5f;
+			float fy0 = static_cast<float>(faces[i].y) * scaleY + 0.5f;
+			float fx1 = static_cast<float>(faces[i].x + faces[i].width) * scaleX - 0.5f;
+			float fy1 = static_cast<float>(faces[i].y + faces[i].height) * scaleY - 0.5f;
+
+			if (fx1 < fx0 || fy1 < fy0 || fx1 < 0.0f || fy1 < 0.0f) {
+				boxes_[i] = {};
+				continue;
+			}
+
+			uint32_t x0 = static_cast<uint32_t>(std::max(0.0f, fx0));
+			uint32_t y0 = static_cast<uint32_t>(std::max(0.0f, fy0));
+			uint32_t x1 = static_cast<uint32_t>(std::max(0.0f, fx1));
+			uint32_t y1 = static_cast<uint32_t>(std::max(0.0f, fy1));
+
+			if (x1 < x0 || y1 < y0) {
+				boxes_[i] = {};
+				continue;
+			}
+
+			uint32_t dx = (x1 - x0) + 1;
+			uint32_t dy = (y1 - y0) + 1;
+			uint32_t shrinkX = dx >> 2;
+			uint32_t shrinkY = dy >> 2;
+
+			uint32_t left = std::min(x0 + shrinkX, 63u);
+			uint32_t top = std::min(y0 + shrinkY, 47u);
+			uint32_t right = std::min(x1 >= shrinkX ? x1 - shrinkX : 0u, 63u);
+			uint32_t bottom = std::min(y1 >= shrinkY ? y1 - shrinkY : 0u, 47u);
+
+			if (left > right || top > bottom) {
+				boxes_[i] = {};
+				continue;
+			}
+
+			boxes_[i] = { left, top, right, bottom };
+		}
+	}
+
+private:
+	uint32_t previousFaceCount_ = 0;
+	uint32_t faceStabilityCount_ = 0;
+	uint32_t activeCount_ = 0;
+	std::array<LgAwbFaceBox, 3> boxes_{};
+};
+
+template<typename SampleArray>
+inline LgAwbFaceResult lgAwbCheckFaceStat(const std::array<LgAwbRgb, 3072> &rgb,
+					 SampleArray &samples,
+					 const LgAwbFaceBox *boxes,
+					 uint32_t faceCount,
+					 const LgAwbFwbConfiguration &config,
+					 LgAwbRatios d50Reference)
+{
+	LgAwbFaceResult result{};
+	if (faceCount == 0 || !boxes)
+		return result;
+
+	uint32_t validFaceSamples = 0;
+	float sumR = 0.0f;
+	float sumG = 0.0f;
+	float sumB = 0.0f;
+
+	for (uint32_t i = 0; i < faceCount; i++) {
+		const auto &box = boxes[i];
+		if (!box.valid())
+			continue;
+		for (uint32_t y = box.top; y <= box.bottom; y++) {
+			for (uint32_t x = box.left; x <= box.right; x++) {
+				uint32_t idx = y * 64 + x;
+				if (samples[idx].valid == 1) {
+					samples[idx].valid = 0;
+					validFaceSamples++;
+					sumR += rgb[idx][0];
+					sumG += rgb[idx][1];
+					sumB += rgb[idx][2];
+				}
+			}
+		}
+	}
+
+	result.sampleCount = validFaceSamples;
+
+	float observedRg = 0.0f;
+	float observedBg = 0.0f;
+
+	if (validFaceSamples > static_cast<uint32_t>(config.minimumValidRegionCount)) {
+		float countF = static_cast<float>(validFaceSamples);
+		float avgR = sumR / countF;
+		float avgG = sumG / countF;
+		float avgB = sumB / countF;
+		observedRg = avgR / avgG;
+		observedBg = avgB / avgG;
+		result.valid = true;
+	} else {
+		observedRg = config.skinReference.red;
+		observedBg = config.skinReference.blue;
+		result.valid = false;
+	}
+
+	float s1 = (config.skinReference.red / d50Reference.red) / observedRg;
+	float s2 = (config.skinReference.blue / d50Reference.blue) / observedBg;
+
+	result.rgb[0] = lgAwbProduct(config.gainCoefficients.red, s1);
+	result.rgb[1] = 1.0f;
+	result.rgb[2] = lgAwbProduct(config.gainCoefficients.blue, s2);
+
+	return result;
+}
+
+class LgAwbFwb
+{
+public:
+	explicit LgAwbFwb(const LgAwbFwbConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void reset() { weight_ = 0.0f; }
+	float weight() const { return weight_; }
+
+	void apply(LgAwbGainTarget &target, const LgAwbFaceResult &faceResult, uint32_t frameCount)
+	{
+		weight_ = 0.0f;
+		if (config_.mode == 0)
+			return;
+
+		bool enabled = false;
+		if (config_.mode == 1) {
+			enabled = faceResult.valid;
+		} else if (config_.mode == 2) {
+			enabled = faceResult.valid && ((frameCount / 90) % 2 == 1);
+		}
+
+		if (!enabled)
+			return;
+
+		weight_ = lgAwbProduct(static_cast<float>(config_.maximumWeightPercent), 0.01f);
+		float oneMinusWeight = 1.0f - weight_;
+
+		target.rgb[0] = lgAwbProduct(target.rgb[0], oneMinusWeight) + lgAwbProduct(faceResult.rgb[0], weight_);
+		target.rgb[1] = lgAwbProduct(target.rgb[1], oneMinusWeight) + lgAwbProduct(faceResult.rgb[1], weight_);
+		target.rgb[2] = lgAwbProduct(target.rgb[2], oneMinusWeight) + lgAwbProduct(faceResult.rgb[2], weight_);
+	}
+
+private:
+	LgAwbFwbConfiguration config_;
+	float weight_ = 0.0f;
+};
+
