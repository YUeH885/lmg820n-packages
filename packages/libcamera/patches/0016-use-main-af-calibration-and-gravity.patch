new file mode 100644
index 0000000..761dcb4
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/ssc_accelerometer.cpp
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "ssc_accelerometer.h"
+
+#include <cerrno>
+#include <pthread.h>
+#include <utility>
+#include <libssc-sensor-accelerometer.h>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+namespace libcamera::qcom {
+
+LOG_DEFINE_CATEGORY(QcomAccelerometer)
+
+struct SscAccelerometer::State {
+	SscAccelerometer *owner;
+	std::promise<int> *ready;
+	GSource *timeout;
+};
+
+SscAccelerometer::SscAccelerometer()
+	: context_(g_main_context_new()), loop_(g_main_loop_new(context_, false))
+{
+}
+
+SscAccelerometer::~SscAccelerometer()
+{
+	stop();
+	g_main_loop_unref(loop_);
+	g_main_context_unref(context_);
+}
+
+int SscAccelerometer::start()
+{
+	std::promise<int> ready;
+	auto result = ready.get_future();
+	thread_ = std::thread(&SscAccelerometer::run, this, std::move(ready));
+	int ret = result.get();
+	if (ret)
+		stop();
+	return ret;
+}
+
+void SscAccelerometer::stop()
+{
+	if (!thread_.joinable())
+		return;
+	g_main_loop_quit(loop_);
+	thread_.join();
+}
+
+std::array<float, 3> SscAccelerometer::sample() const
+{
+	std::lock_guard lock(mutex_);
+	return sample_;
+}
+
+void SscAccelerometer::measured(void *, float x, float y, float z, void *data)
+{
+	State *state = static_cast<State *>(data);
+	{
+		std::lock_guard lock(state->owner->mutex_);
+		state->owner->sample_ = { x, y, z };
+	}
+	if (state->ready) {
+		g_source_destroy(state->timeout);
+		state->ready->set_value(0);
+		state->ready = nullptr;
+	}
+}
+
+int SscAccelerometer::timedOut(void *data)
+{
+	State *state = static_cast<State *>(data);
+	LOG(QcomAccelerometer, Error) << "Timed out waiting for the first acceleration sample";
+	state->ready->set_value(-ETIMEDOUT);
+	state->ready = nullptr;
+	g_main_loop_quit(state->owner->loop_);
+	return G_SOURCE_REMOVE;
+}
+
+void SscAccelerometer::run(std::promise<int> ready)
+{
+	pthread_setname_np(pthread_self(), "qcom-accel");
+	g_main_context_push_thread_default(context_);
+	auto contextGuard = utils::scope_exit{ [&]() { g_main_context_pop_thread_default(context_); } };
+	g_autoptr(GError) error = nullptr;
+	g_autoptr(SSCSensorAccelerometer) sensor = ssc_sensor_accelerometer_new_sync(nullptr, &error);
+	if (!sensor) {
+		LOG(QcomAccelerometer, Error) << "Failed to discover accelerometer: "
+					    << (error ? error->message : "sensor unavailable");
+		ready.set_value(-ENODEV);
+		return;
+	}
+	if (!ssc_sensor_accelerometer_open_sync(sensor, nullptr, &error)) {
+		LOG(QcomAccelerometer, Error) << "Failed to open accelerometer: " << error->message;
+		ready.set_value(-EIO);
+		return;
+	}
+
+	GSource *timeout = g_timeout_source_new(1000);
+	State state{ this, &ready, timeout };
+	g_source_set_callback(timeout, timedOut, &state, nullptr);
+	g_source_attach(timeout, context_);
+	gulong handler = g_signal_connect(sensor, "measurement", G_CALLBACK(measured), &state);
+	g_main_loop_run(loop_);
+	g_signal_handler_disconnect(sensor, handler);
+	g_source_unref(timeout);
+	if (!ssc_sensor_accelerometer_close_sync(sensor, nullptr, &error))
+		LOG(QcomAccelerometer, Error) << "Failed to close accelerometer: " << error->message;
+	while (g_main_context_iteration(context_, false))
+		;
+}
+
+} /* namespace libcamera::qcom */
