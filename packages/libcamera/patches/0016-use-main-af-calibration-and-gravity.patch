+void QcomCameraData::refreshAfModel()
+{
+	if (!accelerometer_)
+		return;
+	const auto sample = accelerometer_->sample();
+	afModel_->setAcceleration(sample[0], sample[1], sample[2]);
+	LOG(QcomPipeline, Debug) << "AF acceleration " << sample[0] << " "
+				 << sample[1] << " " << sample[2]
+				 << " offset " << afModel_->gravityOffset()
+				 << " bounds " << afModel_->nearPosition()
+				 << " " << afModel_->farPosition();
+}
+
+bool QcomCameraData::trackAfGravity()
+{
+	if (!accelerometer_ || afPaused_ || afState_ != controls::AfStateFocused)
+		return false;
+	LgAfModel updated = *afModel_;
+	const auto sample = accelerometer_->sample();
+	updated.setAcceleration(sample[0], sample[1], sample[2]);
+	int delta = updated.gravityOffset() - afModel_->gravityOffset();
+	if (std::abs(delta) < afModel_->gravityTrackingThreshold())
+		return false;
+	*afModel_ = updated;
+	int ret = setLensPosition(afPosition_ + 2 * delta);
+	if (ret) {
+		afState_ = controls::AfStateFailed;
+		LOG(QcomPipeline, Error) << "AF gravity move failed: " << ret;
+	} else {
+		afStep_ = afModel_->afCodeToStep(afPosition_);
+		afBestStep_ = afStep_;
+		afOriginalPosition_ = std::clamp(afOriginalPosition_ + 2 * delta,
+						 afModel_->codeMin(), afModel_->codeMax());
+		afSceneChange_.reset();
+		LOG(QcomPipeline, Debug) << "AF gravity tracked " << delta
+					 << " P at code " << afPosition_;
+	}
+	return true;
+}
