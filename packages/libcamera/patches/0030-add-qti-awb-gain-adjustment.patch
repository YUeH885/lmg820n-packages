From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] qcom: add factory AWB mesh gain adjustment

Walk the factory gain mesh from auxiliary centroids, interpolate vertex
gains and CCT compensation, and preserve boundary projection rules.
Keep reference normal products separate from subtraction on ARM64.

diff --git a/src/libcamera/pipeline/qcom/awb_gain_adjustment.h b/src/libcamera/pipeline/qcom/awb_gain_adjustment.h
new file mode 100644
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/awb_gain_adjustment.h
@@ -0,0 +1,198 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include "awb_locus.h"
+#include "awb_triggers.h"
+
+namespace libcamera::qcom {
+
+struct QtiAwbGainTriangle {
+	std::array<int32_t, 3> vertices;
+	std::array<int32_t, 3> neighbours;
+};
+
+struct QtiAwbGainVertex {
+	QtiAwbPoint point;
+	QtiAwbTriggerTable<1, 3> gains;
+};
+
+struct QtiAwbGainConfiguration {
+	std::vector<QtiAwbGainTriangle> triangles;
+	std::vector<QtiAwbGainVertex> vertices;
+	std::array<int32_t, 4> seeds;
+	QtiAwbTriggerTable<2, 3> compensation;
+};
+
+struct QtiAwbGainResult {
+	std::array<int32_t, 3> vertices;
+	std::array<float, 3> weights;
+	std::array<float, 3> gains;
+	std::array<float, 3> compensation;
+	QtiAwbPoint point;
+	float cct;
+	float inputCct;
+};
+
+class QtiAwbGainAdjustment
+{
+public:
+	explicit QtiAwbGainAdjustment(QtiAwbGainConfiguration config)
+		: config_(std::move(config))
+	{
+	}
+
+	QtiAwbGainResult run(float lux, QtiAwbPoint input, QtiAwbPoint referencePoint,
+			     const QtiAwbLocus &locus) const
+	{
+		QtiAwbGainResult result{};
+		result.inputCct = locus.evaluate(input).cct;
+		float triggers[] = { lux, result.inputCct };
+		result.compensation = qtiAwbEvaluateTrigger(config_.compensation, triggers);
+		for (float &value : result.compensation)
+			if (value < 1e-5f)
+				value = 1;
+		select(referencePoint, result.vertices, result.weights);
+		if (result.vertices[2] < 0) {
+			auto first = qtiAwbEvaluateTrigger(config_.vertices[result.vertices[0]].gains, &lux);
+			auto last = qtiAwbEvaluateTrigger(config_.vertices[result.vertices[1]].gains, &lux);
+			for (unsigned int c = 0; c < 3; c++)
+				result.gains[c] = qtiAwbBlend(first[c], last[c], result.weights[0]);
+		} else {
+			for (unsigned int i = 0; i < 3; i++) {
+				auto gain = qtiAwbEvaluateTrigger(config_.vertices[result.vertices[i]].gains, &lux);
+				for (unsigned int c = 0; c < 3; c++)
+					result.gains[c] = std::fma(gain[c], result.weights[i], result.gains[c]);
+			}
+		}
+		for (unsigned int c = 0; c < 3; c++)
+			result.gains[c] *= result.compensation[c];
+		result.point = { input.rg / result.gains[0], input.bg / result.gains[2] };
+		result.cct = locus.evaluate(result.point).cct;
+		return result;
+	}
+
+private:
+	QtiAwbPoint centroid(int triangle) const
+	{
+		const auto &ids = config_.triangles[triangle].vertices;
+		const auto &a = config_.vertices[ids[0]].point;
+		const auto &b = config_.vertices[ids[1]].point;
+		const auto &c = config_.vertices[ids[2]].point;
+		return { ((a.rg + b.rg) + c.rg) / 3.0f, ((a.bg + b.bg) + c.bg) / 3.0f };
+	}
+
+	static float cross(QtiAwbPoint a, QtiAwbPoint b, QtiAwbPoint p)
+	{
+		return std::fma(p.rg - b.rg, a.bg - b.bg, -((a.rg - b.rg) * (p.bg - b.bg)));
+	}
+
+	static int sign(float value)
+	{
+		return value < -1e-7f ? -1 : value <= 1e-7f ? 0 : 1;
+	}
+
+	void triangleWeights(int triangle, QtiAwbPoint p, std::array<int32_t, 3> &ids,
+			     std::array<float, 3> &weights) const
+	{
+		ids = config_.triangles[triangle].vertices;
+		const auto &a = config_.vertices[ids[0]].point;
+		const auto &b = config_.vertices[ids[1]].point;
+		const auto &c = config_.vertices[ids[2]].point;
+		float first = std::fma(c.rg, p.bg - b.bg, std::fma(b.bg - c.bg, p.rg, b.rg * (c.bg - p.bg)));
+		float second = std::fma(a.rg, p.bg - c.bg, std::fma(c.bg - a.bg, p.rg, c.rg * (a.bg - p.bg)));
+		float third = std::fma(b.rg, p.bg - a.bg, std::fma(a.bg - b.bg, p.rg, a.rg * (b.bg - p.bg)));
+		weights = { std::abs(first), std::abs(second), std::abs(third) };
+		float total = weights[2] + (weights[0] + weights[1]);
+		for (float &value : weights)
+			value /= total;
+	}
+
+	void edgeWeights(int triangle, unsigned int edge, QtiAwbPoint p,
+			 std::array<int32_t, 3> &ids, std::array<float, 3> &weights) const
+	{
+		const auto &vertices = config_.triangles[triangle].vertices;
+		ids = edge == 2 ? std::array<int32_t, 3>{ vertices[0], vertices[2], -1 }
+			       : std::array<int32_t, 3>{ vertices[edge], vertices[edge + 1], -1 };
+		const auto &a = config_.vertices[ids[0]].point;
+		const auto &b = config_.vertices[ids[1]].point;
+		float dx = a.rg - b.rg;
+		float dy = a.bg - b.bg;
+		float length = std::fma(dy, dy, dx * dx);
+		float weight = 1;
+		if (length != 0) {
+			float ax = a.rg - p.rg, ay = a.bg - p.bg;
+			float bx = b.rg - p.rg, by = b.bg - p.bg;
+			float first = std::fma(ay, ay, ax * ax);
+			float last = std::fma(by, by, bx * bx);
+			weight = ((length + (last - first)) * 0.5f) / length;
+			/* The factory replaces a negative first coefficient with one. */
+			if (weight < 0)
+				weight = 1;
+		}
+		weights = { weight, 0, 0 };
+	}
+
+	void select(QtiAwbPoint p, std::array<int32_t, 3> &ids, std::array<float, 3> &weights) const
+	{
+		int triangle = config_.seeds[0];
+		float nearest = 0;
+		for (unsigned int i = 0; i < config_.seeds.size(); i++) {
+			auto center = centroid(config_.seeds[i]);
+			float dx = p.rg - center.rg, dy = p.bg - center.bg;
+			float distance = dx * dx + dy * dy;
+			if (i == 0 || distance < nearest) {
+				nearest = distance;
+				triangle = config_.seeds[i];
+			}
+		}
+		std::vector<unsigned int> visits(config_.triangles.size());
+		for (;;) {
+			const auto &t = config_.triangles[triangle];
+			std::array<QtiAwbPoint, 3> v;
+			for (unsigned int i = 0; i < 3; i++)
+				v[i] = config_.vertices[t.vertices[i]].point;
+			int a = sign(cross(v[0], v[1], p));
+			int b = sign(cross(v[1], v[2], p));
+			int c = sign(cross(v[2], v[0], p));
+			if (a * b != -1 && b * c != -1 && c * a != -1) {
+				triangleWeights(triangle, p, ids, weights);
+				return;
+			}
+			auto center = centroid(triangle);
+			unsigned int mask = 0;
+			for (unsigned int i = 0; i < 3; i++)
+				if (cross(v[i], v[(i + 1) % 3], p) * cross(v[i], v[(i + 1) % 3], center) < 0)
+					mask |= 1U << i;
+			if (mask == 1 || mask == 2 || mask == 4 || mask == 0) {
+				unsigned int edge = mask >> 1;
+				if (t.neighbours[edge] == 255) {
+					edgeWeights(triangle, edge, p, ids, weights);
+					return;
+				}
+				triangle = t.neighbours[edge];
+			} else {
+				/* Factory meshes have at most one boundary edge per triangle. */
+				int next = triangle;
+				for (unsigned int i = 0; i < 3; i++)
+					if ((mask & (1U << i)) && t.neighbours[i] != 255)
+						next = t.neighbours[i];
+				triangle = next;
+			}
+			/* The stock walk resolves its third visit with centroid weights. */
+			if (visits[triangle]++ >= 2) {
+				triangleWeights(triangle, centroid(triangle), ids, weights);
+				return;
+			}
+		}
+	}
+
+	QtiAwbGainConfiguration config_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/awb_locus.h b/src/libcamera/pipeline/qcom/awb_locus.h
--- a/src/libcamera/pipeline/qcom/awb_locus.h
+++ b/src/libcamera/pipeline/qcom/awb_locus.h
@@ -84 +84,2 @@
-			float product = point.rg * normals_[boundary].rg;
+			/* The separator uses a rounded product, not a fused multiply-subtract. */
+			volatile float product = point.rg * normals_[boundary].rg;
