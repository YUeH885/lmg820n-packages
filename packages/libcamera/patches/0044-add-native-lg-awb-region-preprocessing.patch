diff --git a/src/libcamera/pipeline/qcom/lg_awb_regions.h b/src/libcamera/pipeline/qcom/lg_awb_regions.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_regions.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_aggregate.h"
+
+namespace libcamera::qcom {
+
+using LgAwbPolygon = std::array<LgAwbPoint, 8>;
+
+inline bool lgAwbContains(const LgAwbPolygon &points, LgAwbPoint point)
+{
+	for (unsigned int i = 0; i < 6; i++) {
+		auto a = points[i], b = points[i + 1], c = points[i + 2];
+		if (a.x < 0.01f || a.y < 0.01f || b.x < 0.01f || b.y < 0.01f || c.x < 0.01f || c.y < 0.01f)
+			break;
+		if (point.x < std::min({ a.x, b.x, c.x }) || point.x > std::max({ a.x, b.x, c.x }) ||
+		    point.y < std::min({ a.y, b.y, c.y }) || point.y > std::max({ a.y, b.y, c.y }))
+			continue;
+		float ux = b.x - a.x, uy = b.y - a.y, vx = c.x - a.x, vy = c.y - a.y;
+		float first = lgAwbProduct(ux, vy), second = lgAwbProduct(uy, vx);
+		if (second >= first - 1e-6f && second <= first + 1e-6f)
+			continue;
+		float dx = point.x - a.x, dy = point.y - a.y;
+		float v = (lgAwbProduct(dx, uy) - lgAwbProduct(dy, ux)) / (second - first);
+		float u = std::abs(ux) <= 1e-6f ? (dy - lgAwbProduct(vy, v)) / uy :
+			(dx - lgAwbProduct(vx, v)) / ux;
+		if (u > 0 && u < 1 && v > 0 && v < 1 && u + v < 1)
+			return true;
+	}
+	return false;
+}
+
+struct LgAwbRncRegion {
+	LgAwbPolygon points;
+	LgAwbPoint offset;
+	std::array<int16_t, 4> luxKnots;
+	bool lumaGate;
+	uint16_t lumaMode;
+	float lumaThreshold;
+};
+
+struct LgAwbDtbRegion {
+	LgAwbPolygon points;
+	int16_t luxBoundary;
+};
+
+struct LgAwbRegionConfiguration {
+	unsigned int rncCount;
+	std::array<LgAwbRncRegion, 20> rnc;
+	std::array<unsigned int, 2> dtbCount;
+	std::array<std::array<LgAwbDtbRegion, 10>, 2> dtb;
+};
+
+struct LgAwbRegionCounters {
+	std::array<uint16_t, 20> processed{}, shifted{}, dtb{};
+	uint16_t rejected = 0;
+};
+
+class LgAwbExceptionRegions
+{
+public:
+	explicit LgAwbExceptionRegions(const LgAwbRegionConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	void setLux(int lux)
+	{
+		lux_ = lux;
+		counters_ = {};
+		for (unsigned int i = 0; i < config_.rncCount; i++) {
+			const auto &knots = config_.rnc[i].luxKnots;
+			if (lux <= knots[0] || (lux > knots[2] && lux >= knots[3]))
+				scales_[i] = 10000;
+			else if (lux < knots[1])
+				scales_[i] = 1.0f / (static_cast<float>(lux - knots[0]) / (knots[1] - knots[0]));
+			else if (lux <= knots[2])
+				scales_[i] = 1;
+			else
+				scales_[i] = 1.0f / (1.0f - static_cast<float>(lux - knots[2]) / (knots[3] - knots[2]));
+		}
+	}
+
+	uint16_t classify(LgAwbGraySample &sample)
+	{
+		LgAwbPoint original{ sample.colour.x, sample.colour.y };
+		uint16_t label = 20;
+		for (unsigned int i = 0; i < config_.rncCount; i++) {
+			const auto &region = config_.rnc[i];
+			if (scales_[i] > 3000 || (region.lumaGate &&
+			    ((region.lumaMode == 0 && sample.luma > region.lumaThreshold) ||
+			     (region.lumaMode == 1 && sample.luma < region.lumaThreshold))))
+				continue;
+			if (!lgAwbContains(region.points, original))
+				continue;
+			label = i;
+			if (sample.colour.x + region.offset.x < 0 || sample.colour.y + region.offset.y < 0) {
+				sample.colour = {};
+				sample.valid = 0;
+				label = 20;
+				counters_.rejected++;
+			}
+		}
+		for (unsigned int group = 0; group < config_.dtbCount.size(); group++)
+			for (unsigned int i = 0; i < config_.dtbCount[group]; i++) {
+				const auto &region = config_.dtb[group][i];
+				if ((group == 0 && lux_ < region.luxBoundary) || (group == 1 && lux_ > region.luxBoundary))
+					continue;
+				if (lgAwbContains(region.points, original)) {
+					counters_.dtb[10 * group + i]++;
+					return label;
+				}
+			}
+		return label;
+	}
+
+	bool shift(LgAwbGraySample &sample, unsigned int label)
+	{
+		if (label == 20 || scales_[label] >= 10000)
+			return false;
+		bool apply = static_cast<float>(counters_.processed[label]) / scales_[label] >
+			static_cast<float>(counters_.shifted[label]) - 1e-6f;
+		if (apply) {
+			sample.colour.x += config_.rnc[label].offset.x;
+			sample.colour.y += config_.rnc[label].offset.y;
+			counters_.shifted[label]++;
+		}
+		counters_.processed[label]++;
+		return apply;
+	}
+
+	const LgAwbRegionCounters &counters() const { return counters_; }
+	const std::array<float, 20> &scales() const { return scales_; }
+
+private:
+	LgAwbRegionConfiguration config_;
+	LgAwbRegionCounters counters_;
+	std::array<float, 20> scales_{};
+	int lux_ = 0;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_preprocess.h b/src/libcamera/pipeline/qcom/lg_awb_preprocess.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_preprocess.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+#include "lg_awb_colour.h"
+#include "lg_awb_gray_geometry.h"
+#include "lg_awb_regions.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbPreprocessConfiguration {
+	LgAwbColourConfiguration colour;
+	LgAwbStatisticsConfiguration statistics;
+	LgAwbGrayConfiguration geometry;
+	LgAwbRegionConfiguration regions;
+};
+
+struct LgAwbPreparedFrame {
+	std::array<LgAwbGraySample, 3072> samples{};
+	std::array<uint16_t, 3072> rncLabels{};
+	LgAwbScreenCounters screenCounters{};
+	LgAwbCategoryCounts categoryCounts{};
+	LgAwbRegionCounters regionCounters{};
+	float validFraction = 0;
+	LgAwbGrayReferences references{};
+};
+
+class LgAwbPreprocess
+{
+public:
+	explicit LgAwbPreprocess(const LgAwbPreprocessConfiguration &config,
+				 const LgAwbWhiteBalanceCalibration &calibration = {})
+		: colour_(config.colour, calibration), statistics_(config.statistics),
+		  geometry_(config.geometry), regions_(config.regions)
+	{
+	}
+
+	void prepare(const std::array<LgAwbRgb, 3072> &rgb, int lux, LgAwbPreparedFrame &frame,
+		     bool widen4000KBelow = false)
+	{
+		colour_.setLux(lux);
+		regions_.setLux(lux);
+		frame.references = geometry_.references(lux, widen4000KBelow);
+		LgAwbGrayClassifier classifier(frame.references);
+		frame.screenCounters = {};
+		frame.categoryCounts = {};
+		for (unsigned int i = 0; i < rgb.size(); i++) {
+			auto &sample = frame.samples[i];
+			frame.rncLabels[i] = 20;
+			sample.decision.valid = sample.decision.weightGroup = sample.decision.category = 0;
+			if (rgb[i][0] <= 0 || rgb[i][1] <= 0 || rgb[i][2] <= 0) {
+				sample.colour = {};
+			} else {
+				sample.colour = colour_.fromRgb({ rgb[i][0] / rgb[i][1], rgb[i][2] / rgb[i][1] });
+				sample.luma = (lgAwbProduct(rgb[i][0], 0.299f) + lgAwbProduct(rgb[i][1], 0.587f)) +
+					lgAwbProduct(rgb[i][2], 0.114f);
+			}
+			sample.valid = statistics_.screen(sample.colour, rgb[i], frame.screenCounters);
+			if (sample.valid) {
+				auto indices = classifier.nearestReferences({ sample.colour.x, sample.colour.y });
+				sample.decision.nearest = indices[0];
+				sample.decision.additionalNearest = indices[1];
+				frame.rncLabels[i] = regions_.classify(sample);
+			}
+		}
+		frame.screenCounters[0] += regions_.counters().rejected;
+		frame.validFraction = static_cast<float>(3072 - frame.screenCounters[0] -
+			frame.screenCounters[1] - frame.screenCounters[2]) / 3072.0f;
+		for (unsigned int i = 0; i < frame.samples.size(); i++) {
+			auto &sample = frame.samples[i];
+			if (!sample.valid)
+				continue;
+			regions_.shift(sample, frame.rncLabels[i]);
+			sample.decision = classifier.classify({ sample.colour.x, sample.colour.y });
+			frame.categoryCounts[sample.decision.category]++;
+		}
+		frame.regionCounters = regions_.counters();
+	}
+
+private:
+	LgAwbColour colour_;
+	LgAwbStatistics statistics_;
+	LgAwbGrayGeometry geometry_;
+	LgAwbExceptionRegions regions_;
+};
+
+} /* namespace libcamera::qcom */
diff --git a/src/libcamera/pipeline/qcom/lg_awb_gray_core.h b/src/libcamera/pipeline/qcom/lg_awb_gray_core.h
--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_gray_core.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "lg_awb_preprocess.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbGrayCoreConfiguration {
+	LgAwbPreprocessConfiguration preprocess;
+	LgAwbSceneWeightConfiguration sceneWeights;
+	LgAwbSceneReweightConfiguration reweight;
+};
+
+struct LgAwbGrayFrameControls {
+	int lux;
+	unsigned int flashState, led, minimumGrayCount;
+	bool outdoor, flashOn, widen4000KBelow;
+};
+
+class LgAwbGrayCore
+{
+public:
+	explicit LgAwbGrayCore(const LgAwbGrayCoreConfiguration &config,
+			       const LgAwbWhiteBalanceCalibration &calibration = {})
+		: preprocess_(config.preprocess, calibration), lookup_(config.preprocess.statistics),
+		  adjustment_(config.sceneWeights), aggregate_(config.reweight)
+	{
+	}
+
+	void reset()
+	{
+		frame_ = {};
+		result_ = {};
+		factors_ = { 10, 10, 10 };
+		boost_ = 0;
+		weights_ = {};
+	}
+
+	const LgAwbGrayResult &process(const std::array<LgAwbRgb, 3072> &rgb,
+				     const LgAwbGrayFrameControls &controls)
+	{
+		preprocess_.prepare(rgb, controls.lux, frame_, controls.widen4000KBelow);
+		weights_ = lookup_.weights(controls.lux);
+		adjustment_.reduce(weights_, controls.lux, controls.flashState, frame_.categoryCounts, factors_);
+		boost_ = adjustment_.boost(weights_, controls.lux, controls.outdoor, controls.flashOn, controls.led);
+		aggregate_.update(frame_.samples, weights_, frame_.categoryCounts, controls.lux, controls.flashState,
+			controls.minimumGrayCount, frame_.references.points, result_);
+		return result_;
+	}
+
+	const LgAwbPreparedFrame &frame() const { return frame_; }
+	const LgAwbRegionWeights &weights() const { return weights_; }
+	const std::array<float, 3> &factors() const { return factors_; }
+	float boost() const { return boost_; }
+
+private:
+	LgAwbPreprocess preprocess_;
+	LgAwbStatistics lookup_;
+	LgAwbSceneWeights adjustment_;
+	LgAwbGrayAggregate aggregate_;
+	LgAwbPreparedFrame frame_;
+	LgAwbGrayResult result_;
+	LgAwbRegionWeights weights_{};
+	std::array<float, 3> factors_{ 10, 10, 10 };
+	float boost_ = 0;
+};
+
+} /* namespace libcamera::qcom */
