--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_statistics.h
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace libcamera::qcom {
+
+using LgAwbRgb = std::array<float, 3>;
+using LgAwbRegionWeights = std::array<std::array<float, 29>, 5>;
+using LgAwbScreenCounters = std::array<uint16_t, 7>;
+
+struct LgAwbPoint {
+	float x, y;
+};
+
+struct LgAwbStatisticsConfiguration {
+	float minimumRgb, maximumRgb, boundaryMargin;
+	std::array<int16_t, 24> luxKnots;
+	std::array<std::array<std::array<int16_t, 29>, 5>, 24> regionWeights;
+};
+
+struct LgAwbBgStatistics {
+	static constexpr unsigned int Regions = 64 * 48;
+	unsigned int bitDepth = 14;
+	std::array<LgAwbRgb, Regions> rgb{};
+
+	void update(const uint32_t *regions, unsigned int depth,
+		    unsigned int startupMode, unsigned int regionCount)
+	{
+		if (startupMode == 1 || !regionCount)
+			return;
+		bitDepth = depth ? depth : 14;
+		unsigned int scale = 1U << (bitDepth > 8 ? bitDepth - 8 : 0);
+		for (unsigned int i = 0; i < rgb.size(); i++) {
+			/* CAMSS supplies six normal words followed by six saturated-statistics words. */
+			const uint32_t *region = regions + i * 12;
+			uint32_t red = region[4] & 0xffff;
+			uint32_t blue = region[4] >> 16;
+			uint32_t green = (region[5] & 0xffff) + (region[5] >> 16);
+			if (!red || !blue || !green) {
+				rgb[i] = {};
+				continue;
+			}
+			rgb[i] = { static_cast<float>(region[0]) / (red * scale),
+				   static_cast<float>(region[2] + region[3]) / (green * scale),
+				   static_cast<float>(region[1]) / (blue * scale) };
+		}
+	}
+};
+
+class LgAwbStatistics
+{
+public:
+	explicit LgAwbStatistics(const LgAwbStatisticsConfiguration &config)
+		: config_(config)
+	{
+	}
+
+	unsigned int luxRegion(int lux) const
+	{
+		return std::lower_bound(config_.luxKnots.begin(), config_.luxKnots.end(), lux) -
+		       config_.luxKnots.begin();
+	}
+
+	LgAwbRegionWeights weights(int lux) const
+	{
+		unsigned int region = luxRegion(lux);
+		unsigned int first = region ? region - 1 : 0;
+		unsigned int last = std::min<unsigned int>(region, config_.luxKnots.size() - 1);
+		float coefficient = first == last ? 0 :
+			static_cast<float>(lux - config_.luxKnots[first]) /
+			(config_.luxKnots[last] - config_.luxKnots[first]);
+		LgAwbRegionWeights result;
+		for (unsigned int group = 0; group < result.size(); group++)
+			for (unsigned int category = 0; category < result[group].size(); category++) {
+				float a = config_.regionWeights[first][group][category];
+				float b = config_.regionWeights[last][group][category];
+				/* The factory rounds multiplication before addition. */
+				volatile float product = coefficient * (b - a);
+				result[group][category] = a + product;
+			}
+		return result;
+	}
+
+	bool screen(const std::array<float, 3> &xyY, const LgAwbRgb &rgb,
+		    LgAwbScreenCounters &counters) const
+	{
+		if (std::all_of(xyY.begin(), xyY.end(), [](float value) { return std::abs(value) <= 1e-6f; })) {
+			counters[0]++;
+			return false;
+		}
+		if (std::any_of(rgb.begin(), rgb.end(), [this](float value) { return value > config_.maximumRgb; })) {
+			counters[1]++;
+			counters[6]++;
+			return false;
+		}
+		if (std::any_of(rgb.begin(), rgb.end(), [this](float value) { return value < config_.minimumRgb; })) {
+			counters[2]++;
+			counters[5]++;
+			return false;
+		}
+		if (std::any_of(rgb.begin(), rgb.end(), [this](float value) { return value > config_.maximumRgb - config_.boundaryMargin; }))
+			counters[6]++;
+		else if (std::any_of(rgb.begin(), rgb.end(), [this](float value) { return value < config_.minimumRgb + config_.boundaryMargin; }))
+			counters[5]++;
+		return true;
+	}
+
+private:
+	LgAwbStatisticsConfiguration config_;
+};
+
+inline unsigned int lgAwbNearestReference(const std::array<LgAwbPoint, 6> &reference, LgAwbPoint point)
+{
+	unsigned int nearest = 0;
+	float shortest = 0;
+	for (unsigned int i = 0; i < reference.size(); i++) {
+		float dx = reference[i].x - point.x;
+		float dy = reference[i].y - point.y;
+		/* The SIMD factory path rounds both squares before the sum and square root. */
+		volatile float xx = dx * dx;
+		volatile float yy = dy * dy;
+		float distance = std::sqrt(xx + yy);
+		if (!i || distance < shortest) {
+			shortest = distance;
+			nearest = i;
+		}
+	}
+	return nearest;
+}
+
+} /* namespace libcamera::qcom */
