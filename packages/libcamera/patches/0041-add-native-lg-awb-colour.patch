--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_colour.h
@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+#include "lg_awb_types.h"
+
+namespace libcamera::qcom {
+
+struct LgAwbColourConfiguration {
+	std::array<LgAwbPoint, 6> ideal;
+	std::array<LgAwbRatios, 6> nominal, lowLight, golden;
+	bool lowLightEnabled;
+	std::array<int16_t, 2> lowLightLux;
+};
+
+struct LgAwbWhiteBalanceCalibration {
+	std::array<uint32_t, 2> valid{};
+	std::array<LgAwbRatios, 2> measured{};
+};
+
+class LgAwbColour
+{
+public:
+	explicit LgAwbColour(const LgAwbColourConfiguration &config,
+			     const LgAwbWhiteBalanceCalibration &calibration = {})
+		: config_(config)
+	{
+		for (unsigned int i = 0; i < nominal_.size(); i++) {
+			unsigned int group = i < 4 ? 0 : 1;
+			LgAwbRatios factor{ 1, 1 };
+			if (calibration.valid[group])
+				factor = { calibration.measured[group].red / config.golden[i].red,
+					   calibration.measured[group].blue / config.golden[i].blue };
+			auto normal = sensorXy({ product(config.nominal[i].red, factor.red),
+						product(config.nominal[i].blue, factor.blue) });
+			auto low = sensorXy({ product(config.lowLight[i].red, factor.red),
+					     product(config.lowLight[i].blue, factor.blue) });
+			nominal_[i] = { normal.x, normal.y };
+			lowLight_[i] = { low.x, low.y };
+		}
+		setLux(0);
+	}
+
+	void setLux(int lux)
+	{
+		for (unsigned int i = 0; i < sensor_.size(); i++) {
+			if (!config_.lowLightEnabled || lux < config_.lowLightLux[0]) {
+				sensor_[i] = nominal_[i];
+			} else if (lux > config_.lowLightLux[1]) {
+				sensor_[i] = lowLight_[i];
+			} else {
+				float coefficient = static_cast<float>(lux - config_.lowLightLux[0]) /
+					(config_.lowLightLux[1] - config_.lowLightLux[0]);
+				sensor_[i] = { nominal_[i].x + product(lowLight_[i].x - nominal_[i].x, coefficient),
+					       nominal_[i].y + product(lowLight_[i].y - nominal_[i].y, coefficient) };
+			}
+			delta_[i] = { config_.ideal[i].x - sensor_[i].x,
+				      config_.ideal[i].y - sensor_[i].y };
+		}
+	}
+
+	const std::array<LgAwbPoint, 6> &ideal() const { return config_.ideal; }
+	const std::array<LgAwbPoint, 6> &sensor() const { return sensor_; }
+	const std::array<LgAwbPoint, 6> &delta() const { return delta_; }
+
+	LgAwbPoint toIdeal(LgAwbPoint point) const
+	{
+		auto offset = correction(sensor_, point.x);
+		return { point.x + offset.x, point.y + offset.y };
+	}
+
+	LgAwbPoint toSensor(LgAwbPoint point) const
+	{
+		auto offset = correction(config_.ideal, point.x);
+		return { point.x - offset.x, point.y - offset.y };
+	}
+
+	LgAwbXyY fromRgb(LgAwbRatios ratios, bool calibrated = true) const
+	{
+		auto result = sensorXy(ratios);
+		if (calibrated) {
+			auto point = toIdeal({ result.x, result.y });
+			result.x = point.x;
+			result.y = point.y;
+		} else {
+			result.luma = 0;
+		}
+		return result;
+	}
+
+	LgAwbRatios toRgb(LgAwbXyY input) const
+	{
+		auto point = toSensor({ input.x, input.y });
+		float X = product(point.x, input.luma) / point.y;
+		float Z = product((1.0f - point.x) - point.y, input.luma) / point.y;
+		float r = (product(X, 3.13385606f) + product(input.luma, -1.61686695f)) + product(Z, -0.49061501f);
+		float g = (product(input.luma, 1.91614199f) + product(X, -0.978767991f)) + product(Z, 0.0334540009f);
+		float b = (product(X, 0.0719449967f) + product(input.luma, -0.228991002f)) + product(Z, 1.40524304f);
+		r = encode(r); g = encode(g); b = encode(b);
+		if (input.y < 0.001f)
+			r = g = b = 0;
+		return { r / g, b / g };
+	}
+
+private:
+	static float product(float a, float b)
+	{
+		/* The factory rounds each multiplication independently of later additions. */
+		volatile float result = a * b;
+		return result;
+	}
+
+	static float decode(float value)
+	{
+		return value > 0.04045f ? std::pow((value + 0.055f) / 1.055f, 2.4f) : value / 12.92f;
+	}
+
+	static float encode(float value)
+	{
+		float result = value > 0.0031308f ? product(1.055f, std::pow(value, 1.0f / 2.4f)) - 0.055f
+					       : product(value, 12.92f);
+		return result < 0.004f ? 0 : std::min(result, 1.0f);
+	}
+
+	static LgAwbXyY sensorXy(LgAwbRatios ratios)
+	{
+		/* The normalized encoded green is fixed at 64/255 in the factory transform. */
+		float r = decode(product(ratios.red, 64.0f) / 255.0f);
+		float b = decode(product(ratios.blue, 64.0f) / 255.0f);
+		float X = (product(r, 43.6074982f) + 1.97420776f) + product(b, 14.3079996f);
+		float Y = (product(r, 22.2504005f) + 3.67540026f) + product(b, 6.06169987f);
+		float Z = (product(r, 1.39320004f) + 0.497847021f) + product(b, 71.4172974f);
+		float total = Z + (X + Y);
+		if (std::abs(total) <= 1e-6f)
+			return {};
+		return { X / total, Y / total, Y / 100.0f };
+	}
+
+	LgAwbPoint correction(const std::array<LgAwbPoint, 6> &anchors, float x) const
+	{
+		if (x < anchors.front().x)
+			return delta_.front();
+		if (x >= anchors.back().x)
+			return delta_.back();
+		unsigned int i = 0;
+		while (i < anchors.size() - 2 && x >= anchors[i + 1].x)
+			i++;
+		float first = anchors[i].x, last = anchors[i + 1].x;
+		if (first >= last - 1e-6f && first <= last + 1e-6f)
+			return { product(delta_[i].x + delta_[i + 1].x, 0.5f),
+				 product(delta_[i].y + delta_[i + 1].y, 0.5f) };
+		float coefficient = (x - first) / (last - first);
+		return { delta_[i].x + product(coefficient, delta_[i + 1].x - delta_[i].x),
+			 delta_[i].y + product(coefficient, delta_[i + 1].y - delta_[i].y) };
+	}
+
+	LgAwbColourConfiguration config_;
+	std::array<LgAwbPoint, 6> nominal_, lowLight_, sensor_, delta_;
+};
+
+} /* namespace libcamera::qcom */
