--- /dev/null
+++ b/src/libcamera/pipeline/qcom/lg_awb_types.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <array>
+
+namespace libcamera::qcom {
+
+using LgAwbRgb = std::array<float, 3>;
+
+struct LgAwbPoint {
+	float x, y;
+};
+
+struct LgAwbRatios {
+	float red, blue;
+};
+
+struct LgAwbXyY {
+	float x, y, luma;
+};
+
+} /* namespace libcamera::qcom */
