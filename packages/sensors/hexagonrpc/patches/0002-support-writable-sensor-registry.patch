+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	if (!valid_fd(fds, fileno))
+		return -EBADF;
+	if (!fds[fileno]->ops->write)
+		return -EROFS;
+	return fds[fileno]->ops->write(fds[fileno], size, ptr);
+}
+
+int hexagonfs_flush(struct hexagonfs_fd **fds, int fileno)
+{
+	if (!valid_fd(fds, fileno))
+		return -EBADF;
+	if (!fds[fileno]->ops->flush)
+		return 0;
+	return fds[fileno]->ops->flush(fds[fileno]);
+}
