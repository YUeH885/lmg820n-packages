+static int writable_from_dirent(const void *data, bool dir, void **fd_data)
+{
+	int ret = mapped_from_dirent(data, dir, fd_data);
+
+	if (!ret)
+		((struct mapped_ctx *)*fd_data)->writable = true;
+	return ret;
+}
+
+static ssize_t mapped_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	struct mapped_ctx *ctx = fd->data;
+	ssize_t ret = write(ctx->fd, ptr, size);
+
+	return ret < 0 ? -errno : ret;
+}
+
+static int mapped_flush(struct hexagonfs_fd *fd)
+{
+	struct mapped_ctx *ctx = fd->data;
+
+	return fsync(ctx->fd) ? -errno : 0;
+}
