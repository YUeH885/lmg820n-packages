From: LM-G820N Developer <dev@lmg820n.invalid>
Subject: [PATCH] build: find GLib GIR files in the target libdir

Pass the target library GIR directory to vapigen so Vala bindings can
resolve architecture-dependent GLib definitions during cross builds.

diff --git a/src/meson.build b/src/meson.build
index deb114f..3e715d2 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -111,6 +111,7 @@ if dependency('gobject-introspection-1.0', required: false).found()
     gnome.generate_vapi(
       'libssc',
       packages: ['gobject-2.0', 'glib-2.0', 'gio-2.0'],
+      gir_dirs: [glib_dep.get_variable(pkgconfig: 'libdir') / 'gir-1.0'],
       sources: gir_files.get(0),
       install: true,
     )
