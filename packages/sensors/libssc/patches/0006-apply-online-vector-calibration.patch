+#ifndef LIBSSC_CALIBRATION_PRIVATE_H
+#define LIBSSC_CALIBRATION_PRIVATE_H
+
+#include "libssc-sensor.h"
+
+#define SSC_MSG_REPORT_CALIBRATION 1022
+
+typedef struct {
+    SSCSensor *sensor;
+    GObject *client;
+    gulong report_id;
+    guint64 uid_high, uid_low;
+    GMutex lock;
+    gboolean ready;
+    gfloat bias[3], scale[3], matrix[9];
+} SSCVectorCalibration;
+
+void ssc_calibration_init(SSCVectorCalibration *cal);
+void ssc_calibration_disconnect(SSCVectorCalibration *cal);
+void ssc_calibration_clear(SSCVectorCalibration *cal);
+gboolean ssc_calibration_update(SSCVectorCalibration *cal, GArray *bytes);
+gboolean ssc_calibration_apply(SSCVectorCalibration *cal, gfloat *x, gfloat *y, gfloat *z);
+void ssc_calibration_open(SSCVectorCalibration *cal, SSCSensor *owner,
+                         const gchar *type, GCancellable *cancellable,
+                         GAsyncReadyCallback callback, gpointer data);
+void ssc_calibration_close(SSCVectorCalibration *cal, SSCSensor *owner,
+                          GCancellable *cancellable,
+                          GAsyncReadyCallback callback, gpointer data);
+gboolean ssc_calibration_finish(GAsyncResult *result, GError **error);
+
+#endif
