+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <math.h>
+#include <string.h>
+#include "libssc-calibration-private.h"
+#include "ssc-calibration.pb-c.h"
+
+void ssc_calibration_init(SSCVectorCalibration *cal)
+{
+    g_mutex_init(&cal->lock);
+}
+
+void ssc_calibration_disconnect(SSCVectorCalibration *cal)
+{
+    if (cal->report_id)
+        g_clear_signal_handler(&cal->report_id, cal->client);
+    g_clear_object(&cal->client);
+    g_clear_object(&cal->sensor);
+    g_mutex_lock(&cal->lock);
+    cal->ready = FALSE;
+    g_mutex_unlock(&cal->lock);
+}
+
+void ssc_calibration_clear(SSCVectorCalibration *cal)
+{
+    ssc_calibration_disconnect(cal);
+    g_mutex_clear(&cal->lock);
+}
+
+gboolean ssc_calibration_update(SSCVectorCalibration *cal, GArray *bytes)
+{
+    SscCalibrationEvent *msg = ssc_calibration_event__unpack(NULL, bytes->len,
+                                                          (const guint8 *)bytes->data);
+    gfloat bias[3] = {0}, scale[3] = {1, 1, 1};
+    gfloat matrix[9] = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+    gboolean valid = FALSE;
+
+    if (!msg)
+        goto invalid;
+    if ((msg->n_bias && msg->n_bias != 3) ||
+        (msg->n_scale_factor && msg->n_scale_factor != 3) ||
+        (msg->n_comp_matrix && msg->n_comp_matrix != 9) ||
+        msg->status < 0 || msg->status > 3)
+        goto invalid;
+    if (msg->n_bias)
+        memcpy(bias, msg->bias, sizeof(bias));
+    if (msg->n_scale_factor)
+        memcpy(scale, msg->scale_factor, sizeof(scale));
+    if (msg->n_comp_matrix)
+        memcpy(matrix, msg->comp_matrix, sizeof(matrix));
+    for (guint i = 0; i < 3; i++)
+        if (!isfinite(bias[i]) || !isfinite(scale[i]))
+            goto invalid;
+    for (guint i = 0; i < 9; i++)
+        if (!isfinite(matrix[i]))
+            goto invalid;
+    valid = TRUE;
+    g_mutex_lock(&cal->lock);
+    memcpy(cal->bias, bias, sizeof(bias));
+    memcpy(cal->scale, scale, sizeof(scale));
+    memcpy(cal->matrix, matrix, sizeof(matrix));
+    cal->ready = msg->status != 0;
+    g_mutex_unlock(&cal->lock);
+    goto out;
+
+invalid:
+    g_mutex_lock(&cal->lock);
+    cal->ready = FALSE;
+    g_mutex_unlock(&cal->lock);
+    g_warning("Invalid vector calibration event");
+out:
+    if (msg)
+        ssc_calibration_event__free_unpacked(msg, NULL);
+    return valid;
+}
+
+gboolean ssc_calibration_apply(SSCVectorCalibration *cal, gfloat *x, gfloat *y, gfloat *z)
+{
+    gfloat raw[3] = {*x, *y, *z}, corrected[3] = {0};
+
+    g_mutex_lock(&cal->lock);
+    if (!cal->ready) {
+        g_mutex_unlock(&cal->lock);
+        return FALSE;
+    }
+    for (guint i = 0; i < 3; i++)
+        raw[i] = raw[i] * cal->scale[i] - cal->bias[i];
+    for (guint i = 0; i < 3; i++)
+        for (guint j = 0; j < 3; j++)
+            corrected[i] += cal->matrix[3 * i + j] * raw[j];
+    g_mutex_unlock(&cal->lock);
+    *x = corrected[0];
+    *y = corrected[1];
+    *z = corrected[2];
+    return TRUE;
+}
+
+static void calibration_report(GObject *client, guint32 id, guint64 high,
+                               guint64 low, GArray *bytes, gpointer data)
+{
+    SSCVectorCalibration *cal = data;
+
+    if (id == SSC_MSG_REPORT_CALIBRATION && high == cal->uid_high && low == cal->uid_low)
+        ssc_calibration_update(cal, bytes);
+}
+
+static void calibration_open_ready(GObject *source, GAsyncResult *result, gpointer data)
+{
+    GTask *task = G_TASK(data);
+    SSCVectorCalibration *cal = g_task_get_task_data(task);
+    GError *error = NULL;
+
+    if (!ssc_sensor_open_finish(SSC_SENSOR(source), result, &error)) {
+        ssc_calibration_disconnect(cal);
+        g_task_return_error(task, error);
+    } else {
+        g_task_return_boolean(task, TRUE);
+    }
+    g_object_unref(task);
+}
+
+static void calibration_discovered(GObject *source, GAsyncResult *result, gpointer data)
+{
+    GTask *task = G_TASK(data);
+    SSCVectorCalibration *cal = g_task_get_task_data(task);
+    GError *error = NULL;
+
+    cal->sensor = ssc_sensor_new_finish(result, &error);
+    if (!cal->sensor) {
+        g_task_return_error(task, error);
+        g_object_unref(task);
+        return;
+    }
+    g_object_get(cal->sensor, SSC_SENSOR_CLIENT, &cal->client,
+                 SSC_SENSOR_UID_HIGH, &cal->uid_high, SSC_SENSOR_UID_LOW, &cal->uid_low, NULL);
+    cal->report_id = g_signal_connect(cal->client, "report", G_CALLBACK(calibration_report), cal);
+    ssc_sensor_open(cal->sensor, g_task_get_cancellable(task), calibration_open_ready, task);
+}
+
+void ssc_calibration_open(SSCVectorCalibration *cal, SSCSensor *owner,
+                         const gchar *type, GCancellable *cancellable,
+                         GAsyncReadyCallback callback, gpointer data)
+{
+    GTask *task = g_task_new(owner, cancellable, callback, data);
+
+    if (cal->sensor) {
+        g_task_return_new_error(task, G_IO_ERROR, G_IO_ERROR_PENDING,
+                               "Calibration sensor is already open");
+        g_object_unref(task);
+        return;
+    }
+    g_task_set_task_data(task, cal, NULL);
+    ssc_sensor_new((gchar *)type, cancellable, calibration_discovered, task);
+}
+
+static void calibration_close_ready(GObject *source, GAsyncResult *result, gpointer data)
+{
+    GTask *task = G_TASK(data);
+    SSCVectorCalibration *cal = g_task_get_task_data(task);
+    GError *error = NULL;
+    gboolean success = ssc_sensor_close_finish(SSC_SENSOR(source), result, &error);
+
+    ssc_calibration_disconnect(cal);
+    if (success)
+        g_task_return_boolean(task, TRUE);
+    else
+        g_task_return_error(task, error);
+    g_object_unref(task);
+}
+
+void ssc_calibration_close(SSCVectorCalibration *cal, SSCSensor *owner,
+                          GCancellable *cancellable,
+                          GAsyncReadyCallback callback, gpointer data)
+{
+    GTask *task = g_task_new(owner, cancellable, callback, data);
+
+    if (!cal->sensor) {
+        g_task_return_boolean(task, TRUE);
+        g_object_unref(task);
+        return;
+    }
+    g_task_set_task_data(task, cal, NULL);
+    ssc_sensor_close(cal->sensor, cancellable, calibration_close_ready, task);
+}
+
+gboolean ssc_calibration_finish(GAsyncResult *result, GError **error)
+{
+    return g_task_propagate_boolean(G_TASK(result), error);
+}
