diff --git a/src/libssc-sensor-private.h b/src/libssc-sensor-private.h
new file mode 100644
index 0000000..72eb031
--- /dev/null
+++ b/src/libssc-sensor-private.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef _LIBSSC_SENSOR_PRIVATE_H_
+#define _LIBSSC_SENSOR_PRIVATE_H_
+
+#include "libssc-sensor.h"
+
+#define SSC_SENSOR_MAIN_CONTEXT "ssc-main-context"
+
+static inline GMainContext *
+ssc_sensor_get_context (SSCSensor *self)
+{
+	return g_object_get_data (G_OBJECT (self), SSC_SENSOR_MAIN_CONTEXT);
+}
+
+static inline void
+ssc_sensor_queue_signal (SSCSensor *self, GSourceFunc callback,
+                         gpointer data, GDestroyNotify destroy)
+{
+	GSource *source = g_idle_source_new ();
+
+	g_source_set_callback (source, callback, data, destroy);
+	g_source_attach (source, ssc_sensor_get_context (self));
+	g_source_unref (source);
+}
+
+#endif
