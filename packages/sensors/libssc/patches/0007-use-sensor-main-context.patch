diff --git a/src/libssc-common.c b/src/libssc-common.c
index 3648f47..2a4e20c 100644
--- a/src/libssc-common.c
+++ b/src/libssc-common.c
@@ -42,6 +42,7 @@ ssc_common_dump_protobuf (GArray *protobuf)
 
 void
 ssc_common_init_sync_context (SyncContext *ctx) {
+	ctx->context = g_main_context_ref_thread_default ();
 	g_mutex_init (&ctx->mutex);
 	g_cond_init (&ctx->condition);
 	ctx->finished = FALSE;
@@ -53,7 +54,7 @@ ssc_common_wait_sync_context (SyncContext *ctx) {
 	g_mutex_lock (&ctx->mutex);
 	while (!ctx->finished) {
 		g_mutex_unlock (&ctx->mutex);
-		g_main_context_iteration (g_main_context_default (), FALSE);
+		g_main_context_iteration (ctx->context, FALSE);
 		g_mutex_lock (&ctx->mutex);
 	}
 	g_mutex_unlock (&ctx->mutex);
@@ -73,6 +74,7 @@ ssc_common_callback_sync_context (GObject *source, GAsyncResult *result, gpointe
 
 void
 ssc_common_clear_sync_context (SyncContext *ctx) {
+	g_main_context_unref (ctx->context);
 	g_mutex_clear (&ctx->mutex);
 	g_cond_clear (&ctx->condition);
 	g_object_unref (ctx->result);
