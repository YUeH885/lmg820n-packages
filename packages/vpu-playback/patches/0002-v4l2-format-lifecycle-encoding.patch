+        pixel_format == V4L2_PIX_FMT_P010) {
+        int stride = out->plane_info[0].bytesperline;
+        int row_bytes = av_image_get_linesize(frame->format, frame->width, 0);
+        size_t y_size = (size_t)stride * height;
+        size_t size = y_size + (size_t)stride * AV_CEIL_RSHIFT(height, 1);
+        uint8_t *data = out->plane_info[0].mm_addr;
+
+        if (frame->format != out->context->av_pix_fmt || out->num_planes != 1 ||
+            row_bytes < 0 || stride < row_bytes || height < frame->height ||
+            size > out->plane_info[0].length)
+            return AVERROR(EINVAL);
+        memset(data, 0, out->plane_info[0].length);
+        av_image_copy_plane(data, stride, frame->data[0], frame->linesize[0],
+                            row_bytes, frame->height);
+        av_image_copy_plane(data + y_size, stride, frame->data[1], frame->linesize[1],
+                            row_bytes, AV_CEIL_RSHIFT(frame->height, 1));
+        if (V4L2_TYPE_IS_MULTIPLANAR(out->buf.type)) {
+            out->planes[0].bytesused = size;
+            out->planes[0].length = out->plane_info[0].length;
+        } else {
+            out->buf.bytesused = size;
+        }
+        return 0;
+    }

