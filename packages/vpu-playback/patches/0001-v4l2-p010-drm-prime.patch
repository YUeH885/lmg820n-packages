+static int v4l2_select_capture_format(AVCodecContext *avctx)
+{
+    V4L2m2mContext *s = ((V4L2m2mPriv *)avctx->priv_data)->context;
+    V4L2Context *capture = &s->capture;
+    enum AVPixelFormat formats[3];
+    int n = 0;
+
+    if (capture->av_pix_fmt == AV_PIX_FMT_NONE)
+        return AVERROR(EINVAL);
+
+#if CONFIG_LIBDRM
+    if (capture->av_pix_fmt == AV_PIX_FMT_NV12 ||
+        capture->av_pix_fmt == AV_PIX_FMT_P010LE)
+        formats[n++] = AV_PIX_FMT_DRM_PRIME;
+#endif
+    formats[n++] = capture->av_pix_fmt;
+    formats[n] = AV_PIX_FMT_NONE;
+    avctx->pix_fmt = ff_get_format(avctx, formats);
+    if (avctx->pix_fmt == AV_PIX_FMT_NONE)
+        return AVERROR(EINVAL);
+
+    if (avctx->pix_fmt == AV_PIX_FMT_DRM_PRIME) {
+        AVBufferRef *device_ref = av_hwdevice_ctx_alloc(AV_HWDEVICE_TYPE_DRM);
+        AVHWFramesContext *frames;
+        int ret;
+
+        if (!device_ref)
+            return AVERROR(ENOMEM);
+        ((AVDRMDeviceContext *)((AVHWDeviceContext *)device_ref->data)->hwctx)->fd = -1;
+        ret = av_hwdevice_ctx_init(device_ref);
+        if (ret < 0) {
+            av_buffer_unref(&device_ref);
+            return ret;
+        }
+        capture->drm_frames_ref = av_hwframe_ctx_alloc(device_ref);
+        av_buffer_unref(&device_ref);
+        if (!capture->drm_frames_ref)
+            return AVERROR(ENOMEM);
+
+        frames = (AVHWFramesContext *)capture->drm_frames_ref->data;
+        frames->format = AV_PIX_FMT_DRM_PRIME;
+        frames->sw_format = capture->av_pix_fmt;
+        frames->width = avctx->width;
+        frames->height = avctx->height;
+        ret = av_hwframe_ctx_init(capture->drm_frames_ref);
+        if (ret < 0) {
+            av_buffer_unref(&capture->drm_frames_ref);
+            return ret;
+        }
+    }
+
+    return 0;
+}
