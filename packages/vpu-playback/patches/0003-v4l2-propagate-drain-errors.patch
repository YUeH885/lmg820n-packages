diff --git a/libavcodec/v4l2_context.c b/libavcodec/v4l2_context.c
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -557,8 +557,10 @@

     if (!frame) {
         ret = v4l2_stop_encode(ctx);
-        if (ret)
+        if (ret) {
             av_log(logger(ctx), AV_LOG_ERROR, "%s stop_encode\n", ctx->name);
+            return ret;
+        }
         s->draining= 1;
         return 0;
     }
@@ -582,8 +584,10 @@

     if (!pkt->size) {
         ret = v4l2_stop_decode(ctx);
-        if (ret)
+        if (ret) {
             av_log(logger(ctx), AV_LOG_ERROR, "%s stop_decode\n", ctx->name);
+            return ret;
+        }
         s->draining = 1;
         return 0;
     }
diff --git a/libavcodec/v4l2_m2m_dec.c b/libavcodec/v4l2_m2m_dec.c
--- a/libavcodec/v4l2_m2m_dec.c
+++ b/libavcodec/v4l2_m2m_dec.c
@@ -239,10 +239,13 @@
         ret = v4l2_try_start(avctx);
         if (ret < 0)
             goto fail;
-        ret = ff_v4l2_context_dequeue_frame(capture, frame, -1);
+        /* Let the caller supply more input or initiate drain. */
+        ret = ff_v4l2_context_dequeue_frame(capture, frame,
+                                          capture->wait_for_source_change &&
+                                          !s->draining && !s->buf_pkt.size ? 0 : -1);
         /* Drain can precede the initial source-change event on short inputs. */
     } while (ret == AVERROR(EAGAIN) &&
-             (s->reinit || (s->draining && !capture->streamon &&
+             (s->reinit || (!capture->streamon &&
                             !capture->wait_for_source_change)));
     return ret;
 fail:
